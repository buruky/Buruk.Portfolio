---
import Base from "@/layouts/Base.astro";
import GlassHero from "@/components/GlassHero.astro";
import FeaturedWork from "@/components/FeaturedWork.astro";
import StoryTeaser from "@/components/StoryTeaser.astro";
import BkwsDoorway from "@/components/BkwsDoorway.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import Stats from "@/components/Stats.astro";
---
<Base>
  <main id="main">
    <!-- Hero (2026-11-25): the glass ቡሩኽ intro and the "C · Lockup" layout. See GlassHero.astro. -->
    <GlassHero />
    <div class="hillside">
      <StoryTeaser />
      <Stats />
      <FeaturedWork />
      <BkwsDoorway />
      <SiteFooter />
    </div>
  </main>
</Base>

<style>
  /* The rest of Home sits on the morning hillside; the dark of the hero's photo fades into it. */
  .hillside {
    --hill: #244a2e;
    background: linear-gradient(to bottom, #050506 0, var(--hill) clamp(160px, 26vh, 300px)) no-repeat, var(--hill);
  }
</style>
