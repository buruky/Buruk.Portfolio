---
import Base from "@/layouts/Base.astro";
import site from "@/lib/site";

// Step 2.1 setup check: proves content, fonts and tokens load. Not the real Home page.
const worlds = ["morning", "noon", "afternoon", "golden", "dusk", "sunset", "night", "midnight", "bkws"];
---
<Base world="morning">
  <main class="check">
    <p class="geez" lang="ti">ቡሩኽ</p>
    <h1>{site.profile.name}</h1>
    <p class="lanes">{site.lanes.join(" / ")}</p>
    <p class="bio">{site.profile.intro}</p>
    <ul class="worlds" aria-label="Colour worlds">
      {worlds.map((w) => <li data-world={w}>{w}</li>)}
    </ul>
    <p class="note">Setup check for step 2.1: content from site.json, all four fonts and every colour world are loading.</p>
  </main>
</Base>

<style>
  .check {
    padding: max(24px, env(safe-area-inset-top)) max(20px, env(safe-area-inset-right)) 48px max(20px, env(safe-area-inset-left));
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    gap: 20px;
  }
  .geez { font-family: var(--font-geez); font-size: clamp(40px, 8vw, 72px); line-height: 1; margin: 0; }
  h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 118%;
    font-size: clamp(44px, 10vw, 112px);
    line-height: 0.92;
    margin: 0;
    text-transform: uppercase;
  }
  .lanes { font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; margin: 0; }
  .bio { max-width: 60ch; margin: 0; font-size: 18px; }
  .worlds { list-style: none; padding: 0; margin: 8px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 8px; }
  .worlds li {
    background: var(--world-bg);
    color: var(--world-fg);
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 28px 12px 10px;
    border-radius: 10px;
    border: 1px solid color-mix(in srgb, var(--world-fg) 20%, transparent);
  }
  .note { font-size: 14px; opacity: 0.75; margin: 0; }
</style>
