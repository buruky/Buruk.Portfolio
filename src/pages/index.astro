---
import Base from "@/layouts/Base.astro";
import Intro from "@/components/Intro.astro";
import site from "@/lib/site";
import Grass from "@/components/Grass.astro";
import FeaturedWork from "@/components/FeaturedWork.astro";
import StoryTeaser from "@/components/StoryTeaser.astro";
import BkwsDoorway from "@/components/BkwsDoorway.astro";
import SiteFooter from "@/components/SiteFooter.astro";

// "I build ____." The line fills itself in and cycles through the topics until the visitor picks one (step 3.3).
// Nothing changes size: "I build" always spans the width, and every topic fills one line of the same
// width and height by adjusting Anybody's width axis (long phrases get narrower letters, short ones wider).
const TOPICS = [
  { label: "Salesforce", fill: "Salesforce apps.", href: "/work" },
  { label: "Full stack", fill: "full-stack products.", href: "/work" },
  { label: "Research", fill: "research with data.", href: "/research" },
  { label: "BK Web Studios", fill: "websites for small businesses.", href: "/bk-web-studios" },
];
---
<Base>
  <Intro slot="before" />
  <main id="main">
   <div class="home">
    <div class="light" data-depth="0.35" aria-hidden="true"></div>
    <section class="build" aria-labelledby="build-title" data-build>
      <h1 id="build-title" class="sentence" data-depth="0.06">
        <span class="lead" data-lead><span data-reveal><span class="ln"><span>I build</span></span></span><span class="caret" data-caret aria-hidden="true"></span></span>
        <span class="fill" data-fill aria-live="polite"><a class="word" data-word href="/work" hidden></a></span>
        <span class="sr-only">Salesforce apps, full-stack products, research with data, and websites for small businesses.</span>
      </h1>
      <div class="topics" role="group" aria-label="What I build" data-topics>
        {TOPICS.map((t) => (
          <span class="topic">
            <button type="button" aria-pressed="false" data-fill-text={t.fill} data-href={t.href}>{t.label}</button>
            <a class="go" href={t.href} aria-label={`Go to ${t.label}`} tabindex="-1"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3 8h9M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          </span>
        ))}
      </div>
      <p class="intro-copy">{site.profile.intro}</p>
    </section>
    <Grass />
   </div>
    <div class="hillside">
      <StoryTeaser />
      <FeaturedWork />
      <BkwsDoorway />
      <SiteFooter />
    </div>
  </main>
</Base>

<script>
  import { play } from "@/lib/sound";

  const POOL = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
  const EO = "cubic-bezier(0.23, 1, 0.32, 1)";
  const EIO = "cubic-bezier(0.77, 0, 0.175, 1)";
  const MIN_STRETCH = 62, MAX_STRETCH = 140; // Anybody's usable width range for this
  const reduce = () => matchMedia("(prefers-reduced-motion: reduce)").matches;
  let iv = 0;
  let current: string | null = null;

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel);

  /** Width of `text` in the fill style at a given font size and stretch, measured off-screen. */
  function measure(text: string, sizePx: number, stretch: number): number {
    const probe = document.createElement("span");
    probe.className = "fill-probe";
    probe.textContent = text;
    probe.style.fontSize = `${sizePx}px`;
    probe.style.fontStretch = `${stretch}%`;
    document.body.append(probe);
    const w = probe.getBoundingClientRect().width;
    probe.remove();
    return w;
  }

  /** "I build" spans the full width; the fill line gets one shared font size so every topic fits on one line. */
  function layout() {
    const section = $<HTMLElement>("[data-build]"), lead = $<HTMLElement>("[data-lead]"), fillEl = $<HTMLElement>("[data-fill]");
    if (!section || !lead || !fillEl) return;
    const room = section.getBoundingClientRect().width;
    lead.style.fontSize = "";
    const base = parseFloat(getComputedStyle(lead).fontSize);
    lead.style.fontSize = `${Math.min(((base * room) / lead.getBoundingClientRect().width) * 0.98, 420)}px`;

    // Size the fill so the longest phrase fits at the narrowest stretch, capped well below "I build".
    const texts = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-topics] button")).map((b) => b.dataset.fillText ?? "");
    const longest = Math.max(...texts.map((t) => measure(t, 100, MIN_STRETCH)));
    const leadSize = parseFloat(lead.style.fontSize);
    fillEl.style.fontSize = `${Math.min((100 * room) / longest, leadSize * 0.42)}px`;
    if (current) $<HTMLAnchorElement>("[data-word]")!.style.fontStretch = `${stretchFor(current)}%`;
  }

  /** The stretch that makes `text` span the full width at the fill's font size (two passes of correction). */
  function stretchFor(text: string): number {
    const fillEl = $<HTMLElement>("[data-fill]")!;
    const size = parseFloat(fillEl.style.fontSize || getComputedStyle(fillEl).fontSize);
    const room = $<HTMLElement>("[data-build]")!.getBoundingClientRect().width * 0.99;
    let s = 100;
    for (let i = 0; i < 2; i++) s = Math.max(MIN_STRETCH, Math.min(MAX_STRETCH, (s * room) / measure(text, size, s)));
    return Math.round(s * 10) / 10;
  }

  /** Fill the line: letters scramble while the width eases to the new phrase's stretch. Same height every time. */
  function fill(text: string, href: string, withSound = false) {
    const word = $<HTMLAnchorElement>("[data-word]")!;
    const section = $<HTMLElement>("[data-build]")!;
    window.clearInterval(iv);
    const from = word.hidden ? null : parseFloat(word.style.fontStretch);
    const to = stretchFor(text);
    current = text;
    word.href = href;
    word.hidden = false;
    section.classList.add("filled");
    word.style.fontStretch = `${to}%`;
    if (reduce()) {
      word.textContent = text;
      word.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 200 });
      return;
    }
    if (from === null) word.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 320, easing: EO });
    else word.animate([{ fontStretch: `${from}%` }, { fontStretch: `${to}%` }], { duration: 480, easing: EIO });
    const ticks = 12;
    let n = 0;
    iv = window.setInterval(() => {
      n++;
      let out = "";
      for (let k = 0; k < text.length; k++) {
        const ch = text[k];
        out += ch === " " || ch === "." || ch === "-" || n > (k / text.length) * ticks ? ch : POOL[Math.floor(Math.random() * POOL.length)];
      }
      word.textContent = out;
      if (n >= ticks) { window.clearInterval(iv); word.textContent = text; if (withSound) play("lock"); }
    }, 30);
  }

  /* ---------- auto-cycle: the sentence fills itself in until the visitor picks a topic ---------- */
  const CYCLE_MS = 4500;
  let cycleTimer = 0, startTimer = 0, idx = -1, locked = false, visible = true;

  function buttons() { return Array.from(document.querySelectorAll<HTMLButtonElement>("[data-topics] button")); }

  function select(i: number, how: "auto" | "preview" | "click") {
    const bs = buttons(), b = bs[i];
    if (!b) return;
    idx = i;
    bs.forEach((x) => {
      const on = x === b;
      x.setAttribute("aria-pressed", String(on));
      const wrap = x.closest(".topic"), go = wrap?.querySelector<HTMLAnchorElement>(".go");
      wrap?.classList.toggle("active", on);
      if (go) go.tabIndex = on ? 0 : -1; // only the active topic's arrow is reachable
    });
    const topics = $<HTMLElement>("[data-topics]")!;
    // restart the progress bar under the active pill
    topics.classList.remove("auto"); void topics.offsetWidth;
    if (how === "auto" && !locked) topics.classList.add("auto");
    fill(b.dataset.fillText ?? "", b.dataset.href ?? "/", how === "click");
  }

  function stopCycle() { window.clearTimeout(startTimer); window.clearInterval(cycleTimer); cycleTimer = 0; $<HTMLElement>("[data-topics]")?.classList.remove("auto"); }
  function startCycle(delay: number) {
    stopCycle();
    if (locked) return;
    if (reduce()) { if (idx < 0) select(0, "auto"); return; } // no cycling with reduced motion
    startTimer = window.setTimeout(() => {
      select((idx + 1) % buttons().length, "auto");
      cycleTimer = window.setInterval(() => { if (visible && !document.hidden) select((idx + 1) % buttons().length, "auto"); }, CYCLE_MS);
    }, delay);
  }

  /** Arrival: "I build" rises (shared reveal), the topics appear, then the sentence starts filling itself in. */
  function arrive() {
    layout();
    if (!reduce()) {
      buttons().forEach((b, i) =>
        b.animate([{ opacity: 0, transform: "translateY(8px)" }, { opacity: 1, transform: "none" }], { duration: 420, delay: 800 + i * 60, easing: EO, fill: "backwards" }),
      );
    }
    startCycle(1300);
  }

  function init() {
    const topics = $<HTMLElement>("[data-topics]");
    if (!topics || topics.dataset.bound) return;
    topics.dataset.bound = "1";
    current = null; idx = -1; locked = false;
    const fine = matchMedia("(hover: hover) and (pointer: fine)");
    buttons().forEach((b, i) => {
      b.addEventListener("click", () => { locked = true; stopCycle(); select(i, "click"); });
      // hovering previews a topic (mouse only) and pauses the cycle
      b.addEventListener("pointerenter", () => { if (!fine.matches || locked) return; stopCycle(); if (idx !== i) select(i, "preview"); });
    });
    topics.addEventListener("pointerleave", () => { if (fine.matches && !locked) startCycle(CYCLE_MS); });
    if ("IntersectionObserver" in window) new IntersectionObserver((es) => { visible = es[0]?.isIntersecting ?? true; }).observe(topics);
    (document.fonts?.ready ?? Promise.resolve()).then(layout);
    const intro = document.getElementById("intro");
    if (!intro || intro.hidden) arrive();
  }

  document.addEventListener("astro:before-swap", stopCycle);
  addEventListener("resize", layout);
  document.addEventListener("astro:page-load", init);
  document.addEventListener("bk:intro-reveal", arrive);
</script>

<script>
  // The pointer is the sun (docs/motion-language.md §6): every letter of the headline casts a long, soft shadow
  // across the field that swings away from the pointer, with heavy smoothing. Without a mouse the light sits at the
  // upper right and drifts a little as you scroll; with reduced motion it stays put.
  function sunlit() {
    const found = document.querySelector<HTMLElement>(".sentence");
    if (!found || found.dataset.sunBound) return;
    found.dataset.sunBound = "1";
    const h: HTMLElement = found;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;
    const ac = new AbortController();
    document.addEventListener("astro:before-swap", () => ac.abort(), { once: true });

    let tx = 0.35, ty = -0.6, x = tx, y = ty; // where the light is, relative to the headline (-1..1)
    const paint = () => {
      const dx = -x * 1.6, dy = 0.9 - y * 0.5, layers: string[] = [];
      for (let i = 1; i <= 10; i++) layers.push(`${(dx * i * 4).toFixed(1)}px ${(dy * i * 4).toFixed(1)}px ${i * 2}px rgb(8 30 14 / ${(0.2 * (1 - i / 11)).toFixed(3)})`);
      h.style.textShadow = layers.join(",");
    };
    paint();
    if (reduce) return;
    if (fine) addEventListener("pointermove", (e) => {
      const r = h.getBoundingClientRect();
      tx = Math.max(-1, Math.min(1, (e.clientX - (r.left + r.width / 2)) / (r.width / 2)));
      ty = Math.max(-1, Math.min(1, (e.clientY - (r.top + r.height / 2)) / (innerHeight / 2)));
    }, { passive: true, signal: ac.signal });
    else addEventListener("scroll", () => { tx = 0.35 - Math.max(-0.4, Math.min(0.4, scrollY / 1500)); }, { passive: true, signal: ac.signal });

    // only repaints while the light is still moving, and only while the hero is on screen
    let raf = 0, visible = true;
    const loop = () => {
      raf = 0;
      if (Math.abs(tx - x) + Math.abs(ty - y) < 0.001 || !visible) return;
      x += (tx - x) * 0.07; y += (ty - y) * 0.07;
      paint();
      raf = requestAnimationFrame(loop);
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(loop); };
    addEventListener("pointermove", kick, { passive: true, signal: ac.signal });
    addEventListener("scroll", kick, { passive: true, signal: ac.signal });
    new IntersectionObserver((es) => { visible = es[0]?.isIntersecting ?? true; kick(); }).observe(h);
    ac.signal.addEventListener("abort", () => cancelAnimationFrame(raf));
  }
  document.addEventListener("astro:page-load", sunlit);
</script>

<style>
  .home {
    position: relative;
    isolation: isolate;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: calc(env(safe-area-inset-top, 0px) + 110px) max(20px, env(safe-area-inset-right, 0px)) calc(env(safe-area-inset-bottom, 0px) + clamp(90px, 14vh, 160px)) max(20px, env(safe-area-inset-left, 0px));
  }
  /* The rest of Home sits on the hillside the grass grows from (Grass.astro draws the crest in the same colour). */
  .hillside { --hill: #244a2e; background: var(--hill); }
  /* Morning light: a low warm sun off the top right, drifting slower than the page as you scroll */
  .light {
    position: absolute; z-index: -1; inset: -20% 0 10% 20%; pointer-events: none;
    background:
      radial-gradient(45% 45% at 85% 12%, color-mix(in srgb, var(--world-accent) 38%, transparent), transparent 70%),
      radial-gradient(70% 60% at 75% 20%, rgb(255 250 220 / 0.10), transparent 75%);
  }
  .build { position: relative; z-index: 1; display: flex; flex-direction: column; gap: clamp(16px, 3vh, 28px); }
  .sentence { text-shadow: 0 0.12em 0.35em rgb(8 30 14 / 0.28); } /* lifts the words off the field */
  .sentence { margin: 0; display: flex; flex-direction: column; font-family: var(--font-display); font-weight: 900; }
  .lead { display: inline-flex; align-items: center; align-self: flex-start; white-space: nowrap; font-size: clamp(52px, 10vw, 128px); font-stretch: 118%; line-height: 0.85; }
  /* The caret: the sentence is still being typed until you pick a topic. */
  .caret { display: inline-block; width: 0.07em; height: 0.72em; margin-left: 0.08em; background: var(--thread); animation: caret 1.05s steps(1, end) infinite; }
  @keyframes caret { 50% { opacity: 0; } }
  .filled .caret { display: none; }

  /* The fill line: fixed height, one line, width set by font-stretch. */
  .fill { display: block; height: 1.15em; line-height: 1.15; white-space: nowrap; font-weight: 800; }
  .word {
    color: inherit;
    text-decoration-line: underline; text-decoration-color: var(--thread);
    text-decoration-thickness: 0.07em; text-underline-offset: 0.14em; text-decoration-skip-ink: none;
  }
  :global(.fill-probe) { position: absolute; visibility: hidden; white-space: nowrap; font-family: var(--font-display); font-weight: 800; left: -9999px; top: 0; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Topics look and act like tabs: outlined pills, the active one filled with an arrow that goes to the page,
     and a progress bar while it cycles. */
  .topics { display: flex; flex-wrap: wrap; gap: 10px; }
  .topic {
    position: relative; display: inline-flex; align-items: center; overflow: hidden;
    border-radius: 999px; border: 1px solid color-mix(in srgb, currentColor 45%, transparent);
    transition: background-color var(--t-ui) var(--ease-out), color var(--t-ui) var(--ease-out), border-color var(--t-hover) ease;
  }
  /* Glossy pills: a lit top edge and a soft drop shadow; the active one is a polished bead */
  .topic {
    background: color-mix(in srgb, var(--world-fg) 6%, transparent);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.16), 0 8px 20px -12px rgb(0 0 0 / 0.55);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
  }
  .topic.active {
    background: linear-gradient(to bottom, #ffffff 0%, var(--world-fg) 55%, color-mix(in srgb, var(--world-fg) 88%, #9cc28a) 100%);
    color: var(--world-bg); border-color: var(--world-fg);
    box-shadow: inset 0 1px 0 #fff, inset 0 -3px 8px rgb(0 40 10 / 0.12), 0 12px 26px -12px rgb(0 0 0 / 0.6);
  }
  .topic button {
    position: relative;
    font: 600 16px var(--font-body); color: inherit; cursor: pointer; background: none; border: 0;
    min-height: 44px; padding: 0 18px;
    -webkit-tap-highlight-color: transparent;
    transition: transform var(--t-press) var(--ease-out);
  }
  .topic button:active { transform: scale(0.97); }
  .topic.active button { padding-right: 6px; }
  .go {
    display: grid; place-items: center; width: 0; height: 34px; margin-right: 0; border-radius: 50%;
    color: var(--world-fg); background: var(--world-bg); opacity: 0;
    -webkit-tap-highlight-color: transparent;
    transition: width var(--t-ui) var(--ease-out), margin-right var(--t-ui) var(--ease-out), opacity var(--t-ui) var(--ease-out), transform var(--t-press) var(--ease-out);
  }
  .topic.active .go { width: 34px; margin-right: 5px; opacity: 1; }
  .go:active { transform: scale(0.92); }
  @media (hover: hover) and (pointer: fine) { .topic:hover { border-color: currentColor; } .go:hover { transform: translateX(2px); } }
  .topic::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 3px;
    background: var(--thread); transform: scaleX(0); transform-origin: 0 50%; pointer-events: none;
  }
  .topics.auto .topic.active::after { animation: topic-progress 4500ms linear forwards; }
  @keyframes topic-progress { to { transform: scaleX(1); } }
  .topic button:focus-visible, .go:focus-visible { outline: 2px solid currentColor; outline-offset: -4px; }
  .intro-copy { margin: 0; max-width: 56ch; font-size: 17px; opacity: 0.9; }
  @media (prefers-reduced-motion: reduce) { .caret { animation: none; } .topics.auto .topic.active::after { animation: none; } }
</style>
