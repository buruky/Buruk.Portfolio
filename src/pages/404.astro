---
// 404, in the midnight world (tokens.css). A huge "404" fills the background so the page is unmistakable;
// it's the screen-tear world (docs/motion-language.md): the number carries TV static and a colour split, a slice
// tears sideways every few seconds, and near the pointer the static gets stronger. Copy: site.json → copy.notFound.
import Base from "@/layouts/Base.astro";
import site from "@/lib/site";

const { heading, body } = site.copy.notFound;
---
<Base title="Not found" world="midnight">
  <main id="main" class="lost" data-lost>
    <div class="giant" aria-hidden="true">
      <span class="num">404</span>
      <span class="num noise" data-noise>404</span>
      <span class="num tear">404</span>
    </div>

    <div class="copy">
      <p class="code"><span class="blink" aria-hidden="true">●</span> Error 404 · page not found</p>
      <h1>{heading}</h1>
      <p class="body">{body}</p>
      <div class="actions">
        <a class="btn primary" href="/">Back home <span aria-hidden="true">→</span></a>
        <a class="btn" href="/work">See the work <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </main>
</Base>

<script>
  function init() {
    const root = document.querySelector<HTMLElement>("[data-lost]");
    if (!root || root.dataset.bound) return;
    root.dataset.bound = "1";
    const noise = root.querySelector<HTMLElement>("[data-noise]")!;
    // a small tile of TV static, clipped to the number's shape
    const c = document.createElement("canvas");
    c.width = c.height = 128;
    const x = c.getContext("2d")!;
    const img = x.createImageData(128, 128);
    for (let i = 0; i < img.data.length; i += 4) { const v = Math.random() * 255; img.data[i] = img.data[i + 1] = img.data[i + 2] = v; img.data[i + 3] = 255; }
    x.putImageData(img, 0, 0);
    noise.style.backgroundImage = `url(${c.toDataURL()})`;

    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;
    const ac = new AbortController();
    document.addEventListener("astro:before-swap", () => ac.abort(), { once: true });
    let g = 0.25, target = 0.25, raf = 0, last = 0;
    if (fine) addEventListener("pointermove", (e) => {
      const r = noise.getBoundingClientRect();
      const dx = Math.max(r.left - e.clientX, 0, e.clientX - r.right), dy = Math.max(r.top - e.clientY, 0, e.clientY - r.bottom);
      target = 0.25 + 0.75 * Math.max(0, 1 - Math.hypot(dx, dy) / 260); // calm far away, loud up close
    }, { passive: true, signal: ac.signal });
    const loop = (t: number) => {
      raf = requestAnimationFrame(loop);
      if (t - last < 1000 / 20) return; // static at a choppy 20 fps, like a bad signal
      last = t;
      g += (target - g) * 0.25;
      noise.style.backgroundPosition = `${Math.floor(Math.random() * 128)}px ${Math.floor(Math.random() * 128)}px`;
      noise.style.opacity = (0.12 + g * 0.4).toFixed(2); // stays in the background until the pointer gets close
      root.style.setProperty("--split", `${(3 + g * 9).toFixed(1)}px`);
    };
    raf = requestAnimationFrame(loop);
    ac.signal.addEventListener("abort", () => cancelAnimationFrame(raf));
  }
  document.addEventListener("astro:page-load", init);
</script>

<style>
  .lost {
    --split: 4px;
    position: relative; isolation: isolate; overflow: hidden;
    min-height: 100dvh; display: flex; flex-direction: column; justify-content: flex-end;
    padding: calc(env(safe-area-inset-top, 0px) + 110px) max(20px, env(safe-area-inset-right, 0px)) calc(env(safe-area-inset-bottom, 0px) + 48px) max(20px, env(safe-area-inset-left, 0px));
    background: radial-gradient(90% 70% at 50% 40%, #12102a 0%, var(--world-bg) 70%);
  }

  /* The number: as wide as the screen, behind everything */
  .giant {
    position: absolute; inset: 0; z-index: -1; display: grid; place-items: center; pointer-events: none;
    padding-bottom: 14vh;
  }
  .num {
    grid-area: 1 / 1;
    font-family: var(--font-display); font-weight: 900; font-stretch: 125%;
    font-size: clamp(150px, 30vw, 520px); line-height: 0.8; letter-spacing: -0.04em;
    color: #1c1a3a;
    text-shadow: calc(var(--split) * -1) 0 rgb(255 74 61 / 0.55), var(--split) 0 rgb(106 215 255 / 0.5);
  }
  .noise {
    color: transparent; text-shadow: none;
    -webkit-background-clip: text; background-clip: text; background-size: 128px 128px;
    opacity: 0.18; mix-blend-mode: screen;
  }
  /* every few seconds a slice of the number tears sideways */
  .tear { color: #2a2656; text-shadow: none; opacity: 0; animation: tear 4.6s steps(1) infinite; }
  @keyframes tear {
    0%, 100% { opacity: 0; clip-path: inset(0 0 100% 0); translate: 0 0; }
    58% { opacity: 1; clip-path: inset(30% 0 52% 0); translate: 28px 0; }
    59% { opacity: 1; clip-path: inset(62% 0 24% 0); translate: -22px 0; }
    60% { opacity: 0; }
    86% { opacity: 1; clip-path: inset(12% 0 76% 0); translate: 16px 0; }
    87% { opacity: 0; }
  }

  /* The copy, in front */
  .copy { position: relative; display: flex; flex-direction: column; gap: 16px; max-width: 640px; }
  .code { margin: 0; font: 500 12px var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--world-accent); }
  .blink { display: inline-block; margin-right: 6px; animation: blink 1.2s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  h1 {
    margin: 0; font-family: var(--font-display); font-weight: 900; font-stretch: 118%;
    font-size: clamp(40px, 6.5vw, 88px); line-height: 0.95; text-wrap: balance;
  }
  .body { margin: 0; font-size: 18px; max-width: 46ch; opacity: 0.85; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  .btn {
    display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 20px; border-radius: 999px;
    color: inherit; text-decoration: none; font: 600 16px var(--font-body);
    border: 1px solid color-mix(in srgb, currentColor 40%, transparent);
    background: color-mix(in srgb, var(--world-fg) 5%, transparent);
    transition: border-color var(--t-hover) ease, transform var(--t-press) var(--ease-out);
  }
  .btn.primary { background: var(--world-fg); color: var(--world-bg); border-color: var(--world-fg); }
  .btn:active { transform: scale(0.97); }
  .btn:focus-visible { outline: 2px solid var(--world-accent); outline-offset: 3px; }
  @media (hover: hover) and (pointer: fine) { .btn:hover { border-color: currentColor; } }

  /* Phones: the number sits higher so the copy has room underneath */
  @media (max-width: 700px) {
    .giant { place-items: start center; padding: 22vh 0 0; }
    .num { font-size: 36vw; }
  }
  @media (prefers-reduced-motion: reduce) { .tear, .blink { animation: none; } }
</style>
