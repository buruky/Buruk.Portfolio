---
// Contact (step 9.1), the last stop: the day began in the morning on Home and ends at sunset here, the sun half under the sea.
// Everything you'd act on sits in the hero (email to copy, resume, LinkedIn, GitHub). Then what I'm open to. Then the
// ending: a pinned sunset where the glass ብሩኽ sets like the sun (GlassHero reads [data-glass-set] and [data-horizon];
// it writes the scroll progress as --p), the water takes it, and the page says goodbye. No "Let's talk." footer here:
// this page is the sign-off. Copy: content/site.json → copy.contactPage.
import WorldPage from "@/layouts/WorldPage.astro";
import site from "@/lib/site";
import sunset from "@content/media/images/contact-dusk.png"; // the owner's pick, 2026-11-27: city lights at dusk (source: see CREDITS.md)
// where the photo's horizon and sun are, as fractions of its height and width: the drawn horizon and the glass follow them
const PHOTO = { horizon: 0.522, sunX: 0.5, aspect: sunset.width / sunset.height }; // no sun in this one: the glow's middle
import resumeUrl from "@content/media/resume.pdf?url";

const { email, linkedin, github } = site.profile;
const C = site.copy.contactPage;
const year = new Date().getFullYear();
---
<WorldPage title="Contact" photo={sunset} section="Contact" footer={false} soft={0.8} description="Get in touch with Buruk Yimesgen: email, LinkedIn, GitHub and resume.">
  <Fragment slot="hero">
    <p class="kicker">{C.kicker}</p>
    <h1 id="gh-title" class="title" data-arrive="stretch">{C.title}</h1>
    <p class="lede">{C.body}</p>
    <div class="reach">
      <button type="button" class="email" data-copy-email={email}>
        <span class="addr">{email}</span>
        <span class="hint" data-copy-hint aria-live="polite">Click to copy</span>
      </button>
      <ul class="links">
        <li><a href={resumeUrl} download="Buruk-Yimesgen-Resume.pdf">Resume <span aria-hidden="true">↓</span></a></li>
        <li><a href={linkedin} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a></li>
        <li><a href={github} target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a></li>
        <li><a href={`mailto:${email}`}>Mail app <span aria-hidden="true">↗</span></a></li>
      </ul>
    </div>
  </Fragment>

  <section class="open" data-section="Open to" aria-labelledby="open-title">
    <h2 id="open-title">Open to</h2>
    <ul>{C.openTo.map((r) => <li>{r}</li>)}</ul>
  </section>

  <section slot="end" class="sunset" data-glass-set data-photo-horizon={PHOTO.horizon} data-photo-sun={PHOTO.sunX} data-photo-aspect={PHOTO.aspect} data-section="Sunset" aria-labelledby="bye-title">
    <div class="stage">
      <div class="glow" aria-hidden="true"></div>
      <div class="water" aria-hidden="true"><span class="glint"></span></div>
      <div class="horizon" data-horizon aria-hidden="true"></div>
      <div class="sun" data-sun aria-hidden="true"></div>
      <div class="bye">
        <h2 id="bye-title">{C.closing}</h2>
        <p class="again">
          <a href="/?intro" data-replay-intro><span aria-hidden="true">↺</span> {C.replay}</a>
          <a href="#main" data-to-top>Back to top <span aria-hidden="true">↑</span></a>
        </p>
        <p class="small">© {year} Buruk Yimesgen · <span lang="ti">ብሩኽ</span> · <a href="/credits">Photo credits</a></p>
      </div>
    </div>
  </section>
</WorldPage>

<script>
  import { bindSignOff } from "@/lib/sign-off";
  // Put the drawn horizon and the sun where the photo's are. The glass scene shows the photo centred, covering the
  // screen with 8% to spare (GlassHero fitBackground), so a point in the photo lands at a fixed spot for any screen size.
  function placeHorizon() {
    const el = document.querySelector<HTMLElement>("[data-glass-set]"), stage = el?.querySelector<HTMLElement>(".stage");
    if (!el || !stage) return;
    const W = innerWidth, H = innerHeight, V = W / H, A = Number(el.dataset.photoAspect) || 1.5;
    const ry = V > A ? 1.08 * V / A : 1.08, rx = V > A ? 1.08 : 1.08 * A / V;
    const y = (0.5 + (Number(el.dataset.photoHorizon) - 0.5) * ry) * H, x = (0.5 + (Number(el.dataset.photoSun) - 0.5) * rx) * W;
    stage.style.setProperty("--h", `${y.toFixed(1)}px`); stage.style.setProperty("--sx", `${x.toFixed(1)}px`);
  }
  // Stop partway through the sunset (on the way down) for a moment (0.4 s) and it finishes for you: the glass sets and
  // "Thanks for coming." appears. Never after scrolling up, so it can't drag you back down.
  function autoFinish() {
    const el = document.querySelector<HTMLElement>("[data-glass-set]");
    if (!el) return;
    const ac = new AbortController();
    document.addEventListener("astro:before-swap", () => ac.abort(), { once: true });
    let lastY = scrollY, down = false, idle = 0;
    addEventListener("scroll", () => {
      down = scrollY > lastY; lastY = scrollY;
      clearTimeout(idle);
      idle = window.setTimeout(() => {
        const r = el.getBoundingClientRect(), span = el.offsetHeight - innerHeight;
        const p = -r.top / Math.max(1, span); // same progress the glass reads (GlassHero measureSet)
        if (!down || p <= 0.02 || p >= 0.98) return;
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        scrollTo({ top: scrollY - r.top + span, behavior: reduce ? "auto" : "smooth" }); // a wheel or touch interrupts it
      }, 400);
    }, { passive: true, signal: ac.signal });
    ac.signal.addEventListener("abort", () => clearTimeout(idle));
  }
  document.addEventListener("astro:page-load", () => { bindSignOff(); placeHorizon(); if (location.pathname.startsWith("/contact")) autoFinish(); });
  addEventListener("resize", placeHorizon);
</script>

<style>
  /* hero words (same scale as Work and Resume) */
  .kicker { margin: 0; font: 500 12px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.85; }
  .title { margin: 10px 0 0; font-family: var(--font-display); font-weight: 900; font-stretch: 120%; font-size: clamp(64px, 11vw, 170px); line-height: 0.88; letter-spacing: -0.02em; }
  .lede { margin: 14px 0 0; max-width: 44ch; font-size: clamp(16px, 1.4vw, 19px); line-height: 1.5; text-shadow: 0 1px 12px rgb(0 0 0 / 0.4); }

  .reach { margin-top: 24px; display: grid; gap: 14px; justify-items: start; }
  .email {
    display: grid; gap: 2px; justify-items: start; padding: 14px 22px 12px; border: 0; border-radius: 18px; cursor: pointer; color: #2a0f0c; text-align: left;
    background: linear-gradient(to bottom, #fff7f0, #ffe2cf); box-shadow: inset 0 -2px 0 rgb(0 0 0 / 0.1), 0 18px 40px -18px rgb(0 0 0 / 0.65);
    transition: translate 140ms var(--ease-out), box-shadow 160ms var(--ease-out);
  }
  .email .addr { font: 800 clamp(18px, 2.2vw, 28px)/1.15 var(--font-body); letter-spacing: -0.01em; overflow-wrap: anywhere; }
  .email .hint { font: 500 11px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.6; }
  .email.copied .hint { opacity: 1; color: #b83a36; }
  .email:active { translate: 0 1px; }
  @media (hover: hover) and (pointer: fine) { .email:hover { box-shadow: inset 0 -2px 0 rgb(0 0 0 / 0.1), 0 22px 48px -18px rgb(0 0 0 / 0.75); } }
  .links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .links a {
    display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 0 14px; border-radius: 999px; color: #fff; text-decoration: none;
    font: 600 14px var(--font-body); background: rgb(255 255 255 / 0.14); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.35);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); transition: background-color 160ms ease;
  }
  @media (hover: hover) and (pointer: fine) { .links a:hover { background: rgb(255 255 255 / 0.26); } }
  :is(.email, .links a, .again a):focus-visible { outline: 2px solid #fff; outline-offset: 3px; }

  /* what I'm open to */
  .open {
    max-width: 1180px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 220px) minmax(0, 1fr); gap: 16px clamp(24px, 5vw, 72px); color: #fff;
    padding: clamp(64px, 12vh, 130px) max(24px, env(safe-area-inset-right, 0px)) clamp(24px, 4vh, 48px) max(24px, env(safe-area-inset-left, 0px));
  }
  .open h2 { margin: 0; font: 500 12px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.85; padding-top: 12px; }
  .open ul { list-style: none; margin: 0; padding: 0; display: grid; }
  .open li { padding: 12px 0; border-bottom: 1px solid rgb(255 255 255 / 0.25); font-family: var(--font-display); font-weight: 800; font-stretch: 112%; font-size: clamp(28px, 4vw, 52px); line-height: 1.05; }

  /* the ending: a pinned sunset. The glass (on the canvas behind) sinks under the horizon; the water drawn here,
     frosted and tinted, covers it as it goes. --p (0 → 1) is the scroll progress, written by GlassHero. */
  .sunset { position: relative; height: 170svh; /* 70svh of pinned scroll: the glass sets, then the goodbye (was 240svh: too long a wait) */ color: #fff; }
  .stage { position: sticky; top: 0; height: 100svh; overflow: hidden; --h: 47%; --sx: 50%; } /* set by the script to the photo's own waterline and sun */
  .horizon { position: absolute; left: 0; right: 0; top: var(--h); height: 2px; translate: 0 -1px;
    background: linear-gradient(90deg, transparent, rgb(255 226 196 / 0.95) 30%, rgb(255 240 220) 50%, rgb(255 226 196 / 0.95) 70%, transparent); }
  .water {
    position: absolute; left: 0; right: 0; top: var(--h); bottom: 0;
    -webkit-backdrop-filter: blur(9px) saturate(1.15); backdrop-filter: blur(9px) saturate(1.15);
    background: linear-gradient(to bottom, rgb(255 170 130 / 0.28), rgb(70 40 70 / 0.5) 60%, rgb(20 14 30 / 0.7));
  }
  .glint { position: absolute; left: var(--sx); top: 0; width: min(36vw, 420px); height: 46%; translate: -50% 0; opacity: calc(0.25 + var(--p, 1) * 0.6);
    background: repeating-linear-gradient(to bottom, rgb(255 214 170 / 0.55) 0 2px, transparent 2px 9px);
    -webkit-mask-image: radial-gradient(closest-side, #000, transparent); mask-image: radial-gradient(closest-side, #000, transparent); }
  .sun { position: absolute; left: var(--sx); top: var(--h); width: 1px; height: 1px; }
  .glow { position: absolute; left: var(--sx); top: var(--h); width: 90vmin; height: 90vmin; translate: -50% -50%; border-radius: 50%; pointer-events: none;
    background: radial-gradient(closest-side, rgb(255 196 140 / 0.6), rgb(255 140 100 / 0.15) 60%, transparent); opacity: calc(0.3 + var(--p, 1) * 0.7); }

  .bye {
    /* in the sky above the waterline (it sat out in the water before, which read as too low) */
    position: absolute; left: 0; right: 0; bottom: calc(100% - var(--h) + clamp(48px, 12vh, 140px)); display: grid; justify-items: center; gap: 14px; text-align: center;
    padding: 0 max(24px, env(safe-area-inset-right, 0px)) 0 max(24px, env(safe-area-inset-left, 0px));
    opacity: clamp(0, calc((var(--p, 1) - 0.8) * 6), 1);
  }
  .bye h2 { margin: 0; font-family: var(--font-display); font-weight: 900; font-stretch: 115%; font-size: clamp(34px, 5.4vw, 80px); line-height: 0.95; letter-spacing: -0.015em; text-shadow: 0 2px 24px rgb(0 0 0 / 0.35); }
  .again { margin: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 22px; }
  .again a { color: #fff; font: 600 15px var(--font-body); text-underline-offset: 4px; }
  .small { margin: 6px 0 0; font: 500 11px var(--font-mono); letter-spacing: 0.08em; opacity: 0.7; }
  .small [lang="ti"] { font-family: var(--font-geez); font-size: 13px; letter-spacing: 0; }

  @media (max-width: 860px) {
    .open { grid-template-columns: minmax(0, 1fr); }
  }
</style>
