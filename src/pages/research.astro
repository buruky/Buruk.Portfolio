---
// Research (step 6.4), "Research, after dark.": the night world, the moon over the sea with its reflection on the
// water (the pond breaks it up when you ripple it). Both papers in full: title, authors, advisors, abstract, what it
// found or covers, a reader with real pages (PaperReader), and the PDF. NASA GRACE carries its result as the paper-
// style figure (GraceChart). Also the SEO page for the research: each paper is marked up as a ScholarlyArticle.
// Copy: content/site.json → copy.research (abstracts from the projects).
import WorldPage from "@/layouts/WorldPage.astro";
import PaperReader from "@/components/PaperReader.astro";
import GraceChart from "@/components/GraceChart.astro";
import site from "@/lib/site";
import { projects } from "@/lib/projects";
import moon from "@content/media/images/research-moon.jpg"; // Unsplash (CREDITS.md)

const R = site.copy.research;
const TOTAL: Record<string, number> = { "nasa-grace-climate-research": 31, "quantum-computing-research": 21 };
const papers = R.papers.map((p) => {
  const proj = projects.find((x) => x.slug === p.slug)!;
  return { ...p, abstract: proj.description, pdf: proj.paper!, total: TOTAL[p.slug], facts: "facts" in p ? p.facts : undefined, covers: "covers" in p ? p.covers : undefined };
});
const ld = papers.map((p) => ({
  "@context": "https://schema.org", "@type": "ScholarlyArticle", headline: p.title, name: p.title, abstract: p.abstract,
  author: p.authors.split(" and ").map((name) => ({ "@type": "Person", name })),
  url: new URL(`/research#${p.slug}`, Astro.site).href, encoding: { "@type": "MediaObject", contentUrl: new URL(p.pdf, Astro.site).href, encodingFormat: "application/pdf" },
}));
---
<WorldPage title="Research" photo={moon} section="Research" soft={0.35} description="Buruk Yimesgen's research: imputing missing NASA GRACE satellite water data with machine learning, and an introduction to quantum computing and Grover's algorithm.">
  <Fragment slot="hero">
    <p class="kicker">{R.kicker}</p>
    <h1 id="gh-title" class="title">{R.title}</h1>
    <p class="lede">{R.lede}</p>
    <ul class="jump">
      {papers.map((p) => <li><a href={`#${p.slug}`}><span class="n">{p.n}</span>{p.short}</a></li>)}
    </ul>
  </Fragment>

  <div class="papers">
    {papers.map((p) => (
      <article class="paper" id={p.slug} data-section={p.label ?? p.short} aria-labelledby={`t-${p.slug}`}>
        <header class="head">
          <p class="num">Paper {p.n}</p>
          <h2 id={`t-${p.slug}`}>{p.short}.</h2>
          <p class="full"><cite>{p.title}</cite></p>
          <p class="who">{p.authors}<span class="sep" aria-hidden="true"> · </span><span class="adv">{p.advisors}</span></p>
          {p.where && <p class="where">{p.where}</p>}
        </header>

        <div class="abstract">
          <h3>Abstract</h3>
          <p>{p.abstract}</p>
        </div>

        {p.facts && (
          <ul class="facts">{p.facts.map((f) => <li><span class="big">{f.big}</span><span class="small">{f.small}</span></li>)}</ul>
        )}

        {p.slug === "nasa-grace-climate-research" && (
          <figure class="fig">
            <div class="paper-sheet"><GraceChart /></div>
            <figcaption>{"figureNote" in p ? p.figureNote : ""}</figcaption>
          </figure>
        )}

        {p.covers && (
          <ol class="covers">{p.covers.map((c, i) => <li><span class="ci">{String(i + 1).padStart(2, "0")}</span><h3>{c.name}</h3><p>{c.line}</p></li>)}</ol>
        )}

        <div class="read">
          <h3>Read it</h3>
          <PaperReader pdf={p.pdf} total={p.total} title={p.title} pages={p.pages} />
          <p class="links">
            <a class="pdf" href={p.pdf} target="_blank" rel="noopener">Read all {p.total} pages (PDF) <span aria-hidden="true">↗</span></a>
            <a class="proj" href={`/work/${p.slug}`}>Project page <span aria-hidden="true">→</span></a>
          </p>
        </div>
      </article>
    ))}
  </div>

  {ld.map((x) => <script type="application/ld+json" set:html={JSON.stringify(x)} />)}
</WorldPage>

<style>
  /* hero words (same scale as the other worlds) */
  .kicker { margin: 0; font: 500 12px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.85; }
  .title { margin: 10px 0 0; font-family: var(--font-display); font-weight: 900; font-stretch: 118%; font-size: clamp(52px, 9vw, 140px); line-height: 0.88; letter-spacing: -0.02em; text-wrap: balance; }
  .lede { margin: 14px 0 0; max-width: 46ch; font-size: clamp(16px, 1.4vw, 19px); line-height: 1.5; text-shadow: 0 1px 12px rgb(0 0 0 / 0.5); }
  .jump { list-style: none; margin: 22px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .jump a {
    display: inline-flex; align-items: baseline; gap: 10px; min-height: 42px; align-content: center; padding: 11px 16px; border-radius: 999px; color: inherit; text-decoration: none;
    font: 600 14px var(--font-body); background: rgb(255 255 255 / 0.1); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.3);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); transition: background-color var(--t-hover) ease;
  }
  .jump .n { font: 500 11px var(--font-mono); color: var(--world-accent); }
  @media (hover: hover) and (pointer: fine) { .jump a:hover { background: rgb(255 255 255 / 0.2); } }
  .jump a:focus-visible { outline: 2px solid var(--world-accent); outline-offset: 3px; }

  /* the papers */
  .papers {
    max-width: 1180px; margin: 0 auto; display: grid; gap: clamp(110px, 18vh, 190px); color: var(--world-fg);
    padding: clamp(64px, 12vh, 130px) max(24px, env(safe-area-inset-right, 0px)) clamp(90px, 16vh, 170px) max(24px, env(safe-area-inset-left, 0px));
  }
  .paper { display: grid; gap: clamp(36px, 6vh, 60px); scroll-margin-top: 80px; }
  .head { display: grid; gap: 10px; max-width: 900px; }
  .num { margin: 0; font: 500 12px var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--world-accent); }
  h2 { margin: 0; font-family: var(--font-display); font-weight: 800; font-stretch: 108%; font-size: clamp(34px, 5vw, 72px); line-height: 0.98; letter-spacing: -0.01em; text-wrap: balance; }
  .full { margin: 4px 0 0; max-width: 62ch; font-size: clamp(17px, 1.5vw, 20px); line-height: 1.45; }
  .full cite { font-style: italic; }
  .who { margin: 6px 0 0; font-size: 17px; font-weight: 600; }
  .adv { font-weight: 400; opacity: 0.8; }
  .where { margin: 0; font: 500 12px var(--font-mono); letter-spacing: 0.06em; opacity: 0.75; }
  h3 { margin: 0; font: 500 12px var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.75; }

  .abstract { display: grid; grid-template-columns: minmax(0, 180px) minmax(0, 1fr); gap: 12px clamp(24px, 4vw, 56px); }
  .abstract p { margin: 0; max-width: 66ch; font-size: clamp(17px, 1.4vw, 19px); line-height: 1.65; }

  .facts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid rgb(255 255 255 / 0.18); }
  .facts li { display: grid; gap: 8px; align-content: start; padding: 22px 20px 0 0; }
  .facts .big { white-space: nowrap; font-family: var(--font-display); font-weight: 900; font-stretch: 112%; font-size: clamp(30px, 3.4vw, 48px); line-height: 0.95; color: var(--world-accent); }
  .facts .small { font-size: 14.5px; line-height: 1.45; opacity: 0.85; }

  .fig { margin: 0; display: grid; gap: 14px; }
  .paper-sheet { padding: clamp(10px, 2vw, 26px); background: #fff; border-radius: 4px; box-shadow: 0 40px 70px -36px rgb(0 0 0 / 0.85); }
  .fig figcaption { max-width: 70ch; font-size: 15px; line-height: 1.55; opacity: 0.85; }

  .covers { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 12px; }
  .covers li {
    display: grid; gap: 8px; align-content: start; padding: 20px 20px 22px; border-radius: 16px;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.03)); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.22), inset 0 0 0 1px rgb(255 255 255 / 0.1);
  }
  .ci { font: 500 11px var(--font-mono); color: var(--world-accent); }
  .covers h3 { font: 800 19px/1.2 var(--font-body); letter-spacing: 0; text-transform: none; opacity: 1; }
  .covers p { margin: 0; font-size: 15px; line-height: 1.5; opacity: 0.85; }

  .read { display: grid; gap: 16px; min-width: 0; }
  .links { margin: 4px 0 0; display: flex; flex-wrap: wrap; gap: 10px 22px; align-items: center; }
  .pdf {
    display: inline-flex; align-items: center; gap: 8px; min-height: 46px; padding: 0 20px; border-radius: 999px; text-decoration: none;
    color: var(--world-bg); background: var(--world-fg); font: 600 15px var(--font-body); transition: opacity var(--t-hover) ease;
  }
  @media (hover: hover) and (pointer: fine) { .pdf:hover { opacity: 0.88; } }
  .proj { color: inherit; font-weight: 600; text-underline-offset: 4px; }
  :is(.pdf, .proj):focus-visible { outline: 2px solid var(--world-accent); outline-offset: 3px; }

  @media (max-width: 860px) {
    .abstract { grid-template-columns: minmax(0, 1fr); }
    .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 8px; }
    .facts .big { font-size: clamp(24px, 7.4vw, 34px); }
  }
</style>
