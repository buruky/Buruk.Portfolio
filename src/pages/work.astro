---
// Work (step 4.2, the first page built from the WorldPage recipe): noon over Seattle.
// A plain list of every project for now; step 6.1 turns it into the full index with hover previews,
// and 6.2–6.5 add the case studies.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import WorldPage from "@/layouts/WorldPage.astro";
import site from "@/lib/site";
import seattle from "@content/media/images/city-bg.jpg"; // Seattle skyline with Mount Rainier; swap freely

const shots = import.meta.glob<{ default: ImageMetadata }>("../../content/media/images/screenshots/*.{png,jpg,jpeg,webp}", { eager: true });
const pad = (n: number) => String(n).padStart(2, "0");
const projects = site.projects.map((p) => ({
  ...p,
  short: p.name.split(" — ")[0].replace(/ Salesforce Case Management App$/, " Case Management"),
  line: (p.summary ?? p.description).split(/(?<=\.)\s/)[0],
  img: shots[`../../content/media/${p.screenshot.src}`]?.default,
  contain: p.screenshot.fit === "contain",
  isResearch: p.lane.startsWith("Data Science"),
}));
---
<WorldPage title="Work" photo={seattle} section="Work">
  <Fragment slot="hero">
    <p class="kicker">Work · {pad(projects.length)} projects</p>
    <h1 id="gh-title" class="title" data-arrive="streak">Things I&rsquo;ve built.</h1>
    <p class="lede">Salesforce apps, full-stack products and research, from a nonprofit&rsquo;s daily tools to NASA satellite data.</p>
  </Fragment>

  <ol class="projects">
    {projects.map((p, i) => (
      <li class="project" id={p.slug} data-section={p.short}>
        <div class:list={["shot", { contain: p.contain }]}>
          {p.img && <Image src={p.img} alt={`${p.short} screenshot`} widths={[480, 800, 1100]} sizes="(max-width: 760px) 92vw, 46vw" />}
        </div>
        <div class="meta">
          <p class="top"><span>[{pad(i + 1)}]</span><span>{p.lane}</span></p>
          <h2>{p.short}</h2>
          <p class="line">{p.line}</p>
          <ul class="stack" aria-label="Built with">{p.techStack.map((t) => <li>{t}</li>)}</ul>
          <p class="links">
            {p.liveUrl && <a href={p.liveUrl} target="_blank" rel="noopener">Live site <span aria-hidden="true">↗</span></a>}
            {p.repoUrl && <a href={p.repoUrl} target="_blank" rel="noopener">Code <span aria-hidden="true">↗</span></a>}
            {p.videoUrl && <a href={p.videoUrl} target="_blank" rel="noopener">Demo video <span aria-hidden="true">↗</span></a>}
            {p.isResearch && <a href={`/research#${p.slug}`}>Read the paper <span aria-hidden="true">→</span></a>}
          </p>
        </div>
      </li>
    ))}
  </ol>
</WorldPage>

<style>
  /* hero words */
  .kicker { margin: 0; font: 500 12px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.8; }
  .title {
    margin: 6px 0 0; font-family: var(--font-display); font-weight: 900; font-stretch: 122%;
    font-size: clamp(52px, 8.4vw, 150px); line-height: 0.86; letter-spacing: -0.025em; text-wrap: balance;
    text-shadow: 0 0.05em 0.5em rgb(0 0 0 / 0.35);
  }
  .lede { margin: 14px 0 0; max-width: 44ch; font-size: clamp(16px, 1.4vw, 19px); line-height: 1.5; opacity: 0.92; text-shadow: 0 1px 12px rgb(0 0 0 / 0.4); }

  /* the list */
  .projects {
    list-style: none; margin: 0;
    padding: clamp(56px, 10vh, 120px) max(20px, env(safe-area-inset-right, 0px)) clamp(80px, 14vh, 160px) max(20px, env(safe-area-inset-left, 0px));
    display: flex; flex-direction: column; gap: clamp(72px, 13vh, 150px);
  }
  .project { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(24px, 4vw, 64px); align-items: center; scroll-margin-top: clamp(110px, 16vh, 160px); } /* links like /work#fabriq land clear of the header corners */
  .project:nth-child(even) .shot { order: 2; }
  .shot {
    border-radius: 14px; overflow: hidden; aspect-ratio: 16 / 10; max-width: 100%;
    background: color-mix(in srgb, var(--world-fg) 8%, transparent);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.14), 0 40px 80px -36px rgb(0 0 0 / 0.75);
  }
  .shot :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .shot.contain { background: #f4f1ea; }
  .shot.contain :global(img) { object-fit: contain; padding: 4%; }

  .meta { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .top { margin: 0; display: flex; justify-content: space-between; gap: 16px; font: 500 12px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.8; }
  h2 { margin: 0; font-family: var(--font-display); font-weight: 900; font-stretch: 112%; font-size: clamp(30px, 3.4vw, 50px); line-height: 0.95; text-wrap: balance; }
  .line { margin: 0; max-width: 46ch; font-size: 16px; line-height: 1.55; opacity: 0.92; }
  .stack { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 14px; font: 500 11.5px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.8; }
  .links { margin: 4px 0 0; display: flex; flex-wrap: wrap; gap: 10px 22px; }
  .links a { color: inherit; text-decoration: none; font: 500 12px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; border-bottom: 2px solid var(--thread); padding-bottom: 4px; }
  .links a:focus-visible { outline: 2px solid var(--world-fg); outline-offset: 4px; }

  @media (max-width: 760px) {
    .project { grid-template-columns: minmax(0, 1fr); }
    .project:nth-child(even) .shot { order: 0; }
  }
</style>
