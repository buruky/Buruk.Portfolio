---
// Work (step 6.1, the projects index), on the WorldPage recipe: noon over Seattle.
// A quiet list: just each project's name, kind and lane. Hovering a row expands it in place to show the one-line
// description and the project's short clip (or its screenshot); clicking opens its full-screen page (/work/[slug]).
// Phones: each row carries a small thumbnail instead. Data and clips: src/lib/projects.ts.
import { Image } from "astro:assets";
import WorldPage from "@/layouts/WorldPage.astro";
import ShotCover from "@/components/ShotCover.astro";
import { projects, LANES } from "@/lib/projects";
import seattle from "@content/media/images/city-bg.jpg"; // Seattle skyline with Mount Rainier; swap freely

const FILTERS = [{ key: "all", label: "All" }, ...LANES];
---
<WorldPage title="Work" photo={seattle} section="Work">
  <Fragment slot="hero">
    <p class="kicker">Work · {String(projects.length).padStart(2, "0")} projects</p>
    <h1 id="gh-title" class="title" data-arrive="streak">Things I&rsquo;ve built.</h1>
    <p class="lede">Salesforce apps, full-stack products and research, from a nonprofit&rsquo;s daily tools to NASA satellite data.</p>
  </Fragment>

  <section class="index" data-work-index data-section="Projects" aria-label="Projects">
    <div class="filters" role="group" aria-label="Show projects">
      {FILTERS.map((f, i) => (
        <button type="button" data-filter={f.key} aria-pressed={i === 0 ? "true" : "false"}>
          {f.label}<span class="n">{f.key === "all" ? projects.length : projects.filter((p) => p.lane.key === f.key).length}</span>
        </button>
      ))}
    </div>

    <ol class="rows">
      {projects.map((p) => (
        <li data-lane={p.lane.key} data-row>
          <a class="row" href={`/work/${p.slug}`} data-open>
            <span class="head">
              <span class="idx">{p.index}</span>
              <span class="name">{p.short}</span>
              <span class="kind">{p.kind ?? ""}</span>
              <span class="lane">{p.lane.label}</span>
              <span class="go" aria-hidden="true">→</span>
              {p.img && <span class="thumb" aria-hidden="true"><Image src={p.img} alt="" width={240} /></span>}
            </span>
            <span class="more" aria-hidden="true">
              <span class="inner">
                <span class="line">{p.line}{p.stat && <span class="stat">{p.stat}</span>}</span>
                <span class="media">
                  <ShotCover p={p} bare clip={p.video} />
                </span>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ol>

  </section>
</WorldPage>

<script>
  function init() {
    const root = document.querySelector<HTMLElement>("[data-work-index]");
    if (!root || root.dataset.bound) return;
    root.dataset.bound = "1";
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;
    const rows = Array.from(root.querySelectorAll<HTMLElement>("[data-row]"));

    // filter by lane
    const btns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-filter]"));
    btns.forEach((b) => b.addEventListener("click", () => {
      const key = b.dataset.filter!;
      btns.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      const apply = () => rows.forEach((r) => { r.hidden = key !== "all" && r.dataset.lane !== key; });
      const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
      if (!reduce && doc.startViewTransition) doc.startViewTransition(apply); else apply();
    }));

    if (!fine) return; // phones: the rows carry thumbnails; tapping opens the page

    // hover (after a short pause, so sweeping across the list doesn't flap every row open) expands a row in place.
    // The cover shows first; the clip starts after CLIP_DELAY and fades in once it's actually playing.
    const CLIP_DELAY = 700;
    let timer = 0, clipTimer = 0;
    const rowsA = Array.from(root.querySelectorAll<HTMLElement>("[data-open]"));
    const open = (a: HTMLElement | null) => {
      clearTimeout(clipTimer);
      rowsA.forEach((r) => {
      const on = r === a;
      r.classList.toggle("open", on);
      const v = r.querySelector("video");
      if (!v) return;
      if (on && !reduce) {
        clipTimer = window.setTimeout(() => { v.addEventListener("playing", () => v.classList.add("live"), { once: true }); void v.play().catch(() => {}); }, CLIP_DELAY);
      } else if (!on) { v.pause(); v.classList.remove("live"); v.currentTime = 0; }
    });
    };
    rowsA.forEach((a) => {
      a.addEventListener("pointerenter", () => { clearTimeout(timer); timer = window.setTimeout(() => open(a), 140); });
      a.addEventListener("focus", () => open(a));
    });
    root.querySelector(".rows")!.addEventListener("pointerleave", () => { clearTimeout(timer); timer = window.setTimeout(() => open(null), 200); });
  }
  document.addEventListener("astro:page-load", init);
</script>

<style>
  /* hero words */
  .kicker { margin: 0; font: 500 12px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.8; }
  .title {
    margin: 6px 0 0; font-family: var(--font-display); font-weight: 900; font-stretch: 122%;
    font-size: clamp(52px, 8.4vw, 150px); line-height: 0.86; letter-spacing: -0.025em; text-wrap: balance;
    text-shadow: 0 0.05em 0.5em rgb(0 0 0 / 0.35);
  }
  .lede { margin: 14px 0 0; max-width: 44ch; font-size: clamp(16px, 1.4vw, 19px); line-height: 1.5; opacity: 0.92; text-shadow: 0 1px 12px rgb(0 0 0 / 0.4); }

  .index { position: relative; padding: clamp(48px, 9vh, 100px) max(20px, env(safe-area-inset-right, 0px)) clamp(100px, 16vh, 180px) max(20px, env(safe-area-inset-left, 0px)); }

  /* filter row: frosted pills */
  .filters { display: flex; flex-wrap: wrap; gap: 8px; max-width: 1180px; margin: 0 auto clamp(36px, 6vh, 60px); }
  .filters button {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; border-radius: 999px; border: 0; cursor: pointer;
    color: var(--world-fg); font: 600 14px var(--font-body);
    background: rgb(255 255 255 / 0.1); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.3), inset 0 0 0 1px rgb(255 255 255 / 0.14);
    transition: background-color var(--t-hover) ease, color var(--t-hover) ease;
  }
  .filters .n { font: 500 11px var(--font-mono); opacity: 0.7; }
  .filters button[aria-pressed="true"] { background: var(--world-fg); color: var(--world-bg); }
  @media (hover: hover) and (pointer: fine) { .filters button[aria-pressed="false"]:hover { background: rgb(255 255 255 / 0.2); } }
  .filters button:focus-visible { outline: 2px solid var(--world-fg); outline-offset: 3px; }

  /* the list: big names, a thin rule between rows; the open one stays bright, the rest step back */
  .rows { list-style: none; margin: 0 auto; padding: 0; max-width: 1180px; border-top: 1px solid rgb(255 255 255 / 0.22); }
  .rows li[hidden] { display: none; }
  .row { display: block; border-bottom: 1px solid rgb(255 255 255 / 0.22); color: inherit; text-decoration: none; transition: opacity 300ms var(--ease-out); }
  .head { display: grid; grid-template-columns: 3.2em minmax(0, 1fr) auto auto 1.6em; align-items: baseline; column-gap: clamp(16px, 2vw, 32px); padding: clamp(22px, 3.4vh, 34px) 4px; }
  .idx, .kind, .lane { font: 500 11.5px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.75; }
  .name { font-family: var(--font-display); font-weight: 900; font-stretch: 115%; font-size: clamp(30px, 4.4vw, 68px); line-height: 0.95; letter-spacing: -0.015em; }
  .kind { text-transform: none; letter-spacing: 0.02em; font-family: var(--font-body); font-size: 14px; max-width: 28ch; text-align: right; }
  .go { font-size: 22px; justify-self: end; transition: transform 400ms var(--ease-out); }
  .thumb { display: none; }

  /* the expanding part: closed by default, grows open on hover / focus */
  .more { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 550ms var(--ease-in-out); }
  .inner { min-height: 0; overflow: hidden; display: grid; grid-template-columns: 3.2em minmax(0, 1fr) minmax(0, 420px); column-gap: clamp(16px, 2vw, 32px); align-items: end; }
  .line { grid-column: 2; display: grid; gap: 14px; justify-items: start; align-self: center; max-width: 44ch; font-size: clamp(16px, 1.3vw, 19px); line-height: 1.5; opacity: 0; translate: 0 12px; transition: opacity 400ms var(--ease-out), translate 500ms var(--ease-out); }
  .stat {
    padding: 8px 14px; border-radius: 999px; rotate: -2deg; font: 800 14px/1 var(--font-display); font-stretch: 108%;
    background: rgb(255 255 255 / 0.14); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.4), inset 0 0 0 1px rgb(255 255 255 / 0.18);
  }
  .media { grid-column: 3; position: relative; display: block; aspect-ratio: 16 / 10; margin-bottom: clamp(22px, 3.4vh, 34px); scale: 0.94; opacity: 0; transition: opacity 450ms var(--ease-out), scale 600ms var(--ease-out); }

  .row.open .more { grid-template-rows: 1fr; }
  .row.open .line { opacity: 1; translate: 0 0; transition-delay: 150ms; }
  .row.open .media { opacity: 1; scale: 1; transition-delay: 120ms; }
  .row.open .go { transform: translateX(6px) rotate(-45deg); }
  @media (hover: hover) and (pointer: fine) {
    .rows:has(.open) .row:not(.open) { opacity: 0.4; }
  }
  .row:focus-visible { outline: 2px solid var(--world-fg); outline-offset: 4px; }

  /* phones / touch: no hover, so each row shows a small thumbnail and its kind/lane under the name */
  @media not all and (hover: hover) and (pointer: fine) {
    .more { display: none; }
  }
  @media (max-width: 760px) {
    .head { grid-template-columns: minmax(0, 1fr) 84px; grid-template-areas: "name thumb" "lane thumb"; row-gap: 8px; align-items: center; }
    .idx, .kind, .go { display: none; }
    .name { grid-area: name; font-size: clamp(24px, 7vw, 34px); min-width: 0; overflow-wrap: anywhere; }
    .lane { grid-area: lane; }
    .thumb { display: block; grid-area: thumb; width: 84px; aspect-ratio: 16 / 10; border-radius: 8px; overflow: hidden; box-shadow: 0 0 0 1px rgb(255 255 255 / 0.2); }
    .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 0% 0%; }
  }
  @media (prefers-reduced-motion: reduce) { .more, .line, .media, .row { transition: none; } }
</style>
