---
// Home: selected work, with the same proof-mark covers as /work (ShotCover). Each project's real screenshot sits in
// its crop marks; when the project reaches the middle of the screen, its clip (if it has one) starts in the same box
// after a short delay, like the Work hover. Frames grow into place as they scroll in (CSS scroll-driven animation
// where supported; static otherwise).
import ShotCover from "@/components/ShotCover.astro";
import { projects } from "@/lib/projects";

const FEATURED = [
  { slug: "ecc-salesforce-case-management", title: "ECC Case Management", line: "A Salesforce app for Eritrean Community Connections, a nonprofit serving immigrant families.", stat: "10", statLabel: "staff use it every day", href: "/work/ecc-salesforce-case-management" },
  { slug: "fabriq", title: "Fabriq", line: "An AI fashion app: build a digital closet, get outfits generated from what you own.", stat: "3rd", statLabel: "of 10+ teams at a hackathon", href: "/work/fabriq" },
  { slug: "nasa-grace-climate-research", title: "NASA GRACE", line: "Filling gaps in NASA satellite water data with machine learning.", stat: "2.25×", statLabel: "lower error than the other 4 models", href: "/work/nasa-grace-climate-research" },
].map((f) => {
  const p = projects.find((x) => x.slug === f.slug)!;
  return { ...f, p, lane: p.lane.label, stack: p.techStack.slice(0, 4) };
});
const pad = (n: number) => String(n).padStart(2, "0");
---
<section class="featured" aria-labelledby="featured-title" data-section="Selected work">
  <!-- A sticky side column: "Selected work" stays put while the frames scroll past, and the counter follows along -->
  <header class="head">
    <div class="pin">
      <h2 id="featured-title" data-reveal><span class="ln"><span>Selected work</span></span></h2>
      <p class="count" aria-hidden="true"><span data-work-now>01</span> / {pad(FEATURED.length)}</p>
      <ol class="dots" aria-hidden="true">{FEATURED.map((_, i) => <li class={i === 0 ? "on" : undefined} data-work-dot />)}</ol>
    </div>
  </header>
  <ol class="list">
    {FEATURED.map((p, i) => (
      <li class="project" data-work-item>
        <a class="frame" href={p.href} tabindex="-1" aria-hidden="true">
          <ShotCover p={p.p} bare clip={p.p.video} />
        </a>
        <div class="meta">
          <div class="top">
            <span class="idx">[{pad(i + 1)}]</span>
            <span class="lane">{p.lane}</span>
          </div>
          <div class="mid">
            <h3><a href={p.href}>{p.title}</a></h3>
            <p class="line">{p.line}</p>
            <p class="stat"><b>{p.stat}</b><span>{p.statLabel}</span></p>
          </div>
          <div class="bottom">
            <ul class="stack" aria-label="Built with">
              {p.stack.map((s) => <li>{s}</li>)}
            </ul>
            <a class="view" href={p.href} aria-hidden="true" tabindex="-1">View project <span>↗</span></a>
          </div>
        </div>
      </li>
    ))}
  </ol>
</section>

<script>
  // The counter in the sticky column follows whichever project is in the middle of the screen, and that project's
  // clip starts (after CLIP_DELAY, fading in once it's playing) while the others stop and rewind.
  const CLIP_DELAY = 700;
  function init() {
    const items = Array.from(document.querySelectorAll<HTMLElement>("[data-work-item]"));
    const now = document.querySelector<HTMLElement>("[data-work-now]");
    const dots = Array.from(document.querySelectorAll<HTMLElement>("[data-work-dot]"));
    if (!items.length || !now || now.dataset.bound) return;
    now.dataset.bound = "1";
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let clipTimer = 0;
    const io = new IntersectionObserver((es) => {
      for (const e of es) {
        if (!e.isIntersecting) continue;
        const i = items.indexOf(e.target as HTMLElement);
        now.textContent = String(i + 1).padStart(2, "0");
        dots.forEach((d, k) => d.classList.toggle("on", k === i));
        clearTimeout(clipTimer);
        items.forEach((it, k) => {
          const v = it.querySelector("video");
          if (!v) return;
          if (k === i && !reduce) {
            clipTimer = window.setTimeout(() => { v.addEventListener("playing", () => v.classList.add("live"), { once: true }); void v.play().catch(() => {}); }, CLIP_DELAY);
          } else if (k !== i) { v.pause(); v.classList.remove("live"); v.currentTime = 0; }
        });
      }
    }, { rootMargin: "-50% 0px -50% 0px" });
    items.forEach((it) => io.observe(it));
    document.addEventListener("astro:before-swap", () => { clearTimeout(clipTimer); io.disconnect(); }, { once: true });
  }
  document.addEventListener("astro:page-load", init);
</script>

<style>
  .featured {
    position: relative; z-index: 1;
    padding: clamp(16px, 3vh, 40px) max(20px, env(safe-area-inset-right, 0px)) clamp(80px, 12vh, 140px) max(20px, env(safe-area-inset-left, 0px));
    display: grid; grid-template-columns: minmax(200px, 2.4fr) minmax(0, 9fr); gap: clamp(24px, 4vw, 64px); align-items: start;
  }
  .head { align-self: stretch; }
  .pin { position: sticky; top: calc(env(safe-area-inset-top, 0px) + 112px); display: flex; flex-direction: column; gap: 14px; }
  h2 {
    margin: 0; font-family: var(--font-display); font-weight: 900; font-stretch: 100%; font-size: clamp(36px, 3.6vw, 58px); line-height: 0.92;
    text-shadow: 0 0.12em 0.35em rgb(8 30 14 / 0.28);
  }
  .count { margin: 0; font: 500 clamp(14px, 1.3vw, 18px) var(--font-mono); letter-spacing: 0.08em; opacity: 0.8; font-variant-numeric: tabular-nums; }
  .dots { list-style: none; margin: 0; padding: 0; display: flex; gap: 6px; }
  .dots li { width: 18px; height: 3px; border-radius: 2px; background: color-mix(in srgb, var(--world-fg) 25%, transparent); transition: background-color var(--t-ui) var(--ease-out), width var(--t-ui) var(--ease-out); }
  .dots li.on { width: 34px; background: var(--thread); }

  .list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: clamp(96px, 16vh, 180px); }
  .project {
    position: relative; isolation: isolate;
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: clamp(24px, 4vw, 64px); align-items: stretch;
  }

  /* The frame: the project's proof-mark cover (no box of its own; the crop marks hold it) */
  .frame { display: block; align-self: center; color: inherit; }

  /* Meta column: index and lane at the top, the story in the middle, stack and link at the bottom (like a spec sheet) */
  .meta { display: flex; flex-direction: column; justify-content: space-between; gap: 24px; min-width: 0; padding: 4px 0; }
  .top, .bottom { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; }
  .idx, .lane, .stack, .view { font: 500 12px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .idx { opacity: 0.75; }
  .lane { opacity: 0.75; text-align: right; }
  .mid { display: flex; flex-direction: column; gap: 12px; }
  h3 {
    margin: 0; font-family: var(--font-display); font-weight: 900; font-stretch: 112%; font-size: clamp(28px, 2.9vw, 44px); line-height: 0.95; text-wrap: balance;
    text-shadow: 0 0.12em 0.35em rgb(8 30 14 / 0.28);
  }
  h3 a { color: inherit; text-decoration: none; }
  h3 a:focus-visible { outline: 2px solid var(--world-fg); outline-offset: 4px; }
  .line { margin: 0; font-size: 16px; max-width: 40ch; opacity: 0.9; }
  .stat { margin: 4px 0 0; display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .stat b { font-family: var(--font-display); font-weight: 900; font-stretch: 105%; font-size: clamp(36px, 4vw, 56px); line-height: 1; font-variant-numeric: tabular-nums; color: var(--world-accent); }
  .stat span { font-size: 15px; opacity: 0.85; }
  .stack { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; opacity: 0.8; }
  .view { color: inherit; text-decoration: none; white-space: nowrap; border-bottom: 2px solid var(--thread); padding-bottom: 4px; }
  .view span { display: inline-block; transition: transform var(--t-ui) var(--ease-out); }

  @media (hover: hover) and (pointer: fine) {
    .project:hover .view span { transform: translate(2px, -2px); }
  }

  /* Scroll: each frame grows into place and its glow blooms as it comes into view */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .frame { animation: frame-in linear both; animation-timeline: view(); animation-range: entry 0% cover 40%; }
      .meta { animation: meta-in linear both; animation-timeline: view(); animation-range: entry 10% cover 35%; }
    }
  }
  @keyframes frame-in { from { scale: 0.88; translate: 0 60px; opacity: 0.4; } to { scale: 1; translate: 0 0; opacity: 1; } }
  @keyframes meta-in { from { opacity: 0; translate: 0 30px; } to { opacity: 1; translate: 0 0; } }

  /* Narrower screens: the column becomes a small sticky label riding along the top */
  @media (max-width: 1000px) {
    .featured { grid-template-columns: 1fr; gap: clamp(28px, 5vh, 48px); }
    .head { position: sticky; top: calc(env(safe-area-inset-top, 0px) + 80px); z-index: 2; align-self: start; }
    .pin {
      position: static; flex-direction: row; align-items: center; gap: 14px; width: fit-content;
      padding: 8px 14px; border-radius: 999px;
      background: color-mix(in srgb, var(--world-bg) 60%, transparent); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
      box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.12), 0 10px 24px -14px rgb(0 0 0 / 0.6);
    }
    h2 { font: 600 12px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; text-shadow: none; }
    .count { font-size: 12px; }
  }
  @media (max-width: 760px) {
    .project { grid-template-columns: 1fr; }
    .bottom { align-items: flex-end; }
  }
</style>
