---
import { MENU } from "@/lib/worlds";
---
<div id="site-menu" class="menu" role="dialog" aria-modal="true" aria-label="Site menu" inert transition:persist="site-menu">
  <nav aria-label="Main">
    <ul>
      {MENU.map((item, i) => (
        <li class={item.size} style={`--i:${i}`}>
          <a href={item.href}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<script>
  import { play } from "@/lib/sound";

  const menu = document.getElementById("site-menu")!;
  const button = document.querySelector<HTMLButtonElement>("[data-menu-button]")!;
  const label = button.querySelector<HTMLElement>("[data-menu-label]")!;
  let open = false;

  function links() { return Array.from(menu.querySelectorAll<HTMLAnchorElement>("a")); }

  function setOpen(next: boolean, { silent = false } = {}) {
    if (next === open) return;
    open = next;
    menu.classList.toggle("open", open);
    menu.inert = !open;
    button.setAttribute("aria-expanded", String(open));
    label.textContent = open ? "Close" : "Menu";
    document.documentElement.classList.toggle("menu-open", open);
    if (!silent) play(open ? "menuOpen" : "menuClose");
    if (open) links()[0]?.focus({ preventScroll: true });
    else if (!silent) button.focus({ preventScroll: true });
  }

  button.addEventListener("click", () => setOpen(!open));

  document.addEventListener("keydown", (e) => {
    if (!open) return;
    if (e.key === "Escape") { e.preventDefault(); setOpen(false); return; }
    if (e.key === "Tab") {
      // keep focus inside the menu and its toggle button
      const items: HTMLElement[] = [button, ...links()];
      const i = items.indexOf(document.activeElement as HTMLElement);
      const next = e.shiftKey ? (i <= 0 ? items.length - 1 : i - 1) : (i === items.length - 1 ? 0 : i + 1);
      e.preventDefault();
      items[next]?.focus();
    }
  });
  // Close when a navigation starts (fired by the transition engine).
  document.addEventListener("bk:navigate", () => setOpen(false, { silent: true }));

  // Mark the current page.
  document.addEventListener("astro:page-load", () => {
    const here = location.pathname.replace(/\/+$/, "") || "/";
    links().forEach((a) => {
      const url = new URL(a.href), target = url.pathname.replace(/\/+$/, "") || "/";
      // section links (/resume#skills) aren't pages of their own: only the page's own link is "current"
      if (!url.hash && (target === here || here.startsWith(target + "/"))) a.setAttribute("aria-current", "page");
      else a.removeAttribute("aria-current");
    });
  });
</script>

<style>
  .menu {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(520px, 100%);
    z-index: 80;
    background: var(--world-fg);
    color: var(--world-bg);
    padding: calc(env(safe-area-inset-top, 0px) + 96px) max(28px, env(safe-area-inset-right, 0px)) calc(env(safe-area-inset-bottom, 0px) + 32px) 32px;
    overflow-y: auto;
    overscroll-behavior: contain;
    transform: translateX(100%);
    visibility: hidden;
    transition: transform var(--t-panel) var(--ease-drawer), visibility 0s linear var(--t-panel);
  }
  .menu.open {
    transform: none;
    visibility: visible;
    transition: transform var(--t-panel) var(--ease-drawer), visibility 0s;
  }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 2px 18px; }
  li {
    opacity: 0;
    transform: translateX(14px);
    transition: opacity var(--t-ui) var(--ease-out), transform var(--t-ui) var(--ease-out);
  }
  .open li {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i) * 30ms + 60ms);
  }
  li.big, li.mid { flex-basis: 100%; }
  li.mid { margin-top: 14px; }
  li.small:first-of-type, li.small { margin-top: 18px; }
  a {
    color: inherit;
    text-decoration: none;
    display: inline-block;
    min-height: 44px;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }
  .big a { font-family: var(--font-display); font-weight: 900; font-stretch: 115%; font-size: clamp(40px, 9vw, 62px); line-height: 1.05; }
  .mid a { font-family: var(--font-display); font-weight: 700; font-stretch: 105%; font-size: 28px; line-height: 1.3; }
  .small a { font-family: var(--font-body); font-weight: 600; font-size: 17px; line-height: 44px; }
  a[aria-current="page"] { text-decoration-line: underline; text-decoration-color: var(--thread); }
  @media (hover: hover) and (pointer: fine) {
    a { transition: text-decoration-color var(--t-hover) ease; text-decoration-line: underline; text-decoration-color: transparent; }
    a:hover { text-decoration-color: currentColor; }
    a[aria-current="page"] { text-decoration-color: var(--thread); }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu, .menu.open, li, .open li { transition-duration: 0ms, 0s; transform: none; }
    li { opacity: 1; }
  }
  :global(html.menu-open) { overflow: hidden; }
  /* With the menu open, the page beside the drawer goes soft and steps back (like the hero's words), so the menu and
     the glass name are what you read. Phones skip it: there the menu covers the whole screen. */
  @media (min-width: 641px) {
    :global(main > :not(#glass-hero)) { transition: filter 520ms var(--ease-out), opacity 520ms var(--ease-out); }
    :global(html.menu-open main > :not(#glass-hero)) { filter: blur(10px); opacity: 0.45; pointer-events: none; }
  }
  @media (min-width: 641px) and (prefers-reduced-motion: reduce) {
    :global(html.menu-open main > :not(#glass-hero)) { filter: none; opacity: 0.25; }
  }
</style>
