---
// Home only. The Enter gate: it unlocks sound (browsers need a click first).
// Step 3.1 replaces the middle with the Ge'ez intro animation.
---
<div id="gate" class="gate" role="dialog" aria-modal="true" aria-labelledby="gate-name" hidden>
  <p class="g" lang="ti" aria-hidden="true">ቡሩኽ</p>
  <p class="n" id="gate-name">Buruk Yimesgen</p>
  <div class="btns">
    <button type="button" class="primary" data-enter="sound">Enter with sound</button>
    <button type="button" data-enter="quiet">Enter quietly</button>
  </div>
</div>
<script is:inline>
  try { if (!sessionStorage.getItem("bk-entered")) document.getElementById("gate").hidden = false; } catch (e) {}
</script>

<script>
  import { setSound, unlock, play } from "@/lib/sound";

  function close(gate: HTMLElement) {
    try { sessionStorage.setItem("bk-entered", "1"); } catch { /* ignore */ }
    document.querySelectorAll<HTMLElement>("#main, .hdr").forEach((el) => (el.inert = false));
    const done = () => { gate.hidden = true; };
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return done();
    gate.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 220, easing: "cubic-bezier(0.23, 1, 0.32, 1)" }).finished.then(done);
  }

  document.addEventListener("astro:page-load", () => {
    const gate = document.getElementById("gate");
    if (!gate || gate.hidden || gate.dataset.bound) return;
    gate.dataset.bound = "1";
    document.querySelectorAll<HTMLElement>("#main, .hdr").forEach((el) => (el.inert = true));
    gate.querySelector<HTMLButtonElement>(".primary")?.focus({ preventScroll: true });
    gate.querySelectorAll<HTMLButtonElement>("[data-enter]").forEach((b) =>
      b.addEventListener("click", () => {
        const withSound = b.dataset.enter === "sound";
        if (withSound) { unlock(); setSound(true); play("enter"); } else setSound(false);
        close(gate);
      }),
    );
  });
</script>

<style>
  .gate {
    position: fixed;
    inset: 0;
    z-index: 110;
    background: var(--world-bg);
    color: var(--world-fg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: max(24px, env(safe-area-inset-top, 0px)) max(16px, env(safe-area-inset-right, 0px)) max(24px, env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px));
    text-align: center;
  }
  .gate[hidden] { display: none; }
  .g { font-family: var(--font-geez); font-size: clamp(48px, 12vw, 96px); line-height: 1; margin: 0; }
  .n { font-family: var(--font-display); font-weight: 900; font-stretch: 120%; text-transform: uppercase; font-size: clamp(28px, 7vw, 64px); line-height: 0.95; margin: 0; }
  .btns { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 18px; }
  button {
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, currentColor 40%, transparent);
    background: transparent;
    color: inherit;
    font: 600 15px var(--font-body);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: transform var(--t-press) var(--ease-out), background-color var(--t-hover) ease;
  }
  button:active { transform: scale(0.97); }
  .primary { background: var(--world-fg); color: var(--world-bg); border-color: var(--world-fg); }
</style>
