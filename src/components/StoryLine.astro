---
// The About story as one line (step 5.2, after the August about page in content/inspo): a thin red line loops down the
// page and draws as you read. Each chapter hangs off it: a glass bead where the line passes, a small italic phrase that
// names the moment ("where it starts."), the title and a short paragraph, alternating sides, with a small photo
// floating on the other side. Chapters wait dimmed until the line reaches them, so the eye follows the line.
// Past the last chapter it trails off, unsteady, into what isn't written yet.
// Copy and photos come from content/site.json (copy.about) via the About page. No chapter numbers, on purpose.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import "@fontsource-variable/hanken-grotesk/wght-italic.css";
import { AFRICA } from "@/lib/africa";
import site from "@/lib/site";
const bkUrl = site.bkWebStudios.siteUrl;

type Chapter = { id: string; label: string; title: string; line: string; img: ImageMetadata; pos: string };
interface Props {
  chapters: Chapter[];
  ending: { label: string; title: string; img: ImageMetadata };
}
const { chapters, ending } = Astro.props;
const TILT = [-4, 3, -2.5, 3.5, -3, 2.5];
---
<section class="sl" aria-labelledby="sl-title" data-storyline>
  <h2 id="sl-title" class="sr-only">My story</h2>
  <svg class="path" aria-hidden="true" data-sl-svg>
    <path class="drawn" data-sl-path />
    <path class="trail" data-sl-trail />
  </svg>

  <ol class="stops">
    {chapters.map((c, i) => (
      <li class={`stop ${i % 2 ? "r" : "l"}`} data-sl-stop data-section={c.title.replace(/"/g, "")}>
        <div class="words">
          <p class="when"><span class="bead" data-sl-bead aria-hidden="true"></span><em>{c.label}.</em></p>
          <h3>{c.title}</h3>
          <p class="body">{c.line}</p>
          {c.id === "running-start" && (
            <figure class="aside curve" aria-label="A line that rises, drops hard once, then keeps climbing">
              <svg viewBox="0 0 240 140" aria-hidden="true">
                <rect class="card" x="1" y="1" width="238" height="138" rx="16" />
                <line class="axis" x1="24" y1="112" x2="216" y2="112" />
                <path class="trace" pathLength="1" d="M24 96 C 50 88, 66 78, 92 64 S 112 46, 120 46 C 128 46, 132 96, 142 100 C 152 104, 160 80, 176 62 S 204 30, 216 24" />
                <circle class="dip" cx="141" cy="99.5" r="5" />
                <text class="cap" x="24" y="130">SCHOOL</text>
                <text class="cap red" x="141" y="130">RUNNING START</text>
              </svg>
            </figure>
          )}
          {c.id === "nonprofits" && (
            <p class="aside live" aria-label="Used by 10 staff every day">
              <span class="pulse-dot" aria-hidden="true"></span>
              <span class="live-n">10 staff</span>
              <span class="live-sep" aria-hidden="true">·</span>
              <span>every day</span>
              <span class="live-tag" aria-hidden="true">LIVE</span>
            </p>
          )}
          {c.id === "bkws" && (
            <a class="aside seal sticker" href={bkUrl} target="_blank" rel="noopener" aria-label="Visit BK Web Studios (opens in a new tab)">
              <svg viewBox="0 0 200 200" aria-hidden="true">
                <defs><path id="sl-bk-ring" d="M100 100 m-74 0 a74 74 0 1 1 148 0 a74 74 0 1 1 -148 0" /></defs>
                <circle class="disc" cx="100" cy="100" r="96" />
                <circle class="rim" cx="100" cy="100" r="88" />
                <circle class="rim" cx="100" cy="100" r="54" />
                <g class="spin"><text><textPath href="#sl-bk-ring" textLength="462" lengthAdjust="spacing">BK WEB STUDIOS • VISIT THE SITE •</textPath></text></g>
                <path class="arrow" d="M80 120 L120 80 M90 80 L120 80 L120 110" />
              </svg>
            </a>
          )}
          {c.id === "leap" && (
            <figure class="aside seal" aria-label="Two majors: Computer Science and Mathematics">
              <svg viewBox="0 0 200 200" aria-hidden="true">
                <defs>
                  <path id="sl-seal-ring" d="M100 100 m-74 0 a74 74 0 1 1 148 0 a74 74 0 1 1 -148 0" />
                  <radialGradient id="sl-seal-glass" cx="35%" cy="28%" r="80%"><stop offset="0" stop-color="#fff" stop-opacity="0.3" /><stop offset="1" stop-color="#fff" stop-opacity="0.06" /></radialGradient>
                  <linearGradient id="sl-card-glass" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity="0.26" /><stop offset="1" stop-color="#fff" stop-opacity="0.06" /></linearGradient>
                </defs>
                <circle class="disc" cx="100" cy="100" r="96" />
                <circle class="rim" cx="100" cy="100" r="88" />
                <circle class="rim" cx="100" cy="100" r="58" />
                <g class="spin"><text><textPath href="#sl-seal-ring" textLength="462" lengthAdjust="spacing">COMPUTER SCIENCE • MATHEMATICS •</textPath></text></g>
                <text class="x2" x="100" y="100">×2</text>
                <text class="sub" x="100" y="126">UW · 2026</text>
              </svg>
            </figure>
          )}
        </div>
        {i === 0 ? (
          <figure class="africa" data-sl-snap>
            <svg viewBox={`-20 -20 ${AFRICA.width + 40} ${AFRICA.height + 40}`} role="img" aria-label="Map of Africa with Eritrea marked">
              {AFRICA.countries.map((d) => <path class="land" d={d} />)}
              <path class="eri" d={AFRICA.eritrea} />
              <g transform={`translate(${AFRICA.asmara.x} ${AFRICA.asmara.y})`}>
                <circle class="halo" r="46" />
                <circle class="pulse" r="9" />
                <circle class="pin" r="9" />
                <line class="lead" x1="12" y1="-6" x2="70" y2="-52" />
              </g>
            </svg>
            <figcaption class="tag" style={`left:${((AFRICA.asmara.x + 90) / (AFRICA.width + 40)) * 100}%; top:${((AFRICA.asmara.y - 92) / (AFRICA.height + 40)) * 100}%`}>
              <span class="geez" lang="ti">ኤርትራ</span>
              <span class="coords">Eritrea · Asmara</span>
            </figcaption>
          </figure>
        ) : (
          <div class="pic">
            <figure class="snap" style={`--tilt:${TILT[i % TILT.length]}deg`} data-sl-snap>
              <Image src={c.img} alt="" widths={[280, 420, 560]} sizes="(max-width: 760px) 46vw, 260px" style={`object-position:${c.pos}`} />
            </figure>
          </div>
        )}
      </li>
    ))}
    <li class={`stop end ${chapters.length % 2 ? "r" : "l"}`} data-sl-stop data-sl-end data-section="What's next">
      <div class="words">
        <p class="when"><span class="bead" data-sl-bead aria-hidden="true"></span><em>{ending.label}.</em></p>
        <h3 class="glitch" data-text={ending.title}>{ending.title}</h3>
        <figure class="aside seal loading" aria-label="In progress">
          <svg viewBox="0 0 200 200" aria-hidden="true">
            <defs><path id="sl-next-ring" d="M100 100 m-74 0 a74 74 0 1 1 148 0 a74 74 0 1 1 -148 0" /></defs>
            <circle class="disc" cx="100" cy="100" r="96" />
            <circle class="rim" cx="100" cy="100" r="88" />
            <circle class="rim" cx="100" cy="100" r="54" />
            <g class="spin"><text><textPath href="#sl-next-ring" textLength="462" lengthAdjust="spacing">IN PROGRESS • IN PROGRESS • IN PROGRESS •</textPath></text></g>
            <g class="dots3"><circle cx="82" cy="100" r="5" /><circle cx="100" cy="100" r="5" /><circle cx="118" cy="100" r="5" /></g>
          </svg>
        </figure>
      </div>
      <figure class="snap" style="--tilt:3deg" data-sl-snap>
        <Image src={ending.img} alt="" widths={[280, 420, 560]} sizes="(max-width: 760px) 46vw, 260px" />
      </figure>
    </li>
  </ol>
</section>

<script>
  const reduced = () => matchMedia("(prefers-reduced-motion: reduce)").matches;

  function init() {
    const found = document.querySelector<HTMLElement>("[data-storyline]");
    if (!found || found.dataset.bound) return;
    const root: HTMLElement = found;
    root.dataset.bound = "1";
    const ac = new AbortController();
    document.addEventListener("astro:before-swap", () => ac.abort(), { once: true });
    const svg = root.querySelector<SVGSVGElement>("[data-sl-svg]")!;
    const path = root.querySelector<SVGPathElement>("[data-sl-path]")!;
    const trail = root.querySelector<SVGPathElement>("[data-sl-trail]")!;
    const stops = Array.from(root.querySelectorAll<HTMLElement>("[data-sl-stop]"));
    const snaps = Array.from(root.querySelectorAll<HTMLElement>("[data-sl-snap]"));
    const floats = Array.from(root.querySelectorAll<HTMLElement>("[data-sl-float]"));
    let len = 0, at: number[] = [], raf = 0;

    const lengthAtY = (y: number) => { let lo = 0, hi = len; for (let k = 0; k < 22; k++) { const m = (lo + hi) / 2; if (path.getPointAtLength(m).y < y) lo = m; else hi = m; } return lo; };

    function build() {
      const r = root.getBoundingClientRect();
      const narrow = r.width < 760;
      // the bead of each stop is where the line passes
      const pts = stops.map((s) => { const b = s.querySelector<HTMLElement>("[data-sl-bead]")!.getBoundingClientRect(); return { x: b.left - r.left + b.width / 2, y: b.top - r.top + b.height / 2 }; });
      let x = narrow ? pts[0].x : r.width / 2, y = 0;
      let d = `M ${x} ${y}`;
      pts.forEach((p, i) => {
        const dy = p.y - y;
        // soft S-curves with vertical tangents, so the line flows from bead to bead
        d += ` C ${x} ${y + dy * 0.55}, ${p.x} ${p.y - dy * 0.55}, ${p.x} ${p.y}`;
        x = p.x; y = p.y;
        void i;
      });
      path.setAttribute("d", d);
      // past the last stop the line wanders on, broken and unsure
      const end = pts[pts.length - 1];
      trail.setAttribute("d", `M ${end.x} ${end.y} C ${end.x} ${end.y + 90}, ${end.x - 60} ${end.y + 120}, ${end.x - 40} ${end.y + 200} S ${end.x + 30} ${end.y + 280}, ${end.x + 10} ${end.y + 340}`);
      svg.setAttribute("viewBox", `0 0 ${r.width} ${r.height}`);
      len = path.getTotalLength();
      at = pts.map((p) => lengthAtY(p.y));
      path.style.strokeDasharray = `${len}`;
      update();
    }

    function update() {
      raf = 0;
      const r = root.getBoundingClientRect();
      const drawn = reduced() ? len : Math.max(0, Math.min(len, lengthAtY(innerHeight * 0.62 - r.top)));
      path.style.strokeDashoffset = `${len - drawn}`;
      stops.forEach((s, i) => s.classList.toggle("lit", drawn >= at[i] - 2));
      root.classList.toggle("ended", drawn >= len - 2);
      // photos drift a little slower than the page, so they float
      if (!reduced() && innerWidth >= 760) floats.forEach((f) => { const b = f.getBoundingClientRect(); const off = (b.top + b.height / 2 - innerHeight / 2) * -0.16; f.style.translate = `0 ${off.toFixed(1)}px`; });
      if (!reduced() && innerWidth >= 760) snaps.forEach((f) => { const b = f.parentElement!.getBoundingClientRect(); const off = (b.top + b.height / 2 - innerHeight / 2) * -0.08; f.style.translate = `0 ${off.toFixed(1)}px`; });
    }

    addEventListener("scroll", () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true, signal: ac.signal });
    const ro = new ResizeObserver(() => build());
    ro.observe(root);
    ac.signal.addEventListener("abort", () => ro.disconnect());
    (document.fonts?.ready ?? Promise.resolve()).then(build);
  }
  document.addEventListener("astro:page-load", init);
</script>

<style>
  .sl { position: relative; z-index: 1; padding: clamp(40px, 8vh, 90px) max(20px, env(safe-area-inset-right, 0px)) clamp(260px, 40vh, 420px) max(20px, env(safe-area-inset-left, 0px)); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Asides: small glass pieces beside a chapter's words, on its outer side (the leap's ×2 seal, Running Start's curve,
     the live pill, the BK Web Studios sticker, the in-progress seal). Under the paragraph when there's no room. */
  .pic { position: relative; }
  .stop.l .pic { grid-column: 2; grid-row: 1; justify-self: start; }
  .stop.r .pic { grid-column: 1; grid-row: 1; justify-self: end; }
  .words { position: relative; }
  .aside { position: absolute; top: 50%; translate: 0 -50%; margin: 0; opacity: 0; scale: 0.88; transition: opacity 800ms var(--ease-out) 300ms, scale 900ms var(--ease-out) 300ms; }
  .stop.r .aside { left: calc(100% + clamp(24px, 2.6vw, 48px)); }
  .stop.l .aside { right: calc(100% + clamp(24px, 2.6vw, 48px)); }
  .stop.lit .aside { opacity: 1; scale: 1; }
  .aside svg { display: block; width: 100%; height: auto; overflow: visible; }
  @media (max-width: 1339px) {
    .aside, .stop.r .aside, .stop.l .aside { position: relative; left: auto; right: auto; top: auto; translate: none; margin-top: 26px; }
  }

  /* seals: a round glass disc with a turning rim of text */
  .seal { width: clamp(170px, 14vw, 210px); rotate: -8deg; }
  .seal .disc { fill: url(#sl-seal-glass); stroke: color-mix(in srgb, var(--world-fg) 40%, transparent); stroke-width: 1.2; filter: drop-shadow(0 14px 22px rgb(0 0 0 / 0.25)); }
  .seal .rim { fill: none; stroke: color-mix(in srgb, var(--world-fg) 30%, transparent); stroke-width: 0.8; }
  .seal .spin { transform-origin: 100px 100px; }
  .stop.lit .seal .spin { animation: seal-turn 28s linear infinite; }
  @keyframes seal-turn { to { transform: rotate(360deg); } }
  .seal .spin text { font: 600 11px var(--font-mono); letter-spacing: 0.08em; fill: var(--world-fg); }
  .seal .x2 { font: 900 46px var(--font-display); font-stretch: 110%; fill: var(--thread); text-anchor: middle; dominant-baseline: middle; }
  .seal .sub { font: 500 8.5px var(--font-mono); letter-spacing: 0.14em; fill: var(--world-fg); opacity: 0.75; text-anchor: middle; }

  /* Running Start: the line climbs, drops hard once, and keeps climbing (drawn when the line arrives) */
  .curve { width: clamp(210px, 17vw, 250px); rotate: 3deg; }
  .curve .card { fill: url(#sl-card-glass); stroke: color-mix(in srgb, var(--world-fg) 35%, transparent); stroke-width: 1; filter: drop-shadow(0 14px 22px rgb(0 0 0 / 0.22)); }
  .curve .axis { stroke: color-mix(in srgb, var(--world-fg) 25%, transparent); stroke-width: 1; }
  .curve .trace { fill: none; stroke: var(--world-fg); stroke-width: 2.5; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.8s var(--ease-in-out) 500ms; }
  .stop.lit .curve .trace { stroke-dashoffset: 0; }
  .curve .dip { fill: var(--thread); transform-box: fill-box; transform-origin: center; scale: 0; transition: scale 400ms var(--ease-out) 1.4s; }
  .stop.lit .curve .dip { scale: 1; }
  .curve .cap { font: 600 9px var(--font-mono); letter-spacing: 0.12em; fill: var(--world-fg); opacity: 0.6; }
  .curve .cap.red { fill: #b3261e; opacity: 1; text-anchor: middle; font-weight: 700; }

  /* Building for people: a glass pill, like a dashboard tile, with a live dot */
  .live {
    display: flex; align-items: center; gap: 9px; width: max-content; padding: 12px 18px; border-radius: 999px; white-space: nowrap; rotate: -3deg;
    font: 800 clamp(15px, 1.3vw, 18px)/1 var(--font-display); font-stretch: 108%; color: var(--world-fg);
    background: linear-gradient(to bottom, rgb(255 255 255 / 0.24), rgb(255 255 255 / 0.06));
    -webkit-backdrop-filter: blur(14px) saturate(1.3); backdrop-filter: blur(14px) saturate(1.3);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.5), inset 0 0 0 1px color-mix(in srgb, var(--world-fg) 22%, transparent), 0 18px 36px -20px rgb(0 0 0 / 0.45);
  }
  .live-sep { opacity: 0.5; }
  .live-tag { font: 600 9.5px var(--font-mono); letter-spacing: 0.14em; color: #1f8a43; margin-left: 4px; }
  .pulse-dot { position: relative; width: 9px; height: 9px; border-radius: 50%; background: #2fbf5b; box-shadow: 0 0 0 0 rgb(47 191 91 / 0.6); }
  .stop.lit .pulse-dot { animation: live-pulse 2s ease-out infinite; }
  @keyframes live-pulse { 0% { box-shadow: 0 0 0 0 rgb(47 191 91 / 0.55); } 80%, 100% { box-shadow: 0 0 0 9px rgb(47 191 91 / 0); } }

  /* BK Web Studios: a glass sticker in the studio's colours that is the link to the site */
  .sticker { display: block; cursor: pointer; rotate: 7deg; text-decoration: none; -webkit-tap-highlight-color: transparent; transition: opacity 800ms var(--ease-out) 300ms, scale 900ms var(--ease-out) 300ms, rotate 400ms var(--ease-out); }
  .sticker .disc { fill: rgb(237 231 221 / 0.55); stroke: #d57d3b; stroke-width: 1.5; }
  .sticker .rim { stroke: rgb(46 97 112 / 0.5); }
  .sticker .spin text { fill: #2e6170; }
  .sticker .arrow { fill: none; stroke: #d57d3b; stroke-width: 9; stroke-linecap: round; stroke-linejoin: round; transition: transform 300ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .stop.lit .sticker:hover { scale: 1.06; rotate: 0deg; }
    .sticker:hover .arrow { transform: translate(3px, -3px); }
  }
  .sticker { width: clamp(120px, 9.5vw, 145px); }
  /* the live pill sits on the other side: out past the line, over the photo's lower corner */
  @media (min-width: 1340px) {
    .stop.l .live { right: auto; left: calc(100% + clamp(40px, 4vw, 70px)); top: auto; bottom: -18px; translate: none; z-index: 3; }
  }
  .sticker:focus-visible { outline: 2px solid var(--world-fg); outline-offset: 6px; border-radius: 50%; }

  /* What's next: the same kind of seal, still loading */
  .loading { rotate: 6deg; }
  .loading .dots3 circle { fill: var(--thread); opacity: 0.25; }
  .stop.lit .loading .dots3 circle { animation: dot-blink 1.4s ease-in-out infinite; }
  .stop.lit .loading .dots3 circle:nth-child(2) { animation-delay: 0.2s; }
  .stop.lit .loading .dots3 circle:nth-child(3) { animation-delay: 0.4s; }
  @keyframes dot-blink { 0%, 100% { opacity: 0.25; } 40% { opacity: 1; } }

  /* chapter 01's picture: Africa, quiet, with Eritrea lit and a pin on Asmara (drawn in when the line arrives) */
  .africa { position: relative; margin: 0; width: clamp(240px, 28vw, 380px); opacity: 0; scale: 0.96; transition: opacity 900ms var(--ease-out), scale 900ms var(--ease-out); }
  .stop.lit .africa { opacity: 1; scale: 1; }
  .africa svg { display: block; width: 100%; height: auto; overflow: visible; }
  .land { fill: rgb(255 255 255 / 0.1); stroke: color-mix(in srgb, var(--world-fg) 35%, transparent); stroke-width: 0.8; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .eri { fill: rgb(255 255 255 / 0.1); stroke: var(--thread); stroke-width: 1.5; vector-effect: non-scaling-stroke; transition: fill 900ms ease 500ms; }
  .stop.lit .eri { fill: var(--thread); }
  .pin { fill: #fff; stroke: var(--thread); stroke-width: 3; transform-box: fill-box; transform-origin: center; scale: 0; transition: scale 500ms var(--ease-out) 900ms; }
  .stop.lit .pin { scale: 1; }
  .halo { fill: rgb(255 74 61 / 0.3); filter: blur(10px); opacity: 0; transition: opacity 800ms ease 900ms; }
  .stop.lit .halo { opacity: 1; }
  .pulse { fill: none; stroke: #fff; stroke-width: 2.5; transform-box: fill-box; transform-origin: center; opacity: 0; }
  .stop.lit .pulse { animation: pin-pulse 2.6s var(--ease-out) 1.3s infinite; }
  @keyframes pin-pulse { from { scale: 1; opacity: 0.9; } to { scale: 4; opacity: 0; } }
  .lead { stroke: color-mix(in srgb, var(--world-fg) 70%, transparent); stroke-width: 1.5; vector-effect: non-scaling-stroke; stroke-dasharray: 100; stroke-dashoffset: 100; transition: stroke-dashoffset 600ms var(--ease-out) 1.1s; }
  .stop.lit .lead { stroke-dashoffset: 0; }
  .tag { position: absolute; display: grid; gap: 2px; white-space: nowrap; translate: 0 -100%; opacity: 0; transition: opacity 600ms var(--ease-out) 1.4s; }
  .stop.lit .tag { opacity: 1; }
  .geez { font: 400 clamp(30px, 3vw, 42px)/1 var(--font-geez); }
  .coords { font: 500 10.5px var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.8; }
  .stop.l .africa { grid-column: 2; grid-row: 1; justify-self: start; }
  .stop.r .africa { grid-column: 1; grid-row: 1; justify-self: end; }

  /* the line */
  .path { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; z-index: 0; }
  .path path { fill: none; stroke: var(--thread); stroke-width: 2; stroke-linecap: round; }
  .drawn { filter: drop-shadow(0 2px 6px rgb(0 0 0 / 0.2)); }
  .trail { stroke-dasharray: 2 10; opacity: 0; transition: opacity 500ms var(--ease-out); }
  .sl.ended .trail { opacity: 1; animation: trail-move 1.4s linear infinite, trail-flicker 2.8s steps(1) infinite; }
  @keyframes trail-move { to { stroke-dashoffset: -24; } }
  @keyframes trail-flicker { 0%, 100% { opacity: 1; } 31% { opacity: 0.3; } 33% { opacity: 1; } 68% { opacity: 0.1; } 70% { opacity: 1; } }

  /* the stops */
  .stops { list-style: none; margin: 0 auto; padding: 0; max-width: 1120px; position: relative; z-index: 1; display: flex; flex-direction: column; gap: clamp(140px, 26vh, 260px); }
  .stop { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; column-gap: clamp(32px, 6vw, 110px); }
  .stop.l .words { grid-column: 1; justify-self: end; }
  .stop.l .snap { grid-column: 2; grid-row: 1; justify-self: start; }
  .stop.r .words { grid-column: 2; justify-self: start; }
  .stop.r .snap { grid-column: 1; grid-row: 1; justify-self: end; }
  .words { max-width: 34ch; min-width: 0; opacity: 0.32; transform: translateY(14px); transition: opacity 700ms var(--ease-out), transform 700ms var(--ease-out); }
  .stop.lit .words { opacity: 1; transform: none; }

  /* the moment, named on the line */
  .when { margin: 0 0 12px; display: flex; align-items: center; gap: 12px; font: italic 500 clamp(17px, 1.5vw, 21px)/1.2 "Hanken Grotesk Variable", var(--font-body); color: color-mix(in srgb, var(--thread) 62%, var(--world-fg)); }
  /* the bead sits on the inner edge of the words (toward the middle), so the line runs down the gap between the words
     and the photos instead of through the paragraphs */
  .stop.l .when { flex-direction: row-reverse; justify-content: flex-start; }
  .stop.l .when .bead { margin-left: 0; margin-right: -7px; }
  .stop.r .when .bead { margin-left: -7px; }
  .bead {
    flex: none; width: 14px; height: 14px; border-radius: 50%; margin-left: -7px;
