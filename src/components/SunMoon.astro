---
// The Day / Night icon (step 9.2), used in the header's corner and island. A sun whose rays draw in while it turns,
// then the disc swells and a shadow slides across it into a crescent; back to day it all plays in reverse, the rays
// popping out one by one. Driven by the parent button's aria-pressed (true = night). Pure SVG + CSS transitions.
interface Props { id: string }
const { id } = Astro.props;
const rays = Array.from({ length: 8 }, (_, i) => i * 45);
---
<svg class="sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <mask id={`sm-${id}`}>
    <rect width="24" height="24" fill="#fff" />
    <circle class="cut" cx="2.8" cy="0.1" r="4.6" fill="#000" />
  </mask>
  <g class="spin">
    <circle class="disc" cx="12" cy="12" r="5" fill="currentColor" mask={`url(#sm-${id})`} />
    <g class="rays" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      {rays.map((a, i) => <line x1="12" y1="2.2" x2="12" y2="4.2" style={`--a:${a}deg;--i:${i}`} />)}
    </g>
  </g>
</svg>

<style>
  .sm { width: 100%; height: 100%; display: block; overflow: visible; }
  .spin, .disc, .cut, .rays line { transform-box: view-box; transform-origin: 12px 12px; }
  /* day → the resting sun */
  .spin { transition: rotate 600ms cubic-bezier(0.77, 0, 0.175, 1); }
  .disc { transition: scale 420ms cubic-bezier(0.34, 1.45, 0.64, 1); }
  .cut { transition: translate 420ms cubic-bezier(0.23, 1, 0.32, 1); }
  .rays line {
    rotate: var(--a); transform-origin: 12px 12px;
    transition: scale 340ms cubic-bezier(0.34, 1.6, 0.64, 1) calc(160ms + var(--i) * 28ms), opacity 200ms ease calc(160ms + var(--i) * 28ms);
  }
  /* night: rays draw in first, then the shadow carves the crescent */
  :global([aria-pressed="true"]) .sm .spin { rotate: 90deg; }
  :global([aria-pressed="true"]) .sm .disc { scale: 1.55; transition-delay: 160ms; }
  :global([aria-pressed="true"]) .sm .cut { translate: 7.2px 9.3px; transition-delay: 180ms; }
  :global([aria-pressed="true"]) .sm .rays line {
    scale: 0; opacity: 0;
    transition: scale 220ms cubic-bezier(0.23, 1, 0.32, 1) calc(var(--i) * 18ms), opacity 160ms ease calc(var(--i) * 18ms);
  }
  @media (prefers-reduced-motion: reduce) {
    .spin, .disc, .cut, .rays line { transition: none !important; }
  }
</style>
