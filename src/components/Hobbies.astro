---
// About: "Off the clock." A loose fan of tilted frosted-glass cards, one per hobby (copy in content/site.json →
// copy.about.hobbies). They sit stacked and spread into the fan as the section scrolls in; hovering one straightens and
// lifts it and its photo rises up behind the words (tap on phones). Icons are simple drawings (no team logos).
// Phones: a 2 × 2 grid, still a little tilted.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import site from "@/lib/site";

const imgs = import.meta.glob<{ default: ImageMetadata }>("../../content/media/images/**/*.{png,jpg,jpeg,webp}", { eager: true });

const { heading, items } = site.copy.about.hobbies;
const TILT = [-7, 4, -3, 6];
const LIFT = [18, -10, 26, -4];
---
<section class="hb" aria-labelledby="hb-title" data-section="Off the clock" data-hobbies>
  <h2 id="hb-title" data-reveal><span class="ln"><span>{heading}</span></span></h2>
  <ul class="cards">
    {items.map((h, i) => (
      <li class="card" tabindex="0" data-hobby style={`--tilt:${TILT[i % TILT.length]}deg; --lift:${LIFT[i % LIFT.length]}px; --i:${i}`}>
        {imgs[`../../content/media/${h.image}`] && (
          <div class="photo" aria-hidden="true">
            <Image src={imgs[`../../content/media/${h.image}`].default} alt="" widths={[320, 520]} sizes="260px" style={`object-position:${h.position}`} />
          </div>
        )}
        <svg class="icon" viewBox="0 0 64 64" aria-hidden="true">
          {h.id === "football" && (<g><ellipse cx="32" cy="32" rx="26" ry="15" transform="rotate(-35 32 32)" /><path d="M22 42 L42 22 M27 31 l6 6 M31 27 l6 6 M35 23 l6 6 M23 35 l6 6" /></g>)}
          {h.id === "basketball" && (<g><circle cx="32" cy="32" r="24" /><path d="M8 32 H56 M32 8 V56 M15 15 C25 25 25 39 15 49 M49 15 C39 25 39 39 49 49" /></g>)}
          {h.id === "screen" && (<g><rect x="8" y="14" width="48" height="32" rx="4" /><path d="M28 24 L38 30 L28 36 Z" /><path d="M22 54 H42 M32 46 V54" /></g>)}
          {h.id === "travel" && (<g><path d="M8 38 L56 22 L50 16 L30 26 L18 18 L13 20 L22 30 L12 34 L8 30 L5 31 Z" /><path d="M14 50 H50" /></g>)}
        </svg>
        <h3>{h.title}</h3>
        <p>{h.line}</p>
      </li>
    ))}
  </ul>
</section>

<script>
  function init() {
    const s = document.querySelector<HTMLElement>("[data-hobbies]");
    if (!s || s.dataset.bound) return;
    s.dataset.bound = "1";
    if (matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) { s.classList.add("open"); return; }
    // phones: tap a card to show its photo (tap again, or another card, to hide it)
    s.querySelectorAll<HTMLElement>("[data-hobby]").forEach((c) => c.addEventListener("click", () => {
      const on = !c.classList.contains("shown");
      s.querySelectorAll(".shown").forEach((x) => x.classList.remove("shown"));
      c.classList.toggle("shown", on);
    }));
    s.classList.add("ready");
    const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { s.classList.add("open"); io.disconnect(); } }, { threshold: 0.35 });
    io.observe(s.querySelector(".cards")!);
    document.addEventListener("astro:before-swap", () => io.disconnect(), { once: true });
  }
  document.addEventListener("astro:page-load", init);
</script>

<style>
  .hb { position: relative; z-index: 1; padding: clamp(40px, 8vh, 90px) max(20px, env(safe-area-inset-right, 0px)) clamp(110px, 18vh, 180px) max(20px, env(safe-area-inset-left, 0px)); }
  h2 { margin: 0 auto clamp(40px, 7vh, 70px); max-width: 1120px; font-family: var(--font-display); font-weight: 900; font-stretch: 118%; font-size: clamp(40px, 6vw, 80px); line-height: 0.95; }

  .cards { list-style: none; margin: 0 auto; padding: 0; max-width: 1120px; display: flex; justify-content: center; align-items: flex-start; }
  .card {
    position: relative; flex: 0 0 auto; width: clamp(200px, 18vw, 250px); min-height: 280px; margin: 0 -4px;
    display: flex; flex-direction: column; gap: 10px; padding: 26px 22px; border-radius: 20px; color: var(--world-fg);
    background: linear-gradient(to bottom, rgb(255 255 255 / 0.26), rgb(255 255 255 / 0.07));
    -webkit-backdrop-filter: blur(16px) saturate(1.3); backdrop-filter: blur(16px) saturate(1.3);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.55), inset 0 0 0 1px color-mix(in srgb, var(--world-fg) 20%, transparent), 0 26px 50px -26px rgb(0 0 0 / 0.5);
    rotate: var(--tilt); translate: 0 var(--lift); z-index: calc(1 + var(--i));
    transition: rotate 700ms var(--ease-out), translate 700ms var(--ease-out), scale 400ms var(--ease-out);
  }
  /* before the section scrolls in, the cards sit in a neat stack; then they spread into the fan */
  .hb.ready:not(.open) .card { rotate: 0deg; translate: calc((1.5 - var(--i)) * 70%) 30px; }
  .hb.open .card { transition-delay: calc(var(--i) * 70ms); }
  @media (hover: hover) and (pointer: fine) {
    .card:hover { rotate: 0deg; translate: 0 calc(var(--lift) - 16px); scale: 1.04; z-index: 10; transition-delay: 0ms; }
  }

  /* the photo: hidden below the card, rises in behind the words on hover / focus / tap; the words turn light over it */
  .card { overflow: hidden; isolation: isolate; cursor: default; outline: none; }
  .card:focus-visible { box-shadow: 0 0 0 2px var(--world-fg), 0 26px 50px -26px rgb(0 0 0 / 0.5); }
  .photo { position: absolute; inset: 0; z-index: -1; clip-path: inset(100% 0 0 0); transition: clip-path 650ms var(--ease-in-out); }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; scale: 1.12; transition: scale 1100ms var(--ease-out); }
  .photo::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to bottom, rgb(0 0 0 / 0.15), rgb(0 0 0 / 0.15) 40%, rgb(0 0 0 / 0.72)); }
  .card :is(h3, p, .icon) { transition: color 400ms var(--ease-out), stroke 400ms var(--ease-out); }
  .card:is(:hover, :focus-visible, .shown) .photo { clip-path: inset(0 0 0 0); }
  .card:is(:hover, :focus-visible, .shown) .photo :global(img) { scale: 1; }
  .card:is(:hover, :focus-visible, .shown) :is(h3, p) { color: #fff; }
  .card:is(:hover, :focus-visible, .shown) .icon { stroke: #fff; }
  .card.shown { rotate: 0deg; z-index: 10; }

  .icon { width: 52px; height: 52px; fill: none; stroke: var(--world-fg); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; opacity: 0.85; }
  .card:nth-child(1) .icon { stroke: color-mix(in srgb, var(--thread) 70%, var(--world-fg)); }
  h3 { margin: auto 0 0; font-family: var(--font-display); font-weight: 900; font-stretch: 112%; font-size: clamp(22px, 2vw, 28px); line-height: 1; text-wrap: balance; }
  p { margin: 0; font-size: 15.5px; line-height: 1.5; opacity: 0.9; }

  @media (max-width: 760px) {
    .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 12px; }
    .card { width: auto; min-height: 220px; margin: 0; padding: 20px 16px; translate: 0 calc(var(--lift) / 3); }
    .hb.ready:not(.open) .card { translate: 0 30px; }
  }
  @media (prefers-reduced-motion: reduce) { .card, .photo, .photo :global(img) { transition: none; } }
</style>
