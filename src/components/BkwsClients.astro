---
// BK Web Studios (step 7.2): the client sites, each on a laptop with its phone version beside it, and what I did for
// it in my own words (from bkwebstudios.com). Shown, never linked (docs/research-notes.md): the sites belong to their
// owners. Rows alternate sides. Data: content/site.json → clientSites (those with "mockups") and bkWebStudios.work.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import site from "@/lib/site";

type Client = (typeof site.clientSites)[number] & { type?: string; did?: string; mockups?: { desktop: string; phone: string } };
const shots = import.meta.glob<{ default: ImageMetadata }>("../../content/media/images/bkws/clients/*.png", { eager: true });
const img = (p: string) => shots[`../../content/media/${p}`]?.default;
const clients = (site.clientSites as Client[])
  .filter((c) => c.mockups && img(c.mockups.desktop) && img(c.mockups.phone))
  .map((c) => ({ ...c, desk: img(c.mockups!.desktop)!, phone: img(c.mockups!.phone)! }));
const W = site.bkWebStudios.work;
---
<section class="clients" data-section="Client sites" aria-labelledby="clients-title">
  <div class="head">
    <p class="kick">Client work</p>
    <h2 id="clients-title">{W.title}</h2>
    <p class="body">{W.body}</p>
  </div>

  <ol class="list">
    {clients.map((c, i) => (
      <li class:list={["row", { flip: i % 2 === 1 }]}>
        <div class="devices">
          <figure class="laptop">
            <div class="lid"><div class="screen"><Image src={c.desk} alt={`Home page of ${c.name} on a laptop`} widths={[640, 960, 1280]} sizes="(max-width: 860px) 88vw, 600px" loading="lazy" /></div></div>
            <div class="base" aria-hidden="true"></div>
          </figure>
          <figure class="phone">
            <div class="screen"><Image src={c.phone} alt={`${c.name} on a phone`} widths={[200, 320]} sizes="(max-width: 860px) 26vw, 150px" loading="lazy" /></div>
          </figure>
        </div>
        <div class="text">
          <p class="type"><span class="n">{String(i + 1).padStart(2, "0")}</span>{c.type}</p>
          <h3>{c.name}</h3>
          <p class="did">{c.did}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .clients {
    --ink: #1d1a18; --dune: #2a2f33; --bone: #f4efe8; --ember: #d57d3b; --teal: #2e6170;
    --pixel: "Silkscreen", ui-monospace, monospace;
    max-width: 1180px; margin: 0 auto; display: grid; gap: clamp(36px, 6vw, 72px);
    padding: clamp(40px, 8vh, 90px) max(24px, env(safe-area-inset-right, 0px)) clamp(72px, 14vh, 140px) max(24px, env(safe-area-inset-left, 0px));
  }
  .head { display: grid; gap: 14px; max-width: 62ch; }
  .kick { margin: 0; font: 400 12px var(--pixel); letter-spacing: 0.06em; text-transform: uppercase; color: var(--teal); }
  h2 { margin: 0; font: 400 clamp(30px, 4.4vw, 56px)/1 var(--pixel); letter-spacing: -0.01em; text-wrap: balance; }
  .body { margin: 0; font: 400 clamp(16px, 1.4vw, 18px)/1.6 var(--font-body); color: color-mix(in srgb, var(--ink) 82%, transparent); }

  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(64px, 10vw, 120px); }
  .row { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); align-items: center; gap: clamp(28px, 5vw, 72px); }
  .row.flip { grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); }
  .row.flip .devices { order: 2; }

  /* the laptop: dark bezel, then a thin base wider than the lid; the phone leans on its corner */
  .devices { position: relative; padding: 0 9% 7% 0; }
  .flip .devices { padding: 0 0 7% 9%; }
  .laptop { margin: 0; }
  .lid { padding: 2.2% 2.2% 3%; border-radius: 16px 16px 4px 4px; background: var(--ink); box-shadow: 6px 6px 0 var(--dune); }
  .laptop .screen { aspect-ratio: 1440 / 900; overflow: hidden; border-radius: 4px; background: var(--dune); }
  .base { height: 12px; margin: 0 -3%; border: 2px solid var(--ink); border-radius: 0 0 14px 14px; background: var(--bone); box-shadow: 6px 6px 0 var(--dune); position: relative; }
  .base::before { content: ""; position: absolute; left: 50%; top: -2px; width: 16%; height: 5px; translate: -50% 0; border-radius: 0 0 6px 6px; background: var(--ink); }
  .phone { position: absolute; right: 0; bottom: 0; width: 24%; margin: 0; padding: 2.2%; border-radius: 20px; background: var(--ink); box-shadow: 5px 5px 0 var(--dune); rotate: 3deg; }
  .flip .phone { right: auto; left: 0; rotate: -3deg; }
  .phone .screen { aspect-ratio: 390 / 844; overflow: hidden; border-radius: 14px; background: var(--dune); }
  .screen :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }

  .text { display: grid; gap: 12px; }
  .type { margin: 0; display: flex; align-items: baseline; gap: 12px; font: 400 12px var(--pixel); letter-spacing: 0.05em; text-transform: uppercase; color: var(--teal); }
  .type .n { font: 500 11px var(--font-mono); color: var(--ember); }
  h3 { margin: 0; font: 600 clamp(24px, 2.6vw, 34px)/1.1 var(--font-body); letter-spacing: -0.01em; text-wrap: balance; }
  .did { margin: 0; max-width: 46ch; font: 400 16px/1.6 var(--font-body); color: color-mix(in srgb, var(--ink) 82%, transparent); }

  @media (max-width: 860px) {
    .row, .row.flip { grid-template-columns: minmax(0, 1fr); }
    .row.flip .devices { order: 0; }
    .flip .devices { padding: 0 9% 7% 0; }
    .flip .phone { left: auto; right: 0; rotate: 3deg; }
  }
</style>
