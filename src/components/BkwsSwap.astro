---
// BK Web Studios: the world swap (step 7.1, approved from https://claude.ai/artifact/HFZg3MvjjM1NkAts5Lo612).
// (data-glass-scene: the page cover waits for its first frame, as it does for GlassHero.)
// You arrive through the CRT with the glass ብሩኽ still with you, over a blurred Seattle. It snaps to a grid of glass
// cubes (left to right), they're thrown out tumbling, and restack into BKWS in Silkscreen, BKWS's own pixel face: four
// glass cubes make one pixel block, and each block turns solid ember with a hard dune shadow (bkwebstudios.com's
// bevelled-OS look) as it lands. The light turns to BKWS paper and scanlines come on. Plays once per arrival (~2.6 s),
// then stops drawing. Reduced motion or no WebGL: the finished blocks, drawn in CSS, fade in.
import "@fontsource/silkscreen/latin-400.css";
import { getImage } from "astro:assets";
import seattle from "@content/media/images/about/seattle.jpg";
import site from "@/lib/site";
import { nameGlyphs } from "@/lib/glyphs";

// "BKWS" in Silkscreen, one character per pixel (read once from the font; Silkscreen caps are 5 pixels tall)
const BKWS = [
  "###...#..#..#...#...###",
  "#..#..#.#...#.#.#..#...",
  "####..##....#.#.#...##.",
  "#..#..#.#...#.#.#.....#",
  "###...#..#...#.#...###.",
];
const photo = await getImage({ src: seattle, width: 120, format: "webp" }); // tiny on purpose: it is only ever seen blurred
const bk = site.bkWebStudios;
---
<section id="bkws-swap" class="swap" data-glass-scene data-section="BK Web Studios" data-photo={photo.src} aria-labelledby="bk-title">
  <script type="application/json" data-glyphs set:html={JSON.stringify({ ...nameGlyphs, bkws: BKWS })}></script>
  <canvas class="gl" aria-hidden="true"></canvas>
  <!-- the same blocks in CSS: shown when the 3D isn't (reduced motion, no WebGL) -->
  <div class="still" aria-hidden="true" style={`--cols:${BKWS[0].length}`}>
    {BKWS.flatMap((row) => [...row]).map((c) => <i class:list={{ on: c === "#" }}></i>)}
  </div>
  <div class="scan" aria-hidden="true"></div>
  <div class="cap">
    <h1 id="bk-title">{bk.name}</h1>
    <p>{bk.tagline}</p>
  </div>
  <a class="cue" href="#studio">Scroll <span aria-hidden="true">▾</span></a>
</section>

<script>
  import * as THREE from "three";
  import { RoomEnvironment } from "three/examples/jsm/environments/RoomEnvironment.js";
  import { RoundedBoxGeometry } from "three/examples/jsm/geometries/RoundedBoxGeometry.js";
  import { glassMaterial, shapes, EO, EIO } from "@/lib/glass";

  type Data = { upm: number; letters: { adv: number; d: (string | number)[] }[]; bkws: string[] };

  // seconds from the start: snap to grid → tumble → restack (staggered left to right) → paper → caption
  const T = { sweep: 0.55, sweepDur: 0.3, burst: 0.85, fly: 1.25, flySpread: 0.4, flyDur: 0.7, paper: 1.7, paperDur: 0.6, caption: 2.35, end: 3 };
  const c01 = (v: number) => Math.min(1, Math.max(0, v));

  function init(root: HTMLElement): () => void {
    const html = document.documentElement;
    const ready = () => { if (!html.dataset.glassReady) { html.dataset.glassReady = "1"; document.dispatchEvent(new CustomEvent("bk:glass-ready")); } };
    // no 3D: the finished blocks in CSS, and the page cover can lift straight away
    const still = () => { root.classList.add("still-on", "done"); ready(); };
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) { still(); return () => {}; }
    const canvas = root.querySelector<HTMLCanvasElement>("canvas.gl")!;
    let r3: THREE.WebGLRenderer;
    try { r3 = new THREE.WebGLRenderer({ canvas, antialias: true, powerPreference: "high-performance" }); } catch { still(); return () => {}; }
    root.classList.add("live");
    const data = JSON.parse(root.querySelector<HTMLScriptElement>("[data-glyphs]")!.textContent!) as Data;
    const coarse = matchMedia("(pointer: coarse)").matches;
    r3.setPixelRatio(Math.min(devicePixelRatio, coarse ? 1.5 : 2));
    r3.toneMapping = THREE.ACESFilmicToneMapping;
    r3.outputColorSpace = THREE.SRGBColorSpace;
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 100);
    const pmrem = new THREE.PMREMGenerator(r3);
    const envTex = pmrem.fromScene(new RoomEnvironment(r3), 0.03).texture;
    scene.environment = envTex;

    /* the light behind the glass: blurred Seattle, turning into BKWS paper */
    const bgMat = new THREE.ShaderMaterial({
      uniforms: { tPhoto: { value: null as THREE.Texture | null }, uHas: { value: 0 }, uMix: { value: 0 }, uAspect: { value: 1 }, uImg: { value: 1.5 } },
      depthWrite: false, toneMapped: false,
      vertexShader: "varying vec2 vUv; void main(){ vUv = uv; gl_Position = projectionMatrix * modelViewMatrix * vec4(position,1.0); }",
      fragmentShader: `varying vec2 vUv; uniform sampler2D tPhoto; uniform float uHas, uMix, uAspect, uImg;
        float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1,311.7)))*43758.5453); }
        void main(){
          vec2 uv = vUv - 0.5; if (uAspect > uImg) uv.y *= uImg / uAspect; else uv.x *= uAspect / uImg; uv += 0.5;
          vec3 c = vec3(0.0);
          for (int i = -3; i <= 3; i++) for (int j = -3; j <= 3; j++) c += texture2D(tPhoto, uv + vec2(float(i), float(j)) * 0.009).rgb;
          c /= 49.0;
          vec3 sky = mix(mix(vec3(0.03,0.09,0.32), vec3(0.16,0.38,0.86), vUv.y), c * vec3(0.75,0.85,1.05), uHas);
          vec3 paper = vec3(0.929,0.906,0.867) * (0.985 + 0.03 * hash(floor(vUv * 900.0)));
          gl_FragColor = vec4(mix(sky, paper, uMix), 1.0);
        }`,
    });
    const bg = new THREE.Mesh(new THREE.PlaneGeometry(1, 1), bgMat); bg.position.z = -8; scene.add(bg);
    let photoTex: THREE.Texture | null = null;
    new THREE.TextureLoader().load(root.dataset.photo ?? "", (tex) => {
      tex.colorSpace = THREE.SRGBColorSpace; photoTex = tex;
      bgMat.uniforms.tPhoto.value = tex; bgMat.uniforms.uHas.value = 1; bgMat.uniforms.uImg.value = tex.image.width / tex.image.height;
      if (!running) draw(clock());
    });

    const glassMat = glassMaterial();

    /* ---------- the glass ብሩኽ (same proportions as GlassHero) ---------- */
    const SIZE = 2.2, k = SIZE / data.upm, TRACK = 0.1 * data.upm;
    const bounds = (d: (string | number)[]) => {
      let a = Infinity, b = -Infinity, c = Infinity, e = -Infinity;
      for (let i = 0; i < d.length;) {
        const t = d[i++]; const n = t === "M" || t === "L" ? 1 : t === "Q" ? 2 : t === "C" ? 3 : 0;
        for (let j = 0; j < n; j++) { const x = d[i++] as number, y = d[i++] as number; a = Math.min(a, x); b = Math.max(b, x); c = Math.min(c, y); e = Math.max(e, y); }
      }
      return { a, b, c, e };
    };
    let pen = 0;
    const L = data.letters.map((l) => { const o = { ...l, pen, bb: bounds(l.d) }; pen += l.adv + TRACK; return o; });
    const minX = Math.min(...L.map((l) => l.pen + l.bb.a)), maxX = Math.max(...L.map((l) => l.pen + l.bb.b));
    const minY = Math.min(...L.map((l) => l.bb.c)), maxY = Math.max(...L.map((l) => l.bb.e));
    const cxF = (minX + maxX) / 2, cyF = (minY + maxY) / 2;
    const nameW = (maxX - minX) * k, nameH = (maxY - minY) * k;
    const DEPTH = SIZE * 0.22;
    const name = new THREE.Group(); scene.add(name);
    const letters = L.map((l) => {
      const geo = new THREE.ExtrudeGeometry(shapes(l.d, k), { depth: DEPTH, curveSegments: coarse ? 10 : 16, bevelEnabled: true, bevelThickness: SIZE * 0.035, bevelSize: SIZE * 0.022, bevelSegments: coarse ? 4 : 6 });
      const m = new THREE.Mesh(geo, glassMat); m.position.set((l.pen - cxF) * k, cyF * k, -DEPTH / 2);
      m.userData.cx = (l.pen + (l.bb.a + l.bb.b) / 2 - cxF) * k; name.add(m); return m;
    });

    /* ---------- sizes: one BKWS block = 2 × 2 glass cubes ---------- */
    const cols = data.bkws[0].length, rows = data.bkws.length;
    const block = Math.max(nameW * 1.05, 6.4) / cols, cube = block / 2;
    const bkW = cols * block, bkH = rows * block;

    // the name on the cube grid
    const vox: THREE.Vector3[] = [];
    {
      const s = 0.12, pad = 4, c = document.createElement("canvas");
      c.width = Math.ceil((maxX - minX) * s) + pad * 2; c.height = Math.ceil((maxY - minY) * s) + pad * 2;
      const g = c.getContext("2d", { willReadFrequently: true })!;
      for (const l of L) {
        g.setTransform(s, 0, 0, s, pad + (l.pen - minX) * s, pad - minY * s);
        const p = new Path2D(), d = l.d as number[]; let i = 0;
        while (i < d.length) {
          const t = d[i++] as unknown as string;
          if (t === "M") p.moveTo(d[i++], d[i++]); else if (t === "L") p.lineTo(d[i++], d[i++]);
          else if (t === "Q") p.quadraticCurveTo(d[i++], d[i++], d[i++], d[i++]);
          else if (t === "C") p.bezierCurveTo(d[i++], d[i++], d[i++], d[i++], d[i++], d[i++]); else p.closePath();
        }
        g.fill(p);
      }
      const px = g.getImageData(0, 0, c.width, c.height).data, cellF = cube / k;
      const nx = Math.ceil((maxX - minX) / cellF), ny = Math.ceil((maxY - minY) / cellF);
      const ox = cxF - (nx * cellF) / 2, oy = cyF - (ny * cellF) / 2;
      for (let j = 0; j < ny; j++) for (let i = 0; i < nx; i++) {
        let hit = 0;
        for (let a = 0; a < 3; a++) for (let b = 0; b < 3; b++) {
          const x = Math.floor(pad + (ox + (i + (a + 0.5) / 3) * cellF - minX) * s), y = Math.floor(pad + (oy + (j + (b + 0.5) / 3) * cellF - minY) * s);
          if (x >= 0 && y >= 0 && x < c.width && y < c.height && px[(y * c.width + x) * 4 + 3] > 127) hit++;
        }
        if (hit >= 4) vox.push(new THREE.Vector3((ox + (i + 0.5) * cellF - cxF) * k, -(oy + (j + 0.5) * cellF - cyF) * k, 0));
      }
    }

    // BKWS blocks and their 4 sub-slots each; cubes (sorted by x) spread evenly over the slots (sorted by x)
    const blocks: { q: number; pos: THREE.Vector3; land: number }[] = [];
    data.bkws.forEach((row, r) => [...row].forEach((ch, q) => {
      if (ch === "#") blocks.push({ q, pos: new THREE.Vector3((q + 0.5) * block - bkW / 2, bkH / 2 - (r + 0.5) * block, 0), land: 0 });
    }));
    const slots: { bi: number; pos: THREE.Vector3 }[] = [];
    blocks.forEach((b, bi) => { for (const [sx, sy] of [[-1, 1], [1, 1], [-1, -1], [1, -1]]) slots.push({ bi, pos: b.pos.clone().add(new THREE.Vector3((sx * cube) / 2, (sy * cube) / 2, 0)) }); });
    slots.sort((a, b) => a.pos.x - b.pos.x || b.pos.y - a.pos.y);
    vox.sort((a, b) => a.x - b.x || b.y - a.y);
    const N = vox.length, M = slots.length, used = new Set<number>();
    const pieces = vox.map((home, i) => {
      let si = N <= M ? Math.round((i * (M - 1)) / Math.max(1, N - 1)) : Math.floor((i * M) / N);
      if (used.has(si)) si = -1; else used.add(si); // more cubes than slots: the extras fall away
      const slot = si >= 0 ? slots[si] : null;
      return { home, slot, delay: slot ? T.fly + (blocks[slot.bi].q / cols) * T.flySpread + Math.random() * 0.06 : 0,
        pos: home.clone(), vel: new THREE.Vector3(), q: new THREE.Quaternion(), w: new THREE.Vector3(), from: null as THREE.Vector3 | null, fromQ: new THREE.Quaternion() };
    });
    blocks.forEach((b, bi) => {
      b.land = Math.max(T.fly + (b.q / cols) * T.flySpread + T.flyDur, ...pieces.filter((p) => p.slot?.bi === bi).map((p) => p.delay + T.flyDur));
    });

    const cubeGeo = new RoundedBoxGeometry(cube * 0.94, cube * 0.94, cube * 0.94, 3, cube * 0.14);
    const glassCubes = new THREE.InstancedMesh(cubeGeo, glassMat, N);
    glassCubes.instanceMatrix.setUsage(THREE.DynamicDrawUsage); scene.add(glassCubes);
    // pixel blocks: lit from the top left, darker right and bottom (BKWS's bevelled edges); hard dune shadow behind
    const face = (v: number) => new THREE.MeshBasicMaterial({ color: new THREE.Color(v, v, v), toneMapped: false });
    const blockMats = [face(0.78), face(1.15), face(1.22), face(0.6), face(1), face(0.5)]; // +x −x +y −y +z −z
    const solid = new THREE.InstancedMesh(new THREE.BoxGeometry(block * 0.96, block * 0.96, block * 0.6), blockMats, blocks.length);
    const ember = new THREE.Color("#d57d3b"), emberHi = new THREE.Color("#e8955a");
    blocks.forEach((b, i) => solid.setColorAt(i, (b.q + Math.round(b.pos.y / block)) % 7 === 0 ? emberHi : ember));
    const shadowMat = new THREE.MeshBasicMaterial({ color: new THREE.Color("#2a2f33"), toneMapped: false });
    const shadow = new THREE.InstancedMesh(new THREE.PlaneGeometry(block * 0.96, block * 0.96), shadowMat, blocks.length);
    scene.add(shadow, solid);

    function resize() {
      const w = root.clientWidth, h = root.clientHeight; r3.setSize(w, h, false); camera.aspect = w / h;
      const t = Math.tan(THREE.MathUtils.degToRad(camera.fov / 2));
      const fitW = Math.max(bkW, nameW) / (w < 600 ? 0.86 : 0.62), fitH = Math.max(bkH, nameH) / 0.42;
      camera.position.set(0, -0.15 * nameH, Math.max(fitW / (2 * t * camera.aspect), fitH / (2 * t)));
      camera.updateProjectionMatrix();
      const vh = 2 * t * (camera.position.z - bg.position.z); bg.scale.set(vh * camera.aspect * 1.1, vh * 1.1, 1);
      bgMat.uniforms.uAspect.value = camera.aspect;
      if (!running) draw(clock());
    }

    /* ---------- the timeline ---------- */
    const m4 = new THREE.Matrix4(), one = new THREE.Vector3(1, 1, 1), qI = new THREE.Quaternion(), v = new THREE.Vector3(), dq = new THREE.Quaternion();
    const hide = new THREE.Matrix4().makeScale(1e-4, 1e-4, 1e-4);
    for (const p of pieces) {
      p.vel.set(p.home.x * 1.1 * (1.6 + Math.random() * 1.6), 2.2 + p.home.y * 1.4 + Math.random() * 1.6, 1.5 + Math.random() * 2.5);
      p.w.set(Math.random() * 2 - 1, Math.random() * 2 - 1, Math.random() * 2 - 1).normalize().multiplyScalar(4 + Math.random() * 6);
    }
    let started = -1, last = 0, running = true, raf = 0, prev = 0;
    const clock = () => (started < 0 ? 0 : (performance.now() - started) / 1000);

    function draw(t: number) {
      const dt = Math.min(0.05, Math.max(0, t - last)); last = t;
      name.position.y = t < T.sweep ? Math.sin(performance.now() / 1000 * 1.6) * 0.04 : 0;
      // 1. snap to the grid, left to right
      const sweepX = -nameW / 2 - 0.4 + c01((t - T.sweep) / T.sweepDur) * (nameW + 0.8);
      letters.forEach((m) => (m.visible = t < T.sweep || m.userData.cx > sweepX));
      pieces.forEach((p, i) => {
        let s = t >= T.sweep && p.home.x < sweepX ? EO(c01((sweepX - p.home.x) / 0.5)) : 0;
        if (t >= T.burst && (!p.slot || t < p.delay)) { // 2. thrown out, spinning, falling
          p.vel.y -= 9.5 * dt; p.pos.addScaledVector(p.vel, dt);
          p.q.premultiply(dq.setFromAxisAngle(v.copy(p.w).normalize(), p.w.length() * dt));
        }
        if (p.slot && t >= p.delay) { // 3. restack into its slot, squaring up
          if (!p.from) { p.from = p.pos.clone(); p.fromQ.copy(p.q); }
          const e = EIO(c01((t - p.delay) / T.flyDur));
          p.pos.lerpVectors(p.from, p.slot.pos, e); p.pos.z += Math.sin(Math.PI * e) * 1.2;
          p.q.slerpQuaternions(p.fromQ, qI, e);
        }
        if ((p.slot && t >= blocks[p.slot.bi].land) || (!p.slot && p.pos.y < -12)) s = 0;
        if (s <= 0) glassCubes.setMatrixAt(i, hide); else glassCubes.setMatrixAt(i, m4.compose(p.pos, p.q, v.setScalar(s)));
      });
      // 4. a block turns solid when its cubes are home: a short squash, then its hard shadow slides out
      blocks.forEach((b, i) => {
        const u = (t - b.land) / 0.16;
        if (u < 0) { solid.setMatrixAt(i, hide); shadow.setMatrixAt(i, hide); return; }
        const sq = u < 1 ? Math.sin(Math.PI * u) * 0.12 : 0;
        solid.setMatrixAt(i, m4.compose(b.pos, qI, v.set(1 + sq, 1 - sq, 1)));
        const off = block * 0.16 * EO(c01(u));
        shadow.setMatrixAt(i, m4.compose(v.set(b.pos.x + off, b.pos.y - off, -block * 0.32), qI, one));
      });
      glassCubes.instanceMatrix.needsUpdate = solid.instanceMatrix.needsUpdate = shadow.instanceMatrix.needsUpdate = true;
      // 5. the world swaps: the light turns to paper, scanlines, then the name underneath
      bgMat.uniforms.uMix.value = EIO(c01((t - T.paper) / T.paperDur));
      root.classList.toggle("paper", t > T.paper + T.paperDur * 0.6);
      root.classList.toggle("done", t > T.caption);
      r3.render(scene, camera);
    }

    function loop() {
      // a stall (a shader compile, a tab switch) pauses the clock instead of skipping part of the swap;
      // ordinary slow frames still run in real time
      const now = performance.now(); if (prev && started >= 0 && now - prev > 250) started += now - prev - 33; prev = now;
      const t = clock(); draw(t);
      ready();
      if (t > T.end) { running = false; return; } // settled: stop drawing until something changes
      raf = requestAnimationFrame(loop);
    }

    // start once the CRT has opened onto the page (or shortly after a direct load)
    let startT = 0;
    const go = (delay: number) => { if (started < 0 && !startT) startT = window.setTimeout(() => { started = performance.now(); }, delay); };
    const mo = new MutationObserver(() => { if (html.classList.contains("surfacing")) go(350); });
    if (html.classList.contains("surfacing")) go(350);
    else if (html.dataset.arriving) mo.observe(html, { attributes: true, attributeFilter: ["class"] });
    else go(600);

    const ro = new ResizeObserver(resize); ro.observe(root); resize();
    r3.compile(scene, camera); // every material now, so the first block landing doesn't stall
    raf = requestAnimationFrame(loop);

    return () => {
      cancelAnimationFrame(raf); clearTimeout(startT); mo.disconnect(); ro.disconnect();
      letters.forEach((m) => m.geometry.dispose());
      cubeGeo.dispose(); solid.geometry.dispose(); shadow.geometry.dispose(); bg.geometry.dispose();
      [glassMat, shadowMat, bgMat, ...blockMats].forEach((m) => m.dispose());
      glassCubes.dispose(); solid.dispose(); shadow.dispose(); photoTex?.dispose(); envTex.dispose(); pmrem.dispose(); r3.dispose();
    };
  }

  let teardown: (() => void) | null = null;
  document.addEventListener("astro:page-load", () => {
    const root = document.getElementById("bkws-swap");
    if (root) teardown = init(root);
  });
  document.addEventListener("astro:before-swap", () => { teardown?.(); teardown = null; });
</script>

<style>
  .swap {
    position: relative; height: 84svh; min-height: 520px; overflow: hidden;
    background: #ede7dd; color: #1d1a18;
  }
  /* the header reads light over the photo, then BKWS ink once the paper comes in */
  :global(html:has(#bkws-swap.live:not(.paper)):not(.menu-open)) :global(.hdr:not(.scrolled)) { color: #f7f3ea; }
  .gl { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .scan {
    position: absolute; inset: 0; pointer-events: none; opacity: 0;
    background: repeating-linear-gradient(to bottom, rgb(29 26 24 / 0.07) 0 1px, transparent 1px 3px);
    -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent); mask-image: linear-gradient(to bottom, #000 70%, transparent); /* fades into the page, no seam */
    transition: opacity 500ms var(--ease-out);
  }
  .paper .scan, .still-on .scan { opacity: 1; }

  .cap {
    position: absolute; left: 0; right: 0; top: 64%; display: grid; justify-items: center; gap: 10px; text-align: center;
    padding: 0 max(24px, env(safe-area-inset-right, 0px)) 0 max(24px, env(safe-area-inset-left, 0px));
  }
  .cap h1 { margin: 0; font: 400 clamp(20px, 2.6vw, 30px)/1.1 "Silkscreen", ui-monospace, monospace; letter-spacing: 0.02em; }
  .cap p { margin: 0; font: 400 13px/1.4 var(--font-mono); color: #2a2f33; }
  /* the caption waits for the swap when the 3D runs; otherwise it's simply there */
  .live .cap { opacity: 0; translate: 0 10px; transition: opacity 400ms var(--ease-out), translate 500ms var(--ease-out); }
  .live.done .cap { opacity: 1; translate: 0 0; }

  /* "there's more": a pixel cue at the bottom once the swap has settled (the next section also peeks in below) */
  .cue {
    position: absolute; left: 50%; bottom: 22px; translate: -50% 0; display: inline-flex; gap: 8px; align-items: center;
    padding: 8px 12px; color: #1d1a18; text-decoration: none; font: 400 12px "Silkscreen", ui-monospace, monospace; letter-spacing: 0.08em; text-transform: uppercase;
  }
  .cue span { animation: cue-blink 1.2s steps(2, jump-none) infinite; }
  @keyframes cue-blink { 50% { opacity: 0; } }
  .live .cue { opacity: 0; transition: opacity 400ms var(--ease-out) 300ms; }
  .live.done .cue { opacity: 1; }
  .cue:focus-visible { outline: 2px solid #2e6170; outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .cue span { animation: none; } }

  /* the finished wordmark in CSS, for reduced motion and no WebGL */
  .still {
    display: none; position: absolute; left: 50%; top: 44%; translate: -50% -50%;
    width: min(62vw, 760px); grid-template-columns: repeat(var(--cols), 1fr); gap: 0;
  }
  .still i { aspect-ratio: 1; }
  .still i.on { background: #d57d3b; box-shadow: 0.35vw 0.35vw 0 #2a2f33; margin: 2%; }
  .still-on .still { display: grid; animation: still-in 200ms ease both; }
  @keyframes still-in { from { opacity: 0; } }
  @media (max-width: 600px) { .still { width: 86vw; } }
</style>
