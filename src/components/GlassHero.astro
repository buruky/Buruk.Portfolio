---
// Home hero (approved 2026-11-25): ብሩኽ as three pieces of glass over Harnet Avenue, Asmara.
// First visit: the glass waits with "This is my portfolio, and I'm ብሩኽ" and the Enter buttons; entering cycles each letter
// through its vowel forms until it locks, the glass shrinks to sit over BURUK, YIMESGEN slides out, and the Latin name flies
// into the header logo while the photo comes up and the letters rise into the hero (layout "C · Lockup").
// Samples: intro https://claude.ai/artifact/MQ9CURwH2sanqiL37P4azM · layout https://claude.ai/artifact/7D8tUuMh5kZeFqXSEXoQUU
//
// The letter outlines come from src/lib/glyphs.ts (read from Abyssinica SIL at build time).
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import me from "@content/media/images/profile.jpg";
import portrait from "@content/media/images/profile2.jpg";
import place from "@content/media/images/about/seattle.jpg";
import asmara from "@content/media/images/about/asmara-harnet-avenue.jpg";
import { glyphs } from "@/lib/glyphs";

/* Two modes. "home": the full intro (gate, vowel cycle, name flight) and the "I build" lockup.
   "page": the same glass, photo and water for any other page (see src/layouts/WorldPage.astro), without the intro;
   the page puts its own words in the default slot, and the glass rests in the hero's spot. */
interface Props {
  mode?: "home" | "page";
  photo?: ImageMetadata;
  /** the photo's colour once you've scrolled past the hero (linear RGB, 0–1): the world's tint */
  deep?: [number, number, number];
  /** the label for the header's "where you are" corner */
  section?: string;
  /** how soft the photo is: 0 (the usual dreamy blur) to 1 (nearly sharp, for a photo that is the point, like Contact's) */
  soft?: number;
}
const { mode = "home", photo: photoSrc = asmara, deep = [0.16, 0.3, 0.2], section = "Home", soft = 0 } = Astro.props;
const isHome = mode === "home";
const photo = await getImage({ src: photoSrc, width: soft > 0.5 ? 2400 : 1600, format: "webp", quality: soft > 0.5 ? 80 : 72 });
const keepsakePhotos = {
  me: (await getImage({ src: me, width: 700, format: "webp", quality: 82 })).src,
  portrait: (await getImage({ src: portrait, width: 600, format: "webp", quality: 82 })).src,
  place: (await getImage({ src: place, width: 800, format: "webp", quality: 82 })).src,
};

const TOPICS = [
  { label: "Salesforce", fill: "Salesforce apps.", href: "/work/ecc-salesforce-case-management" },
  { label: "Full stack", fill: "full-stack products.", href: "/work/fabriq" },
  { label: "Research", fill: "research with data.", href: "/research" },
  { label: "BK Web Studios", fill: "websites for small businesses.", href: "/bk-web-studios" },
];
---
{isHome && <script is:inline>
  // Before first paint: on the first visit this session, hold the page for the intro.
  try {
    // ?intro in the address (or "Replay intro" in the footer) plays it again without opening a new tab
    if (new URLSearchParams(location.search).has("intro")) sessionStorage.removeItem("bk-entered");
    if (!sessionStorage.getItem("bk-entered")) document.documentElement.classList.add("intro-active", "intro-logo-hidden");
  } catch (e) {}
</script>}

<section class:list={["gh", { page: !isHome }]} id="glass-hero" data-glass-scene data-section={section} data-photo={photo.src} data-photos={isHome ? JSON.stringify(keepsakePhotos) : undefined} data-deep={deep.join(",")} data-soft={soft} aria-labelledby="gh-title">
  <canvas class="gl" data-gl aria-hidden="true"></canvas>
  <div class="shade" aria-hidden="true"></div>
  <div class="grain" aria-hidden="true"></div>
  <script type="application/json" data-glyphs set:html={JSON.stringify(glyphs)}></script>

  <!-- the gate (first visit only) -->
  <p class="hello" data-hello aria-hidden="true">This is my portfolio, and I&rsquo;m</p>
  <div class="gate" data-gate hidden>
    <button type="button" class="primary" data-enter="sound">Enter with sound</button>
    <button type="button" data-enter="quiet">Enter quietly</button>
  </div>
  <div class="syls" data-syls aria-hidden="true"></div>
  <p class="ks-hint" data-ks-hint aria-hidden="true">Pick them up.</p>
  <p class="sr-only">Photos of me float in the water around the name.</p>
  <button type="button" class="skip" data-skip hidden>Skip intro <span class="skip-arrow" aria-hidden="true">→</span></button>

  <!-- the hero: layout C, the glass name in the slot, "I build" big beneath it -->
  <div class="stage ui">
    <div class="slot" data-slot aria-hidden="true">
      <span class="fallback" lang="ti">ብሩኽ</span>
    </div>
    {isHome ? (
    <div class="copy" data-build>
        <h1 id="gh-title" class="sentence">
          <span class="sr-only">Buruk Yimesgen. </span>
          <span class="lead" data-arrive="stretch">I build<span class="caret" aria-hidden="true"></span></span>
          <span class="fill" aria-live="polite"><a class="word" data-word href="/work" hidden></a></span>
          <span class="sr-only">Salesforce apps, full-stack products, research with data, and websites for small businesses.</span>
        </h1>
        <div class="topics" role="group" aria-label="What I build" data-topics>
          {TOPICS.map((t) => <button type="button" aria-pressed="false" data-fill-text={t.fill} data-href={t.href}>{t.label}</button>)}
        </div>
        <p class="about"><b><span lang="ti">ብሩኽ</span> is my name, Buruk, in Ge&rsquo;ez script.</b> CS &amp; Math, University of Washington.</p>
      </div>
    ) : (
      <div class="copy" data-build><slot /></div>
    )}
  </div>
  <p class="hint ui" data-hint aria-hidden="true">Grab a letter and flick it</p>
</section>

<script>
  import * as THREE from "three";
  import { RoomEnvironment } from "three/examples/jsm/environments/RoomEnvironment.js";
  import { navigate } from "astro:transitions/client";
  import { play, unlock, setSound } from "@/lib/sound";
  import { createKeepsakes, type KeepsakeVariant } from "@/lib/keepsakes";
  import { glassMaterial, shapes, EO, EIO } from "@/lib/glass";

  type GlyphData = { upm: number; families: { t: number; lat: string; forms: { adv: number; d: (string | number)[] }[] }[] };
  type Letter = {
    pivot: THREE.Group; mesh: THREE.Mesh; geos: THREE.BufferGeometry[]; t: number; form: number; homeX: number;
    angle: number; vel: number; mode: "idle" | "cycle" | "lock"; bump: number; flash: number; lastTick: number;
    fy: number; fvy: number; hit: Set<number>; // floating on the water: offset, speed, ripples already felt
    mat: THREE.MeshPhysicalMaterial; glint: number; // its own glass (tinted with its flag colour at the gate), and a passing glint
  };

  const SIZE = 2.2;            // world height of a letter before fitting
  const DIM = 0.08;            // how much of the photo glows through during the intro
  const ANN = 0.4;             // how small the letters get when they sit over BURUK

  function init(root: HTMLElement) {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;
    const html = document.documentElement;
    const firstVisit = html.classList.contains("intro-active");
    const ac = new AbortController();
    const on = { signal: ac.signal } as const;
    const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
    const canvas = $<HTMLCanvasElement>("[data-gl]");

    /* ---------------- "I build ___" ---------------- */
    // (page mode has no "I build" line: word and topics are missing, and everything below becomes a no-op)
    const build = $<HTMLElement>("[data-build]"), word = root.querySelector<HTMLAnchorElement>("[data-word]"), topics = root.querySelector<HTMLElement>("[data-topics]");
    const btns = topics ? Array.from(topics.querySelectorAll<HTMLButtonElement>("button")) : [];
    const POOL = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
    let iv = 0, idx = -1, locked = false, cycle = 0, startT = 0;
    function fill(text: string, href: string) {
      if (!word) return;
      window.clearInterval(iv); word.hidden = false; word.href = href; build.classList.add("filled");
      if (reduce) { word.textContent = text; return; }
      let n = 0; const ticks = 12;
      iv = window.setInterval(() => {
        n++; let out = "";
        for (let k = 0; k < text.length; k++) { const ch = text[k]; out += ch === " " || ch === "." || ch === "-" || n > (k / text.length) * ticks ? ch : POOL[(Math.random() * POOL.length) | 0]; }
        word!.textContent = out; if (n >= ticks) { window.clearInterval(iv); word!.textContent = text; }
      }, 30);
    }
    function select(i: number, auto: boolean) {
      if (!topics || !btns[i]) return;
      idx = i;
      btns.forEach((b, j) => b.setAttribute("aria-pressed", String(i === j)));
      topics.classList.remove("auto"); void topics.offsetWidth; if (auto && !locked) topics.classList.add("auto");
      fill(btns[i].dataset.fillText ?? "", btns[i].dataset.href ?? "/work");
    }
    function stopCycle() { window.clearTimeout(startT); window.clearInterval(cycle); }
    function startCycle(delay: number) {
      stopCycle(); if (locked || !btns.length) return;
      if (reduce) { if (idx < 0) select(0, true); return; }
      startT = window.setTimeout(() => { select((idx + 1) % btns.length, true); cycle = window.setInterval(() => { if (!document.hidden) select((idx + 1) % btns.length, true); }, 4500); }, delay);
    }
    btns.forEach((b, i) => {
      // hover (or focus) shows the words; a click goes to that part of the site
      b.addEventListener("click", () => { locked = true; stopCycle(); topics?.classList.remove("auto"); select(i, false); void navigate(b.dataset.href ?? "/work"); }, on);
      b.addEventListener("focus", () => { if (locked) return; stopCycle(); topics?.classList.remove("auto"); if (idx !== i) select(i, false); }, on);
      b.addEventListener("pointerenter", () => { if (locked || !fine) return; stopCycle(); topics?.classList.remove("auto"); if (idx !== i) select(i, false); }, on);
    });
    topics?.addEventListener("pointerleave", () => { if (!locked && fine) startCycle(4500); }, on);
    ac.signal.addEventListener("abort", stopCycle);

    /* ---------------- 3D ---------------- */
    let renderer: THREE.WebGLRenderer | null = null;
    // Antialiasing stays on: once the resolution steps down, the glass edges go jagged without it (and it's cheap on phone GPUs).
    try { renderer = new THREE.WebGLRenderer({ canvas, antialias: true, powerPreference: "high-performance" }); } catch { renderer = null; }
    if (!renderer) {
      // No WebGL: show the name as type, skip the intro.
      root.classList.add("no-gl");
      finishIntro(false);
      return () => ac.abort();
    }
    const r3 = renderer;
    /* Quality steps: the render resolution drops a step whenever the device can't hold ~45 fps, and never climbs back
       mid-visit (so the picture doesn't flicker between levels). Phones start a step down. The step is kept for the
       session, so the next visit to Home starts where this one settled. Add ?fps to the URL to see it working. */
    const TIERS = [2, 1.5, 1.25, 1]; // never below 1×: under that the glass edges break up
    const coarse = matchMedia("(pointer: coarse)").matches;
    let tier = Math.max(coarse ? 1 : 0, Number(sessionStorage.getItem("bk-gl-tier")) || 0);
    while (tier < TIERS.length - 1 && TIERS[tier] > devicePixelRatio + 0.01 && TIERS[tier + 1] >= Math.min(1, devicePixelRatio)) tier++; // no point rendering sharper than the screen
    const applyTier = () => { r3.setPixelRatio(Math.min(devicePixelRatio, TIERS[tier])); try { sessionStorage.setItem("bk-gl-tier", String(tier)); } catch {} };
    applyTier();
    const frames: number[] = [];
    let settleUntil = performance.now() + 2500; // ignore the first moments (shader compiles, photo decode)
    function watchSpeed(rawDt: number) {
      const now = performance.now();
      if (now < settleUntil || document.hidden || rawDt > 0.25) return; // a tab switch or a hitch isn't the device being slow
      frames.push(rawDt);
      if (frames.length < 90) return;
      const median = frames.sort((a, b) => a - b)[45];
      frames.length = 0;
      if (median > 1 / 45 && tier < TIERS.length - 1) { tier++; applyTier(); layout(); settleUntil = now + 1500; }
    }
    const fpsEl = new URLSearchParams(location.search).has("fps") ? document.createElement("output") : null;
    if (fpsEl) {
      fpsEl.className = "fps";
      fpsEl.style.cssText = "position:fixed;left:10px;bottom:10px;z-index:9999;padding:6px 9px;border-radius:8px;background:rgb(0 0 0 / .7);color:#cfc;font:11px/1.3 ui-monospace,monospace;pointer-events:none;white-space:pre";
      document.body.append(fpsEl); ac.signal.addEventListener("abort", () => fpsEl.remove());
    }
    let fpsN = 0, fpsT = 0;
    function showFps(rawDt: number) {
      if (!fpsEl) return;
      fpsN++; fpsT += rawDt;
      if (fpsT < 0.5) return;
      fpsEl.textContent = `${Math.round(fpsN / fpsT)} fps\nres ${r3.getPixelRatio().toFixed(2)}× · step ${tier + 1}/${TIERS.length}`;
      fpsN = 0; fpsT = 0;
    }
    r3.outputColorSpace = THREE.SRGBColorSpace;
    r3.toneMapping = THREE.ACESFilmicToneMapping;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x000000);
    const pmrem = new THREE.PMREMGenerator(r3);
    const envTex = pmrem.fromScene(new RoomEnvironment(r3), 0.03).texture;
    scene.environment = envTex;
    const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 100);
    camera.position.set(0, 0, 9);
    const key = new THREE.DirectionalLight(0xfff0dc, 3.2); key.position.set(3, 4, 6); scene.add(key);
    const fillLight = new THREE.DirectionalLight(0xbcd0ff, 0.8); fillLight.position.set(-5, -1, 3); scene.add(fillLight);

    // the photo, softened and a little darker, far behind the glass. Fades are by brightness: glass only bends solid things.
    const BG_Z = -7;

    // The photo is also a pond (approved sample: https://claude.ai/artifact/Rq9qo8BmQdsnvoxb5koQph). A height field is
    // simulated on the GPU in two textures that take turns; clicks drop ripples into it, the pointer draws a thin wake,
    // and the photo is drawn bent by the slopes. Because the glass is in the same scene, it bends the ripples again.
    const SIM_W = 512, MAX_DROPS = 8, SPEED = Math.SQRT1_2; // texels a ring travels per step (wave equation, c² = ½)
    let SIM_H = 320, simStep = 0;
    const rtOpts = { type: THREE.HalfFloatType, minFilter: THREE.LinearFilter, magFilter: THREE.LinearFilter, depthBuffer: false };
    let rtA = new THREE.WebGLRenderTarget(SIM_W, SIM_H, rtOpts), rtB = new THREE.WebGLRenderTarget(SIM_W, SIM_H, rtOpts);
    const simMat = new THREE.ShaderMaterial({
      uniforms: {
        tPrev: { value: null as THREE.Texture | null }, texel: { value: new THREE.Vector2(1 / SIM_W, 1 / SIM_H) }, damping: { value: 0.986 }, aspect: { value: 1.6 },
        drops: { value: Array.from({ length: MAX_DROPS }, () => new THREE.Vector4()) }, segA: { value: new THREE.Vector4() }, segB: { value: new THREE.Vector2() },
      },
      vertexShader: "varying vec2 vUv; void main(){ vUv = uv; gl_Position = vec4(position.xy, 0.0, 1.0); }",
      fragmentShader: `
        precision highp float; varying vec2 vUv;
        uniform sampler2D tPrev; uniform vec2 texel; uniform float damping; uniform float aspect; uniform vec4 drops[${MAX_DROPS}];
        uniform vec4 segA; uniform vec2 segB; // wake: line from segA.xy to segA.zw, strength segB.x, width segB.y
        void main(){
          vec4 c = texture2D(tPrev, vUv);
          float n = texture2D(tPrev, vUv + vec2(texel.x, 0.0)).r + texture2D(tPrev, vUv - vec2(texel.x, 0.0)).r
                  + texture2D(tPrev, vUv + vec2(0.0, texel.y)).r + texture2D(tPrev, vUv - vec2(0.0, texel.y)).r;
          float h = (n * 0.5 - c.g) * damping;
          for (int i = 0; i < ${MAX_DROPS}; i++) {
            vec4 d = drops[i];
            if (d.z != 0.0) { vec2 q = (vUv - d.xy) * vec2(aspect, 1.0); h += d.z * exp(-dot(q, q) / (d.w * d.w)); }
          }
          if (segB.x != 0.0) {
            vec2 a = segA.xy * vec2(aspect, 1.0), b = segA.zw * vec2(aspect, 1.0), q = vUv * vec2(aspect, 1.0);
            vec2 ab = b - a; float k = clamp(dot(q - a, ab) / max(dot(ab, ab), 1e-8), 0.0, 1.0);
            vec2 e = q - (a + ab * k); h += segB.x * exp(-dot(e, e) / (segB.y * segB.y));
          }
          gl_FragColor = vec4(h, c.r, 0.0, 1.0);
        }`,
    });
    const simScene = new THREE.Scene(), simCam = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
    simScene.add(new THREE.Mesh(new THREE.PlaneGeometry(2, 2), simMat));
    let pending: { u: number; v: number; s: number; r: number }[] = [];
    let wakeFrom: THREE.Vector2 | null = null, wakeTo: THREE.Vector2 | null = null;
    function stepSim() {
      const ds = simMat.uniforms.drops.value as THREE.Vector4[];
      for (let i = 0; i < MAX_DROPS; i++) { const d = pending[i]; if (d) ds[i].set(d.u, d.v, d.s, d.r); else ds[i].set(0, 0, 0, 0); }
      pending = pending.slice(MAX_DROPS);
      if (wakeFrom && wakeTo && wakeFrom.distanceTo(wakeTo) > 0.0006) { // only while the pointer moves
        (simMat.uniforms.segA.value as THREE.Vector4).set(wakeFrom.x, wakeFrom.y, wakeTo.x, wakeTo.y);
        (simMat.uniforms.segB.value as THREE.Vector2).set(0.035, 0.0018);
        wakeFrom = wakeTo.clone();
      } else (simMat.uniforms.segB.value as THREE.Vector2).set(0, 0);
      simMat.uniforms.tPrev.value = rtA.texture;
      r3.setRenderTarget(rtB); r3.render(simScene, simCam); r3.setRenderTarget(null);
      [rtA, rtB] = [rtB, rtA]; simStep++;
    }
    const bgMat = new THREE.ShaderMaterial({
      uniforms: { tPhoto: { value: null as THREE.Texture | null }, tHeight: { value: rtA.texture }, texel: { value: new THREE.Vector2(1 / SIM_W, 1 / SIM_H) }, tint: { value: new THREE.Color(0, 0, 0) },
        // The flag's colours as light through the glass: each letter casts a pool of light on the water (ብ green, ሩ red, ኽ blue).
        // soft pools of the flag's colours behind the letters at the gate (ብ green, ሩ red, ኽ blue): uv.x, uv.y, radius
        lightPos: { value: [new THREE.Vector3(), new THREE.Vector3(), new THREE.Vector3()] },
        lightCol: { value: [new THREE.Color(0x12ad2b), new THREE.Color(0xea0437).multiplyScalar(1.3), new THREE.Color(0x4189dd)] },
        lightAmt: { value: 0 }, time: { value: 0 }, aspect: { value: 1.6 },
        tObjects: { value: null as THREE.Texture | null }, objAmt: { value: 0 } },
      vertexShader: "varying vec2 vUv; void main(){ vUv = uv; gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }",
      fragmentShader: `
        precision highp float; varying vec2 vUv;
        uniform sampler2D tPhoto; uniform sampler2D tHeight; uniform vec2 texel; uniform vec3 tint;
        uniform vec3 lightPos[3]; uniform vec3 lightCol[3]; uniform float lightAmt; uniform float time; uniform float aspect;
        uniform sampler2D tObjects; uniform float objAmt; // the gate's keepsakes, floating just under the surface
        // a cheap caustic net: bright, thin, slowly moving lines like light at the bottom of a pool
        float caustic(vec2 p) {
          float c = 0.0; vec2 q = p;
          for (int i = 0; i < 3; i++) {
            q += vec2(sin(q.y * 1.7 + time * 0.6 + float(i)), cos(q.x * 1.5 - time * 0.5 + float(i) * 1.3)) * 0.55;
            c += 1.0 / (1.0 + 18.0 * abs(sin(q.x + q.y)));
          }
          return c / 3.0;
        }
        void main(){
          float l = texture2D(tHeight, vUv - vec2(texel.x, 0.0)).r, r = texture2D(tHeight, vUv + vec2(texel.x, 0.0)).r;
          float d = texture2D(tHeight, vUv - vec2(0.0, texel.y)).r, u = texture2D(tHeight, vUv + vec2(0.0, texel.y)).r;
          vec2 g = vec2(r - l, u - d);
          vec3 col = texture2D(tPhoto, vUv + g * 0.06).rgb * tint;
          if (objAmt > 0.0) {
            vec4 o = texture2D(tObjects, vUv + g * 0.035); // the ripples bend them too
            if (o.a > 0.002) {
              vec3 oc = o.rgb / o.a;
              oc *= vec3(0.95, 0.99, 0.98);                                 // under a very thin layer of water
              oc += caustic(vUv * vec2(aspect, 1.0) * 9.0) * 0.04;          // and its moving light
              col = mix(col, oc * 0.9, o.a * objAmt); // bright enough to read every detail
            }
          }
          vec3 n = normalize(vec3(-g * 14.0, 1.0));
          float spec = pow(max(dot(n, normalize(vec3(-0.35, 0.55, 1.0))), 0.0), 90.0);
          col += (spec * 0.35 + (abs(g.x) + abs(g.y)) * 0.25) * max(tint.g, 0.2);
          if (lightAmt > 0.0) {
            vec2 w = (vUv + g * 0.5) * vec2(aspect, 1.0); // ripples bend the light too
            for (int i = 0; i < 3; i++) {
              vec2 d = w - lightPos[i].xy * vec2(aspect, 1.0);
              float r = lightPos[i].z, pool = exp(-dot(d, d) / (r * r));
              float net = caustic(d / r * 3.2 + float(i) * 7.0);
              vec3 add = lightCol[i] * pool * (0.4 + 1.1 * net + (abs(g.x) + abs(g.y)) * 6.0) * lightAmt;
              col = 1.0 - (1.0 - col) * (1.0 - clamp(add, 0.0, 1.0)); // screen blend: light, never paint
            }
          }
          gl_FragColor = vec4(col, 1.0);
          #include <colorspace_fragment>
        }`,
    });
    const bg = new THREE.Mesh(new THREE.PlaneGeometry(1, 1), bgMat); bg.position.z = BG_Z; scene.add(bg);
    let BRIGHT = 0.8; // set in layout(): phones get a darker photo so the glass's own edges and reflections stand out
    // behind the sections the photo sinks into the world's own colour (morning green on Home, noon blue on Work…)
    const deepRGB = (root.dataset.deep ?? "0.16,0.3,0.2").split(",").map(Number);
    const DEEP = new THREE.Color(deepRGB[0], deepRGB[1], deepRGB[2]);
    let bgLevel = 0;
    // Night (step 9.2): the photo dims and cools, the key light turns to moonlight. Eases in; a flip from the menu
    // jumps straight there so the circle reveal shows the finished night.
    const MOON = new THREE.Color(0.3, 0.4, 0.85), SUNLIGHT = new THREE.Color(0xfff0dc), MOONLIGHT = new THREE.Color(0xcfdcff);
    let nightT = html.dataset.night === "on" ? 1 : 0;
    document.addEventListener("bk:night", (e) => { nightT = (e as CustomEvent).detail.on ? 1 : 0; }, on);
    const setBg = (t: number) => { bgLevel = t; };
    let imgAspect = 1.5;
    {
      const img = new Image();
      img.onload = () => {
        // Soft focus that works in every browser (canvas blur filters don't): halve the photo a few times, then double it
        // back up. Each smooth step averages neighbours, which adds up to an even, blocky-free blur.
        const ratio = img.naturalHeight / img.naturalWidth;
        let src: CanvasImageSource = img, w = img.naturalWidth;
        let big = document.createElement("canvas");
        const step = (to: number) => {
          const c = document.createElement("canvas"); c.width = Math.round(to); c.height = Math.round(to * ratio);
          const g = c.getContext("2d")!; g.imageSmoothingEnabled = true; g.imageSmoothingQuality = "high"; g.drawImage(src, 0, 0, c.width, c.height);
          src = c; big = c; w = to;
        };
        // how far down it goes sets the blur: 200 px wide is the usual soft focus; data-soft 1 stops at about 1600
