      const tideY = -0.7 * sinkT - 0.7 * (1 - riseT); // a small dip as you leave and a rise as you arrive: the thread between pages
      name.position.set(bx + (spaceX * hwz - bx) * menuT, by + (my - by) * menuT + tideY, zName);
