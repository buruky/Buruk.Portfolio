---
// Morning world pointer effect: a field of tall grass along the bottom of the Home hero (docs/motion-language.md §6).
// Each blade is a spring: wind gusts roll across the field, and a mouse moving *through* the grass pushes nearby
// blades aside; they swing back and settle. Touch devices get the wind only; reduced motion draws it still.
// Decorative only. Pauses when off screen or the tab is hidden; cleans up when you leave the page.
---
<canvas class="grass" data-grass aria-hidden="true"></canvas>

<script>
  type Blade = {
    x: number; base: number; h: number; w: number; layer: 0 | 1 | 2; color: string;
    a: number; v: number; phase: number; stiff: number; rest: number;
  };

  // back → front: darker and taller behind, lighter and shorter in front
  const PALETTE: Record<0 | 1 | 2, string[]> = {
    0: ["#163b22", "#1c4a2a", "#214f2e"],
    1: ["#2f6b3a", "#3c7a42", "#4a8a47"],
    2: ["#7fb25e", "#9cca73", "#c4e8a0"],
  };
  const REACH = 95; // how far (px) the pointer's push reaches around a blade
  const HILL = "#244a2e"; // the hillside the grass grows from; the rest of Home sits on it (matches --hill in index.astro)

  function start(cv: HTMLCanvasElement) {
    const ctx = cv.getContext("2d");
    if (!ctx) return;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;
    const ac = new AbortController();
    const signal = ac.signal;
    let W = 0, H = 0, blades: Blade[] = [];
    let gust = 0, lastScroll = scrollY;
    let px = -1e4, py = -1e4, pvx = 0, pvy = 0, pointerIn = false, visible = true, raf = 0, last = 0;

    function size() {
      const r = cv.getBoundingClientRect(), dpr = Math.min(2, devicePixelRatio || 1);
      W = r.width; H = r.height;
      cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      blades = [];
      const density = W < 600 ? 0.075 : 0.1; // blades per px of width, per layer
      ([0, 1, 2] as const).forEach((layer) => {
        const n = Math.round(W * density * (layer === 2 ? 0.8 : 1));
        const [hMin, hMax] = layer === 0 ? [0.36, 0.74] : layer === 1 ? [0.24, 0.58] : [0.12, 0.38]; // ~25% shorter than first pass
        for (let i = 0; i < n; i++) {
          // clumps: bias blades toward a few clusters so it reads as a field, not a comb
          const clump = Math.sin(i * 0.37 + layer) * 0.5 + 0.5;
          const pal = PALETTE[layer];
          blades.push({
            x: Math.random() * (W + 20) - 10,
            // uneven ground: blades are rooted at different depths, so there's no single base line
            base: 0, // set below from the hill crest
            h: H * (hMin + (hMax - hMin) * (0.35 * Math.random() + 0.65 * Math.random() * clump)),
            w: layer === 0 ? 5 + Math.random() * 3 : layer === 1 ? 4 + Math.random() * 2.5 : 3 + Math.random() * 2,
            layer, color: pal[Math.floor(Math.random() * pal.length)],
            a: 0, v: 0, phase: Math.random() * Math.PI * 2, stiff: 0.035 + Math.random() * 0.03,
            rest: (Math.random() - 0.5) * 0.38, // every blade leans its own way at rest
          });
        }
      });
      blades.forEach((b) => {
        b.a = b.rest;
        const g = ground(b.x);
        b.base = g + (b.layer === 0 ? -0.02 : b.layer === 1 ? 0.015 : 0.05) * H + Math.random() * 0.03 * H;
      });
      blades.sort((p, q) => p.layer - q.layer);
      draw();
    }

    /** The hill crest: a gentle rolling line about 82% of the way down the canvas. */
    function ground(x: number) {
      return H * 0.82 + Math.sin(x * 0.0042 + 0.6) * H * 0.045 + Math.sin(x * 0.011 + 2.1) * H * 0.015;
    }

    /** Wind: two slow waves rolling left to right, so gusts travel across the field. */
    function wind(x: number, t: number) {
      return Math.sin(t * 0.7 - x * 0.0045) * 0.07 + Math.sin(t * 1.9 - x * 0.013 + 1.3) * 0.025;
    }

    function step(t: number, dt: number) {
      const top = cv.getBoundingClientRect().top;
      const ly = py - top; // pointer y inside the canvas
      for (const b of blades) {
        let target = b.rest + (reduce ? 0 : wind(b.x, t) * (0.6 + b.layer * 0.25) + gust * (0.5 + b.layer * 0.25));
        let force = 0;
        if (pointerIn && fine && !reduce) {
          // only blades the pointer is actually among: near horizontally AND between the blade's tip and base
          const dx = b.x - px;
          const tipY = b.base - b.h * Math.cos(b.a);
          if (Math.abs(dx) < REACH && ly > tipY - 30 && ly < b.base + 10) {
            const near = 1 - Math.abs(dx) / REACH;
            target += Math.sign(dx || 1) * 0.9 * near * near;      // lean away from the pointer
            force += pvx * 0.0025 * near;                           // and get dragged by its movement
          }
        }
        // spring toward the target, with damping: swings past a little and settles
        const acc = (target - b.a) * b.stiff * (1 + b.layer * 0.25) - b.v * 0.11 + force;
        b.v += acc * dt;
        b.a += b.v * dt;
        b.a = Math.max(-1.1, Math.min(1.1, b.a));
      }
    }

    function drawBlade(c: CanvasRenderingContext2D, b: Blade) {
      // the blade bends more toward its tip: angle grows along its length
      const SEG = 5;
      let x = b.x, y = b.base;
      const left: Array<[number, number]> = [], right: Array<[number, number]> = [];
      for (let i = 0; i <= SEG; i++) {
        const f = i / SEG, ang = b.a * Math.pow(f, 1.9) * 1.25, half = (b.w / 2) * (1 - f * 0.97);
        const nx = Math.cos(ang), ny = Math.sin(ang);
        left.push([x - nx * half, y - ny * half]);
        right.push([x + nx * half, y + ny * half]);
        x += Math.sin(ang) * (b.h / SEG);
        y -= Math.cos(ang) * (b.h / SEG);
      }
      c.beginPath();
      c.moveTo(left[0][0], left[0][1]);
      for (let i = 1; i < left.length; i++) c.lineTo(left[i][0], left[i][1]);
      for (let i = right.length - 1; i >= 0; i--) c.lineTo(right[i][0], right[i][1]);
      c.closePath();
      c.fillStyle = b.color;
      c.fill();
    }

    function draw() {
      const c = ctx!;
      c.clearRect(0, 0, W, H);
      let hillDrawn = false;
      const drawHill = () => {
        c.beginPath();
        c.moveTo(0, H);
        for (let x = 0; x <= W; x += 8) c.lineTo(x, ground(x));
        c.lineTo(W, ground(W));
        c.lineTo(W, H);
        c.closePath();
        c.fillStyle = HILL;
        c.fill();
        hillDrawn = true;
      };
      for (const b of blades) {
        if (!hillDrawn && b.layer === 2) drawHill(); // back and middle grass behind the crest, front grass over it
        drawBlade(c, b);
      }
      if (!hillDrawn) drawHill();
    }

    function loop(now: number) {
      const dt = Math.min(3, (now - (last || now)) / 16.67 || 1);
      last = now;
      step(now / 1000, dt);
      pvx *= 0.8; pvy *= 0.8;
      gust *= 0.94; // a scroll gust dies down smoothly
      draw();
      raf = visible && !document.hidden && !reduce ? requestAnimationFrame(loop) : 0;
    }
    const kick = () => { if (!raf && visible && !document.hidden && !reduce) { last = 0; raf = requestAnimationFrame(loop); } };

    if (fine) {
      window.addEventListener("pointermove", (e) => {
        const r = cv.getBoundingClientRect(), x = e.clientX - r.left;
        if (pointerIn) { pvx = x - px; pvy = e.clientY - py; }
        px = x; py = e.clientY; pointerIn = true;
      }, { passive: true, signal });
      document.documentElement.addEventListener("pointerleave", () => { pointerIn = false; }, { signal });
    }
    if ("IntersectionObserver" in window) new IntersectionObserver((es) => { visible = es[0]?.isIntersecting ?? true; kick(); }).observe(cv);
    // Scrolling sends a gentle gust through the field (direction follows the scroll)
    addEventListener("scroll", () => {
      const d = scrollY - lastScroll; lastScroll = scrollY;
      if (!reduce) gust = Math.max(-0.35, Math.min(0.35, gust + d * 0.004));
    }, { passive: true, signal });
    document.addEventListener("visibilitychange", kick, { signal });
    addEventListener("resize", size, { signal });
    document.addEventListener("astro:before-swap", () => { cancelAnimationFrame(raf); raf = 0; visible = false; ac.abort(); }, { once: true });
    size();
    kick();
  }

  document.addEventListener("astro:page-load", () => {
    const cv = document.querySelector<HTMLCanvasElement>("[data-grass]");
    if (cv && !cv.dataset.bound) { cv.dataset.bound = "1"; start(cv); }
  });
</script>

<style>
  .grass {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    width: 100%;
    height: clamp(280px, 52vh, 560px);
    pointer-events: none;
    z-index: 0;
  }
</style>
