---
// The hero's horizon: the Seattle skyline with Rainier (content/media/images/city-bg.jpg) in duotone, using only
// the morning world's two greens at low contrast, so it reads as part of the scene rather than as a photo.
// It sits behind the grass, fades into the sky at the top, and drifts slower than the page (Depth.astro).
import { getImage } from "astro:assets";
import city from "@content/media/images/city-bg.jpg";

const img = await getImage({ src: city, width: 2000, format: "webp", quality: 70 });
---
<!-- the clip stays put and cuts the drifting layer off at the hero's edges, so it never slides into the next section -->
<div class="backdrop-clip" aria-hidden="true">
  <div class="backdrop" data-depth="0.22">
    <div class="photo"><img src={img.src} alt="" width={img.attributes.width} height={img.attributes.height} decoding="async" /></div>
  </div>
</div>

<style>
  .backdrop-clip { position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .backdrop {
    position: absolute; left: 0; right: 0; top: 12%; bottom: 0;
    /* the sky fades into the page at the top; the grass covers the bottom */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 38%, #000 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 38%, #000 100%);
  }
  /* Duotone: greyscale, then lights become pale green (multiply) and darks become deep green (lighten) */
  .photo { position: absolute; inset: 0; isolation: isolate; overflow: hidden; opacity: 0.32; }
  .photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 62%; filter: grayscale(1) contrast(1.15); }
  .photo::before, .photo::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  .photo::before { background: #cfe4bf; mix-blend-mode: multiply; }
  .photo::after { background: #1f4029; mix-blend-mode: lighten; }
</style>
