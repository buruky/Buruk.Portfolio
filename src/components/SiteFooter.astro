---
// The sign-off (step 3.4): a giant "Let's talk.", click-to-copy email, resume, LinkedIn and GitHub.
// A warm evening light rises from the bottom edge, bookending the morning sun at the top of Home.
// No "book a call" on the portfolio (docs/site-map.md).
import site from "@/lib/site";
import resumeUrl from "@content/media/resume.pdf?url";

const { email, linkedin, github } = site.profile;
const { heading, body } = site.copy.contact;
const year = new Date().getFullYear();
---
<footer class="sign-off" aria-labelledby="sign-off-title" data-section="Contact">
  <div class="evening" aria-hidden="true"></div>
  <p class="kicker">Contact</p>
  <h2 id="sign-off-title" class="giant">{heading}.</h2>
  <p class="body">{body}</p>

  <div class="reach">
    <button type="button" class="email" data-copy-email={email} data-gloss="4">
      <span class="addr">{email}</span>
      <span class="hint" data-copy-hint aria-live="polite">Click to copy</span>
    </button>
    <a class="mailto" href={`mailto:${email}`}>or open your mail app <span aria-hidden="true">↗</span></a>
  </div>

  <ul class="links">
    <li><a class="pill" href={resumeUrl} download="Buruk-Yimesgen-Resume.pdf">Resume <span aria-hidden="true">↓</span></a></li>
    <li><a class="pill" href={linkedin} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a></li>
    <li><a class="pill" href={github} target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a></li>
  </ul>

  <!-- Where the glass ብሩኽ comes to rest at the end of Home: GlassHero measures this box and brings the name forward into it -->
  <div class="glass-spot" data-glass-spot aria-hidden="true"></div>

  <div class="base" data-corners-hide>
    <span>© {year} Buruk Yimesgen</span>
    <span class="geez" lang="ti" aria-hidden="true">ብሩኽ</span>
    <span class="base-links">
      <a href="/?intro" class="top" data-replay-intro>Replay intro</a>
      <a href="#main" class="top" data-to-top>Back to top <span aria-hidden="true">↑</span></a>
    </span>
  </div>
</footer>

<script>
  import { bindSignOff } from "@/lib/sign-off";
  document.addEventListener("astro:page-load", bindSignOff);
</script>

<style>
  .sign-off {
    position: relative; isolation: isolate; overflow: hidden;
    padding: clamp(24px, 5vh, 64px) max(20px, env(safe-area-inset-right, 0px)) calc(env(safe-area-inset-bottom, 0px) + 28px) max(20px, env(safe-area-inset-left, 0px));
    display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(20px, 3vh, 32px); align-content: start;
  }
  .sign-off > * { min-width: 0; }
  /* The page's veil thins out here, so the words get their own shade of the world's colour (dark ink on About's
     orange or Resume's green was lost on the bare photo). Desktop: only the left, the glass name rests uncovered on
     the right. Phones: one even shade, light enough for the glass to show through. */
  .sign-off::before {
    content: ""; position: absolute; inset: 0; z-index: -2; pointer-events: none;
    background: color-mix(in srgb, var(--world-bg) 62%, transparent);
    /* fades in over the top, so there's no edge where the page's veil hands over */
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 180px); mask-image: linear-gradient(to bottom, transparent, #000 180px);
  }
  @media (min-width: 900px) {
    .sign-off::before { background: linear-gradient(to top, color-mix(in srgb, var(--world-bg) 80%, transparent) 0, transparent 110px), linear-gradient(to right, color-mix(in srgb, var(--world-bg) 82%, transparent) 0, color-mix(in srgb, var(--world-bg) 70%, transparent) 45%, transparent 72%); }
  }
  /* Room for the glass name, which leaves the background and settles here, uncovered */
  .glass-spot { min-height: clamp(150px, 26vh, 240px); touch-action: pan-y; }
  .glass-spot.can-grab { cursor: grab; }
  .glass-spot.grabbing { cursor: grabbing; }
  @media (min-width: 900px) {
    .sign-off { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); column-gap: clamp(24px, 4vw, 72px); }
    .kicker, .giant, .base { grid-column: 1 / -1; }
    .body, .reach, .links { grid-column: 1; }
    .glass-spot { grid-column: 2; grid-row: 3 / span 3; min-height: 0; }
  }
  /* Evening: a low warm light rising from below the bottom edge */
  .evening {
    position: absolute; z-index: -1; inset: 30% 0 0; pointer-events: none;
    background:
      radial-gradient(70% 70% at 50% 115%, rgb(232 149 90 / 0.45), transparent 70%),
      radial-gradient(50% 45% at 50% 110%, rgb(253 233 138 / 0.25), transparent 70%);
  }
  .kicker { margin: 0; font: 500 12px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.75; }
  .giant {
    margin: 0; font-family: var(--font-display); font-weight: 900; font-stretch: 125%;
    font-size: clamp(60px, 12vw, 220px); line-height: 0.85; letter-spacing: -0.02em;
    text-shadow: 0 0.08em 0.3em rgb(8 30 14 / 0.3);
  }
  .body { margin: 0; max-width: 46ch; font-size: 18px; opacity: 0.9; }

  .reach { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; margin-top: 8px; }
  .email {
    display: inline-flex; flex-direction: column; align-items: flex-start; gap: 4px;
    padding: 18px 26px; border-radius: 22px; cursor: pointer; text-align: left;
    color: var(--world-bg); border: 1px solid var(--world-fg);
    background: linear-gradient(to bottom, #ffffff 0%, var(--world-fg) 55%, color-mix(in srgb, var(--world-fg) 88%, #9cc28a) 100%);
    box-shadow: inset 0 1px 0 #fff, inset 0 -3px 8px rgb(0 40 10 / 0.12), 0 18px 40px -16px rgb(0 0 0 / 0.6);
    -webkit-tap-highlight-color: transparent;
  }
  .email:active { scale: 0.98; }
  .addr { font: 800 clamp(18px, 2.6vw, 34px) var(--font-display); font-stretch: 110%; white-space: nowrap; }
  @media (max-width: 520px) {
    .email { padding: 16px 18px; max-width: 100%; }
    .addr { font-size: 4.8vw; }
  }
  .hint { font: 500 11px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.7; }
  .copied .hint { opacity: 1; color: #1f6b34; }
  .email:focus-visible { outline: 2px solid var(--world-fg); outline-offset: 4px; }
  .mailto { color: inherit; font-size: 15px; opacity: 0.85; text-underline-offset: 5px; }

  .links { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .pill {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; border-radius: 999px;
    color: inherit; text-decoration: none; font: 600 15px var(--font-body);
    border: 1px solid color-mix(in srgb, currentColor 45%, transparent);
    background: color-mix(in srgb, var(--world-fg) 6%, transparent);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.16), 0 8px 20px -12px rgb(0 0 0 / 0.55);
    transition: border-color var(--t-hover) ease, transform var(--t-press) var(--ease-out);
  }
  .pill:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) { .pill:hover { border-color: currentColor; } }

  .base {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px;
    margin-top: clamp(48px, 10vh, 96px); padding-top: 18px;
    border-top: 1px solid color-mix(in srgb, var(--world-fg) 20%, transparent);
    font: 500 12px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.85;
  }
  .geez { font-family: var(--font-geez); font-size: 22px; letter-spacing: 0; text-transform: none; }
  .top { color: inherit; text-decoration: none; }
  .base-links { display: flex; gap: 22px; }
  .top:focus-visible, .mailto:focus-visible, .pill:focus-visible { outline: 2px solid var(--world-fg); outline-offset: 3px; }
</style>
