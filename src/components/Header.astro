---
// The header, "Corners" (chosen 2026-11-26 from https://claude.ai/artifact/RtRRqHxgpi2SRR4jfT74Fy): no bar. Each corner of
// the screen holds one thing: the name (top left), MENU with the page count (top right), sound (bottom left), and where
// you are on the page (bottom right). Persists across pages: the logo, sound toggle and menu button never reload.
// "Where you are" reads [data-section="Label"] elements on the page; pages without them leave that corner empty.
// At the top of a page (the hero) the "Island" from the same drafts takes over the top: a frosted-glass capsule in the
// middle with the main pages, sound and Menu. Scrolling past the hero lifts it away and the corners take over.
// Phones keep the corners throughout (no room for the capsule beside the name).
import { MENU } from "@/lib/worlds";
const count = String(MENU.length).padStart(2, "0");
---
<header class="hdr" transition:persist="site-header">
  <a class="logo" href="/" aria-label="Buruk Yimesgen, home">
    <span class="name" aria-hidden="true"><span data-fly-line>Buruk</span><br /><span data-fly-line>Yimesgen</span></span>
    <span class="sub" aria-hidden="true">Software engineer · Seattle</span>
  </a>
  <button type="button" class="menu-btn" data-menu-button aria-expanded="false" aria-controls="site-menu">
    <span data-menu-label>Menu</span><sup aria-hidden="true">({count})</sup>
  </button>
  <button type="button" class="snd" data-sound-toggle aria-pressed="false">
    <span class="wave" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span data-sound-label>Sound off</span>
  </button>
  <p class="where" data-where aria-hidden="true" hidden><span data-where-n></span><b data-where-name></b></p>
  <nav class="island" aria-label="Main pages">
    {[["/work", "Work"], ["/about", "About"], ["/bk-web-studios", "Studio"], ["/contact", "Contact"]].map(([href, label]) => <a href={href} data-island-link>{label}</a>)}
    <button type="button" class="i-snd" data-sound-alt aria-pressed="false" aria-label="Sound"><span class="wave" aria-hidden="true"><i></i><i></i><i></i><i></i></span></button>
    <button type="button" class="i-menu" data-menu-alt aria-controls="site-menu">Menu</button>
  </nav>
</header>

<script>
  import { isSoundOn, setSound, onSoundChange, play } from "@/lib/sound";

  const hdr = document.querySelector<HTMLElement>(".hdr")!;
  const btn = document.querySelector<HTMLButtonElement>("[data-sound-toggle]")!;
  const label = btn.querySelector<HTMLElement>("[data-sound-label]")!;
  const alt = document.querySelector<HTMLButtonElement>("[data-sound-alt]")!;
  function render(on: boolean) {
    btn.setAttribute("aria-pressed", String(on));
    alt.setAttribute("aria-pressed", String(on));
    alt.setAttribute("aria-label", on ? "Sound on" : "Sound off");
    label.textContent = on ? "Sound on" : "Sound off";
  }
  render(isSoundOn());
  onSoundChange(render);
  const toggleSound = () => {
    const on = !isSoundOn();
    setSound(on);
    if (on) play("toggle");
  };
  btn.addEventListener("click", toggleSound);
  alt.addEventListener("click", toggleSound);
  // the island's Menu opens the same menu (the corner button is the one the menu manages, and it shows CLOSE)
  document.querySelector<HTMLButtonElement>("[data-menu-alt]")!.addEventListener("click", () => document.querySelector<HTMLButtonElement>("[data-menu-button]")?.click());
  // the page you're on is underlined in the island
  const markCurrent = () => {
    const here = location.pathname.replace(/\/+$/, "") || "/";
    document.querySelectorAll<HTMLAnchorElement>("[data-island-link]").forEach((a) => {
      const p = new URL(a.href).pathname;
      if (here === p || here.startsWith(p + "/")) a.setAttribute("aria-current", "page"); else a.removeAttribute("aria-current");
    });
  };
  document.addEventListener("astro:page-load", markCurrent);

  // Bottom right: which section is in the middle of the screen, as "02 / 06" and its name.
  const where = hdr.querySelector<HTMLElement>("[data-where]")!;
  const whereN = where.querySelector<HTMLElement>("[data-where-n]")!;
  const whereName = where.querySelector<HTMLElement>("[data-where-name]")!;
  let stop: (() => void) | null = null;
  function watch() {
    stop?.();
    const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-section]"));
    where.hidden = sections.length === 0;
    if (!sections.length) { stop = null; return; }
    const total = String(sections.length).padStart(2, "0");
    const show = (i: number) => { whereN.textContent = `${String(i + 1).padStart(2, "0")} / ${total}`; whereName.textContent = sections[i].dataset.section ?? ""; };
    // the current section is the last one whose top has passed the middle of the screen (so the gaps between
    // sections still count as the one above, and a jump straight to the bottom lands on the right one)
    let at = -1, raf = 0;
    const update = () => {
      raf = 0;
      const mid = innerHeight / 2;
      let i = 0;
      sections.forEach((s, k) => { if (s.getBoundingClientRect().top <= mid) i = k; });
      if (i !== at) { at = i; show(i); }
    };
    const onScrollWhere = () => { if (!raf) raf = requestAnimationFrame(update); };
    update();
    addEventListener("scroll", onScrollWhere, { passive: true });
    addEventListener("resize", onScrollWhere, { passive: true });
    // the bottom corners step aside at the very end, where the footer has its own bottom row
    const ends = Array.from(document.querySelectorAll<HTMLElement>("[data-corners-hide]"));
    const endIo = new IntersectionObserver((es) => { hdr.classList.toggle("at-end", es.some((e) => e.isIntersecting)); });
    ends.forEach((el) => endIo.observe(el));
    stop = () => { removeEventListener("scroll", onScrollWhere); removeEventListener("resize", onScrollWhere); cancelAnimationFrame(raf); endIo.disconnect(); hdr.classList.remove("at-end"); };
  }
  document.addEventListener("astro:page-load", watch);
  // past the first screen, soft fades at the top and bottom edges keep the corners readable over the page
  const onScroll = () => hdr.classList.toggle("scrolled", scrollY > innerHeight * 0.6);
  addEventListener("scroll", onScroll, { passive: true });
  document.addEventListener("astro:page-load", onScroll);
</script>

<style>
  /* The header is a layer over the whole screen; only its four corners take clicks. */
  .hdr {
    position: fixed; inset: 0; z-index: 100; pointer-events: none;
    --edge-x: clamp(18px, 2vw, 28px); --edge-y: clamp(16px, 2.6vh, 24px);
    color: var(--world-fg);
    text-shadow: 0 1px 14px rgb(0 0 0 / 0.35); /* the corners sit on photos and pages, so they carry a little shade */
  }
  .hdr > * { position: absolute; pointer-events: auto; margin: 0; }
  /* No bar: just a soft fade in the page's own colour behind the top and bottom corners, once you've scrolled */
  .hdr::before, .hdr::after {
    content: ""; position: absolute; left: 0; right: 0; z-index: -1; pointer-events: none;
    opacity: 0; transition: opacity var(--t-ui) var(--ease-out);
  }
  .hdr::before { top: 0; height: calc(env(safe-area-inset-top, 0px) + 150px); background: linear-gradient(to bottom, color-mix(in srgb, var(--world-bg) 94%, transparent) 0, color-mix(in srgb, var(--world-bg) 80%, transparent) 40%, transparent); }
  .hdr::after { bottom: 0; height: calc(env(safe-area-inset-bottom, 0px) + 100px); background: linear-gradient(to top, color-mix(in srgb, var(--world-bg) 78%, transparent), transparent); }
  .hdr.scrolled::before, .hdr.scrolled::after { opacity: 1; }
  .hdr.scrolled.at-end::after { opacity: 0; }
  :global(html.menu-open) .hdr::before, :global(html.menu-open) .hdr::after { opacity: 0; }
  .logo, .menu-btn { top: calc(env(safe-area-inset-top, 0px) + var(--edge-y)); }
  .snd, .where { bottom: calc(env(safe-area-inset-bottom, 0px) + var(--edge-y)); }
  .logo, .snd { left: max(var(--edge-x), env(safe-area-inset-left, 0px)); }
  .menu-btn, .where { right: max(var(--edge-x), env(safe-area-inset-right, 0px)); }

  /* top left: the name */
  .logo { display: flex; flex-direction: column; gap: 8px; color: inherit; text-decoration: none; }
  .name { font: 900 22px/0.95 var(--font-display); font-stretch: 122%; text-transform: uppercase; letter-spacing: -0.02em; }
  .sub { font: 500 10.5px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.75; }

  /* top right: MENU (08) */
  .menu-btn {
    display: flex; gap: 4px; min-height: 44px; padding: 0; background: none; border: 0; cursor: pointer; color: inherit;
    font: 900 22px/1 var(--font-display); font-stretch: 122%; text-transform: uppercase; letter-spacing: -0.02em;
    -webkit-tap-highlight-color: transparent;
  }
  .menu-btn [data-menu-label] { position: relative; }
  .menu-btn [data-menu-label]::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: -4px; height: 2px; background: var(--thread);
    transform: scaleX(0); transform-origin: 0 50%; transition: transform var(--t-ui) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) { .menu-btn:hover [data-menu-label]::after { transform: scaleX(1); } }
  .menu-btn sup { font: 500 10px var(--font-mono); letter-spacing: 0.06em; opacity: 0.7; }

  /* At the top of a page: the island, a frosted-glass capsule in the middle (draft 1). The corner MENU and sound wait
     until you scroll past the hero, unless the menu is open (its CLOSE lives in the corner). */
  .island {
    top: calc(env(safe-area-inset-top, 0px) + var(--edge-y) - 4px); left: 50%; transform: translateX(-50%);
    display: flex; align-items: center; gap: 2px; padding: 6px 6px 6px 10px; border-radius: 999px; text-shadow: none;
    background: color-mix(in srgb, var(--world-bg) 30%, rgb(16 22 17 / 0.3));
    -webkit-backdrop-filter: blur(16px) saturate(1.4); backdrop-filter: blur(16px) saturate(1.4);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.22), inset 0 0 0 1px rgb(255 255 255 / 0.1), 0 14px 30px -16px rgb(0 0 0 / 0.7);
    transition: opacity 360ms var(--ease-out), transform 460ms var(--ease-out);
  }
  .island a { color: inherit; text-decoration: none; font: 500 14px var(--font-body); padding: 9px 13px; border-radius: 999px; opacity: 0.85; transition: background-color var(--t-hover) ease, opacity var(--t-hover) ease; }
  @media (hover: hover) and (pointer: fine) { .island a:hover { opacity: 1; background: rgb(255 255 255 / 0.1); } }
  .island a[aria-current="page"] { opacity: 1; box-shadow: inset 0 -2px 0 var(--thread); border-radius: 0; padding-inline: 2px; margin-inline: 11px; }
  .i-snd { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 50%; background: none; border: 0; color: inherit; cursor: pointer; }
  @media (hover: hover) and (pointer: fine) { .i-snd:hover { background: rgb(255 255 255 / 0.1); } }
  .i-snd[aria-pressed="true"] .wave i { animation: hdr-wave 0.9s ease-in-out infinite; }
  .i-snd[aria-pressed="true"] .wave i:nth-child(2) { animation-delay: -0.3s; }
  .i-snd[aria-pressed="true"] .wave i:nth-child(3) { animation-delay: -0.6s; }
  .i-snd[aria-pressed="true"] .wave i:nth-child(4) { animation-delay: -0.15s; }
  .i-menu { padding: 10px 18px; border-radius: 999px; border: 0; cursor: pointer; background: var(--world-fg); color: var(--world-bg); font: 600 14px var(--font-body); }
  .island :focus-visible { outline-offset: 2px; }
  /* scrolled past the hero (or the menu is open): the island lifts away and the corners take over */
  .hdr.scrolled .island, :global(html.menu-open) .island { opacity: 0; transform: translate(-50%, -14px) scale(0.96); pointer-events: none; visibility: hidden; transition: opacity 260ms var(--ease-out), transform 360ms var(--ease-out), visibility 0s 360ms; }
  .hdr:not(.scrolled) > :is(.menu-btn, .snd) { opacity: 0; pointer-events: none; }
  :global(html.menu-open) .hdr > .menu-btn { opacity: 1; pointer-events: auto; }
  @media (max-width: 900px) {
    .island { display: none; }
    .hdr:not(.scrolled) > :is(.menu-btn, .snd) { opacity: 1; pointer-events: auto; }
  }

  /* bottom left: sound, a waveform that moves while it's on */
  .snd {
    display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 0; background: none; border: 0; cursor: pointer; color: inherit;
    font: 500 10.5px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; -webkit-tap-highlight-color: transparent;
  }
  .wave { display: inline-flex; align-items: flex-end; gap: 2px; height: 12px; }
  .wave i { width: 2px; height: 30%; border-radius: 1px; background: currentColor; transition: height var(--t-ui) var(--ease-out); }
  .snd[aria-pressed="true"] .wave i { animation: hdr-wave 0.9s ease-in-out infinite; }
  .snd[aria-pressed="true"] .wave i:nth-child(2) { animation-delay: -0.3s; }
  .snd[aria-pressed="true"] .wave i:nth-child(3) { animation-delay: -0.6s; }
  .snd[aria-pressed="true"] .wave i:nth-child(4) { animation-delay: -0.15s; }
  @keyframes hdr-wave { 0%, 100% { height: 25%; } 50% { height: 100%; } }

  /* bottom right: where you are */
  .where { text-align: right; font: 500 10.5px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; font-variant-numeric: tabular-nums; }
  .where b { display: block; margin-top: 2px; font: 900 17px var(--font-display); font-stretch: 122%; letter-spacing: -0.02em; }

  .hdr > :is(.snd, .where) { transition: opacity var(--t-ui) var(--ease-out); }
  .hdr.at-end > :is(.snd, .where) { opacity: 0; pointer-events: none; }

  :focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }

  /* With the menu open: MENU (now CLOSE) sits on the light panel, so it flips colour; on phones the panel covers
     everything, so the whole header flips. The bottom-right corner steps away. */
  :global(html.menu-open) .menu-btn { color: var(--world-bg); text-shadow: none; }
  .menu-btn { transition: color var(--t-panel) var(--ease-drawer), opacity 360ms ease; }
  :global(html.menu-open) .hdr > .where { opacity: 0; }
  :global(html.menu-open) .hdr > .snd { filter: blur(6px); opacity: 0.45; }
  .snd { transition: filter var(--t-ui) var(--ease-out), opacity var(--t-ui) var(--ease-out); }
  @media (max-width: 640px) {
    :global(html.menu-open) .hdr { color: var(--world-bg); text-shadow: none; }
    :global(html.menu-open) .hdr > :is(.snd, .sub) { opacity: 0; }
  }
  .hdr { transition: color var(--t-panel) var(--ease-drawer); }

  @media (max-width: 600px) {
    .name { font-size: 17px; }
    .sub { display: none; }
    .menu-btn { font-size: 18px; }
    .where b { font-size: 13px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .snd[aria-pressed="true"] .wave i { animation: none; height: 70%; }
  }
</style>
