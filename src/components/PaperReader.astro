---
// The paper reader (step 6.4): real pages of a paper as sheets in a row you can flip through (swipe, scroll, the
// arrows, or ← → keys). Each sheet opens the PDF at that page. Pages are rendered from the PDF once (pdf.js) and
// kept in content/media/images/papers/. Data: content/site.json → copy.research.papers[].pages.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props { pdf: string; total: number; title: string; pages: { n: number; img: string; cap: string }[] }
const { pdf, total, title, pages } = Astro.props;
const shots = import.meta.glob<{ default: ImageMetadata }>("../../content/media/images/papers/*.jpg", { eager: true });
const img = (p: string) => shots[`../../content/media/${p}`].default;
---
<div class="reader" data-reader>
  <ol class="strip" aria-label={`Pages from ${title}`} tabindex="0">
    {pages.map((p, i) => (
      <li class="sheet">
        <a href={`${pdf}#page=${p.n}`} target="_blank" rel="noopener" aria-label={`Page ${p.n}: ${p.cap}. Opens the PDF at this page.`}>
          <Image src={img(p.img)} alt="" widths={[320, 560]} sizes="(max-width: 700px) 64vw, 300px" loading={i < 3 ? "eager" : "lazy"} />
        </a>
        <p class="cap"><span class="pg">p. {p.n}</span>{p.cap}</p>
      </li>
    ))}
  </ol>
  <div class="bar">
    <p class="count" aria-hidden="true"><span data-at>1</span> / {pages.length} <span class="of">· {total} pages in the paper</span></p>
    <div class="arrows">
      <button type="button" data-prev aria-label="Previous pages">←</button>
      <button type="button" data-next aria-label="Next pages">→</button>
    </div>
  </div>
</div>

<script>
  function bind(root: HTMLElement) {
    if (root.dataset.bound) return;
    root.dataset.bound = "1";
    const strip = root.querySelector<HTMLElement>(".strip")!;
    const sheets = Array.from(strip.querySelectorAll<HTMLElement>(".sheet"));
    const at = root.querySelector<HTMLElement>("[data-at]")!;
    const prev = root.querySelector<HTMLButtonElement>("[data-prev]")!, next = root.querySelector<HTMLButtonElement>("[data-next]")!;
    const smooth = () => (matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth") as ScrollBehavior;
    const current = () => {
      const x = strip.scrollLeft + 8;
      let i = 0; sheets.forEach((s, k) => { if (s.offsetLeft - strip.offsetLeft <= x) i = k; });
      return i;
    };
    const go = (i: number) => {
      const s = sheets[Math.max(0, Math.min(sheets.length - 1, i))];
      strip.scrollTo({ left: s.offsetLeft - strip.offsetLeft, behavior: smooth() });
    };
    const update = () => {
      const i = current(); at.textContent = String(i + 1);
      prev.disabled = strip.scrollLeft < 4; next.disabled = strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 4;
    };
    prev.addEventListener("click", () => go(current() - 1));
    next.addEventListener("click", () => go(current() + 1));
    strip.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { e.preventDefault(); go(current() + 1); }
      if (e.key === "ArrowLeft") { e.preventDefault(); go(current() - 1); }
    });
    strip.addEventListener("scroll", () => requestAnimationFrame(update), { passive: true });
    addEventListener("resize", update, { passive: true });
    update();
  }
  document.addEventListener("astro:page-load", () => document.querySelectorAll<HTMLElement>("[data-reader]").forEach(bind));
</script>

<style>
  .reader { display: grid; gap: 14px; min-width: 0; }
  .strip {
    list-style: none; margin: 0; padding: 6px 2px 18px; display: flex; gap: clamp(14px, 2vw, 24px);
    overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: none;
  }
  .strip::-webkit-scrollbar { display: none; }
  .strip:focus-visible { outline: 2px solid var(--world-accent); outline-offset: 4px; border-radius: 6px; }
  .sheet { flex: none; width: clamp(200px, 64vw, 300px); scroll-snap-align: start; display: grid; gap: 10px; }
  .sheet a { display: block; border-radius: 3px; overflow: hidden; background: #fff; box-shadow: 0 1px 0 rgb(255 255 255 / 0.5) inset, 0 24px 40px -22px rgb(0 0 0 / 0.8), 0 0 0 1px rgb(0 0 0 / 0.2);
    transition: translate 260ms var(--ease-out), box-shadow 260ms var(--ease-out); }
  .sheet :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 8.5 / 11; object-fit: cover; object-position: top; }
  @media (hover: hover) and (pointer: fine) { .sheet a:hover { translate: 0 -6px; box-shadow: 0 34px 50px -24px rgb(0 0 0 / 0.85), 0 0 0 1px rgb(0 0 0 / 0.2); } }
  .sheet a:focus-visible { outline: 2px solid var(--world-accent); outline-offset: 3px; }
  .cap { margin: 0; display: flex; gap: 10px; align-items: baseline; font-size: 14px; line-height: 1.4; opacity: 0.88; }
  .pg { flex: none; font: 500 11px var(--font-mono); letter-spacing: 0.06em; color: var(--world-accent); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .count { margin: 0; font: 500 12px var(--font-mono); letter-spacing: 0.06em; font-variant-numeric: tabular-nums; }
  .count .of { opacity: 0.65; }
  .arrows { display: flex; gap: 8px; }
  .arrows button {
    width: 44px; height: 44px; border-radius: 50%; border: 0; cursor: pointer; color: inherit; font: 600 18px var(--font-body);
    background: rgb(255 255 255 / 0.1); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.25); transition: background-color var(--t-hover) ease, opacity var(--t-hover) ease;
  }
  .arrows button:disabled { opacity: 0.3; cursor: default; }
  @media (hover: hover) and (pointer: fine) { .arrows button:not(:disabled):hover { background: rgb(255 255 255 / 0.2); } }
  .arrows button:focus-visible { outline: 2px solid var(--world-accent); outline-offset: 2px; }
</style>
